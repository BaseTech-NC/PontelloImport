@{
    Layout = "~/Views/Admin/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Reports";

    var year = (int)(ViewData["Year"] ?? DateTime.Now.Year);
    var years = ViewData["Years"] as List<int> ?? new List<int> { year };
    var maxRevenue = (decimal)(ViewData["MaxRevenue"] ?? 1m);
    var totalRevenue = (decimal)(ViewData["TotalRevenue"] ?? 0m);
    var totalOrders = (int)(ViewData["TotalOrders"] ?? 0);
    var avgOrder = (decimal)(ViewData["AvgOrder"] ?? 0m);

    // Dynamic typed access for anonymous type lists
    var monthDataRaw = ViewData["SalesByMonth"];
    var topDealersRaw = ViewData["TopDealers"];
    var statusBreakdownRaw = ViewData["StatusBreakdown"];
}

@functions {
    string GetStatusBadgeClass(string status) => status switch
    {
        "Submitted"     => "pi-badge pi-badge-submitted",
        "Confirmed"     => "pi-badge pi-badge-confirmed",
        "Shipped"       => "pi-badge pi-badge-shipped",
        "Invoiced"      => "pi-badge pi-badge-invoiced",
        "Cancelled"     => "pi-badge pi-badge-cancelled",
        "ActionRequired"=> "pi-badge pi-badge-action",
        "FlaggedIssue"  => "pi-badge pi-badge-action",
        _               => "pi-badge"
    };
}

<div class="container-fluid mt-4" id="reports-content">

    <!-- Header row -->
    <div class="d-flex align-items-center justify-content-between mb-4 flex-wrap gap-3">
        <h1 class="mb-0 h4">Reports</h1>
        <div class="d-flex align-items-center gap-3">
            <form method="get" class="d-flex align-items-center gap-2">
                <label class="form-label mb-0" style="font-size:13px;white-space:nowrap;">Year:</label>
                <select name="year" class="form-select form-select-sm"
                        onchange="this.form.submit()" style="width:auto;">
                    @foreach (var y in years)
                    {
                        <option value="@y" selected="@(y == year ? "selected" : null)">@y</option>
                    }
                </select>
            </form>
            <button onclick="window.print()" class="pi-btn pi-btn-ghost pi-btn-sm no-print">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none"
                     stroke="currentColor" stroke-width="2">
                    <polyline points="6 9 6 2 18 2 18 9"/>
                    <path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"/>
                    <rect x="6" y="14" width="12" height="8"/>
                </svg>
                Print
            </button>
        </div>
    </div>

    <!-- Row 1: Stat cards -->
    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <div class="pi-card">
                <div class="pi-section-label">Total Revenue (@year)</div>
                <div style="font-size:1.75rem;font-weight:700;color:var(--pi-primary);">
                    $@totalRevenue.ToString("N2")
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="pi-card">
                <div class="pi-section-label">Total Orders (@year)</div>
                <div style="font-size:1.75rem;font-weight:700;color:var(--pi-text-1);">
                    @totalOrders
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="pi-card">
                <div class="pi-section-label">Avg Order Value</div>
                <div style="font-size:1.75rem;font-weight:700;color:var(--pi-text-1);">
                    $@avgOrder.ToString("N2")
                </div>
            </div>
        </div>
    </div>

    <!-- Row 2: Monthly bar chart -->
    <div class="pi-card mb-4">
        <div class="pi-section-label">Monthly Sales — @year</div>
        @if (monthDataRaw != null)
        {
            var months = (dynamic)monthDataRaw;
            <div style="display:flex;align-items:flex-end;gap:4px;height:160px;padding:0 8px;">
                @foreach (var m in months)
                {
                    decimal rev = m.Revenue;
                    int cnt = m.OrderCount;
                    double pct = maxRevenue > 0 ? (double)rev / (double)maxRevenue * 100.0 : 0;
                    string pctStr = pct.ToString("F0");
                    string minH = rev > 0 ? "4px" : "0";
                    <div style="flex:1;display:flex;flex-direction:column;align-items:center;justify-content:flex-end;gap:4px;">
                        @if (rev > 0)
                        {
                            <div style="font-size:10px;color:var(--pi-text-2);">
                                $@((rev / 1000m).ToString("F1"))k
                            </div>
                        }
                        <div style="width:100%;background:var(--pi-primary);border-radius:4px 4px 0 0;
                                    height:@(pctStr)%;min-height:@minH;
                                    transition:height 0.3s ease;opacity:0.85;">
                        </div>
                        <div style="font-size:10px;color:var(--pi-text-2);white-space:nowrap;">
                            @m.MonthName
                        </div>
                        @if (cnt > 0)
                        {
                            <div style="font-size:9px;color:var(--pi-text-3);">@cnt orders</div>
                        }
                    </div>
                }
            </div>
        }
    </div>

    <!-- Row 3: Two columns -->
    <div class="row g-4">

        <!-- Top Dealers -->
        <div class="col-lg-7">
            <div class="pi-card">
                <div class="pi-section-label">Top Dealers by Revenue (All Time)</div>
                @if (topDealersRaw != null)
                {
                    var dealers = (dynamic)topDealersRaw;
                    decimal topRevenue = 1m;
                    foreach (var d in dealers) { topRevenue = d.Revenue; break; }
                    if (topRevenue <= 0) topRevenue = 1m;

                    <table class="pi-table w-100">
                        <thead>
                            <tr>
                                <th style="width:30px;">#</th>
                                <th>Dealer</th>
                                <th class="text-center">Orders</th>
                                <th>Revenue</th>
                            </tr>
                        </thead>
                        <tbody>
                            @{int rank = 1;}
                            @foreach (var d in dealers)
                            {
                                decimal rev = d.Revenue;
                                double barPct = (double)rev / (double)topRevenue * 100.0;
                                <tr>
                                    <td style="color:var(--pi-text-3);font-size:12px;">@rank</td>
                                    <td style="font-weight:500;">@d.CompanyName</td>
                                    <td class="text-center" style="color:var(--pi-text-2);">@d.OrderCount</td>
                                    <td>
                                        <div style="display:flex;align-items:center;gap:8px;">
                                            <span>$@rev.ToString("N0")</span>
                                            <div style="flex:1;height:4px;background:var(--pi-border);border-radius:2px;max-width:80px;">
                                                <div style="height:100%;background:var(--pi-primary);border-radius:2px;width:@(barPct.ToString("F0"))%;"></div>
                                            </div>
                                        </div>
                                    </td>
                                </tr>
                                rank++;
                            }
                        </tbody>
                    </table>
                }
                else
                {
                    <p class="text-muted" style="font-size:13px;">No order data available.</p>
                }
            </div>
        </div>

        <!-- Status Breakdown -->
        <div class="col-lg-5">
            <div class="pi-card">
                <div class="pi-section-label">Order Status Breakdown</div>
                @if (statusBreakdownRaw != null)
                {
                    var statuses = (dynamic)statusBreakdownRaw;
                    int totalCount = 0;
                    decimal totalRev = 0m;
                    foreach (var s in statuses) { totalCount += s.Count; totalRev += s.Revenue; }

                    <table class="pi-table w-100">
                        <thead>
                            <tr>
                                <th>Status</th>
                                <th class="text-center">Count</th>
                                <th class="text-end">Revenue</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var s in statuses)
                            {
                                <tr>
                                    <td><span class="@GetStatusBadgeClass(s.Status)">@s.Status</span></td>
                                    <td class="text-center">@s.Count</td>
                                    <td class="text-end">$@(((decimal)s.Revenue).ToString("N0"))</td>
                                </tr>
                            }
                        </tbody>
                        <tfoot>
                            <tr style="border-top:2px solid var(--pi-border);">
                                <td><strong>Total</strong></td>
                                <td class="text-center"><strong>@totalCount</strong></td>
                                <td class="text-end"><strong>$@(totalRev.ToString("N0"))</strong></td>
                            </tr>
                        </tfoot>
                    </table>
                }
                else
                {
                    <p class="text-muted" style="font-size:13px;">No data available.</p>
                }
            </div>
        </div>

    </div>
</div>

@section Scripts {
    <style>
    @@media print {
        .no-print, .sidebar-wrapper, nav, .admin-topnav { display: none !important; }
        .admin-content-area { margin: 0 !important; padding: 0 !important; }
        #reports-content { padding: 20px; }
        .pi-card { border: 1px solid #ddd !important; box-shadow: none !important; }
    }
    </style>
}
