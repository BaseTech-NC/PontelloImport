@{
    Layout = "~/Views/Admin/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Reports";
    var year = (int)(ViewData["Year"] ?? DateTime.Now.Year);
    var years = ViewData["Years"] as List<int> ?? new List<int>();
    var dealers = ViewData["Dealers"] as dynamic ?? new List<dynamic>();
    var selectedDealer = (int?)ViewData["DealerID"];

    var totalOrders  = (int)(ViewData["TotalOrders"] ?? 0);
    var orderValue   = (decimal)(ViewData["OrderValue"] ?? 0m);
    var avgOrder     = (decimal)(ViewData["AvgOrderValue"] ?? 0m);
    var maxRevenue   = (decimal)(ViewData["MaxRevenue"] ?? 1m);
    var maxDealerRev = (decimal)(ViewData["MaxDealerRevenue"] ?? 1m);

    var monthlyData  = ViewData["MonthlyData"] as dynamic ?? new List<dynamic>();
    var topDealers   = ViewData["TopDealers"] as dynamic ?? new List<dynamic>();
    var statusData   = ViewData["StatusBreakdown"] as dynamic ?? new List<dynamic>();
}

<!-- Print-only header — hidden on screen via @@media screen rule below -->
<div class="print-header">
    <img src="/images/pontello-Imports-Logo.png"
         alt="Pontello Imports"
         style="height:36px;width:auto;">
    <div class="print-header-text">
        <h2>Pontello Imports — Reports</h2>
        <p>
            All data scoped to @year
            · Generated @DateTime.Now.ToString("MMMM d, yyyy")
        </p>
    </div>
</div>

<!-- ── HEADER (screen only) ─────────────── -->
<div class="screen-heading"
     style="display:flex;justify-content:space-between;align-items:center;
            margin-bottom:24px;flex-wrap:wrap;gap:12px;">

    <div>
        <h1 style="font-family:var(--pi-font-head);font-size:26px;font-weight:700;margin:0;">
            Reports
        </h1>
        <p style="color:var(--pi-text-2);font-size:13px;margin:4px 0 0;">
            All data scoped to @year
            @if (selectedDealer != null)
            {
                <span>— filtered by dealer</span>
            }
        </p>
    </div>

    <!-- Filter bar -->
    <form method="get"
          style="display:flex;gap:8px;align-items:center;flex-wrap:wrap;">
        <label for="yearSelect" class="visually-hidden">Select year</label>
        <select id="yearSelect" name="year"
                class="form-select form-select-sm"
                onchange="this.form.submit()"
                style="font-family:var(--pi-font-body);font-size:13px;width:auto;">
            @foreach (var y in years)
            {
                <option value="@y" selected="@(y == year ? "selected" : null)">@y</option>
            }
        </select>

        <label for="dealerSelect" class="visually-hidden">Filter by dealer</label>
        <select id="dealerSelect" name="dealerId"
                class="form-select form-select-sm"
                onchange="this.form.submit()"
                style="font-family:var(--pi-font-body);font-size:13px;width:auto;min-width:160px;">
            <option value="">All dealers</option>
            @foreach (var d in dealers)
            {
                <option value="@d.DealerID" selected="@(selectedDealer == (int)d.DealerID ? "selected" : null)">
                    @d.CompanyName
                </option>
            }
        </select>

        <a href="/Reports"
           class="pi-btn pi-btn-ghost pi-btn-sm">
            Reset
        </a>

        <button type="button"
                class="pi-btn pi-btn-blue pi-btn-sm"
                onclick="window.print()">
            Print
        </button>

        <a asp-action="ExportCsv"
           asp-route-year="@year"
           asp-route-dealerId="@selectedDealer"
           class="pi-btn pi-btn-ghost pi-btn-sm">
            Export CSV
        </a>
    </form>
</div>

@if (totalOrders == 0)
{
    <!-- Empty state -->
    <div style="text-align:center;padding:64px 20px;background:var(--pi-bg-card);
                border:1px solid var(--pi-border);border-radius:var(--pi-radius);">
        <div style="font-family:var(--pi-font-head);font-size:20px;font-weight:700;
                    color:var(--pi-text-1);margin-bottom:8px;">
            No orders found for @year
        </div>
        <div style="color:var(--pi-text-2);font-size:13px;">
            Try selecting a different year or dealer
        </div>
    </div>
}
else
{
    <!-- ── ROW 1: Stat cards ─────────────────── -->
    <div class="print-stats-row"
         style="display:grid;grid-template-columns:repeat(3,1fr);gap:16px;margin-bottom:24px;">

        <div class="pi-stat">
            <div class="pi-stat-label">Total Orders</div>
            <div class="pi-stat-value">@totalOrders</div>
            <div class="pi-stat-sub">Non-cancelled orders in @year</div>
        </div>

        <div class="pi-stat pi-stat-emerald">
            <div class="pi-stat-label">Order Value</div>
            <div class="pi-stat-value">$@orderValue.ToString("N0")</div>
            <div class="pi-stat-sub">Subtotal revenue — @year</div>
        </div>

        <div class="pi-stat">
            <div class="pi-stat-label">Avg Order Value</div>
            <div class="pi-stat-value">$@avgOrder.ToString("N0")</div>
            <div class="pi-stat-sub">Per non-cancelled order</div>
        </div>
    </div>

    <!-- ── ROW 2: Monthly chart ──────────────── -->
    <div class="pi-card" style="margin-bottom:24px;">
        <div class="pi-card-header">Monthly Order Value — @year</div>

        @{
            bool hasMonthlyData = false;
            foreach (var m in monthlyData) { if ((int)m.OrderCount > 0) { hasMonthlyData = true; break; } }
        }

        @if (!hasMonthlyData)
        {
            <div style="text-align:center;padding:40px;color:var(--pi-text-2);font-size:13px;">
                No order data for @year
            </div>
        }
        else
        {
            <div class="chart-container"
                 style="display:flex;align-items:flex-end;gap:4px;height:160px;padding:0 2px;">
                @foreach (var m in monthlyData)
                {
                    double pct = maxRevenue > 0 ? (double)m.Revenue / (double)maxRevenue : 0;
                    int barPx = (int)(pct * 120);
                    if ((int)m.OrderCount > 0 && barPx < 4) barPx = 4;
                    <div class="chart-bar-wrap"
                         style="flex:1;display:flex;flex-direction:column;align-items:center;
                                justify-content:flex-end;gap:2px;height:160px;">
                        @if ((int)m.OrderCount > 0)
                        {
                            <div style="font-size:9px;color:var(--pi-text-2);text-align:center;line-height:1.2;">
                                $@(((decimal)m.Revenue / 1000m).ToString("F1"))k
                            </div>
                        }
                        <div class="chart-bar"
                             style="width:100%;
                                    height:@(barPx)px;
                                    background:@((int)m.OrderCount > 0 ? "var(--pi-nitro-blue)" : "var(--pi-border)");
                                    border-radius:3px 3px 0 0;
                                    opacity:@((int)m.OrderCount > 0 ? "0.85" : "0.4");">
                        </div>
                        <div style="font-size:9px;color:var(--pi-text-2);text-align:center;white-space:nowrap;">
                            @m.MonthName
                        </div>
                        @if ((int)m.OrderCount > 0)
                        {
                            <div style="font-size:9px;color:var(--pi-text-2);text-align:center;">
                                @m.OrderCount
                            </div>
                        }
                    </div>
                }
            </div>
            <div style="font-size:10px;color:var(--pi-text-3);text-align:center;margin-top:8px;">
                Bar height = order value · Number below = order count · Grey = no orders that month
            </div>
        }
    </div>

    <!-- ── ROW 3: Two panels ─────────────────── -->
    <div class="print-panels-row"
         style="display:grid;grid-template-columns:1fr 1fr;gap:16px;">

        <!-- Top Dealers — same year scope -->
        <div class="print-panel pi-card">
            <div class="pi-card-header">Top Dealers — @year</div>

            @{
                bool hasTopDealers = false;
                foreach (var _ in topDealers) { hasTopDealers = true; break; }
            }

            @if (!hasTopDealers)
            {
                <div style="color:var(--pi-text-2);font-size:13px;padding:16px 0;">
                    No dealer data for @year
                </div>
            }
            else
            {
                <table class="pi-table">
                    <thead>
                        <tr>
                            <th style="width:28px;">#</th>
                            <th>Dealer</th>
                            <th style="width:60px;text-align:center;">Orders</th>
                            <th style="width:120px;text-align:right;">Order Value</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{int rank = 1;}
                        @foreach (var d in topDealers)
                        {
                            double dealerPct = maxDealerRev > 0
                                ? (double)d.Revenue / (double)maxDealerRev * 100
                                : 0;
                            <tr>
                                <td style="color:var(--pi-text-2);font-size:12px;">@rank</td>
                                <td>
                                    <div style="font-size:13px;font-weight:500;">@d.CompanyName</div>
                                    <div class="dealer-bar-bg"
                                         style="height:3px;background:var(--pi-border);border-radius:2px;
                                                margin-top:4px;max-width:120px;">
                                        <div class="dealer-bar-fill"
                                             style="height:100%;background:var(--pi-nitro-blue);
                                                    border-radius:2px;width:@($"{dealerPct:F0}")%;">
                                        </div>
                                    </div>
                                </td>
                                <td style="text-align:center;color:var(--pi-text-2);font-size:13px;">
                                    @d.OrderCount
                                </td>
                                <td style="text-align:right;font-weight:600;font-size:13px;">
                                    $@(((decimal)d.Revenue).ToString("N0"))
                                </td>
                            </tr>
                            rank++;
                        }
                    </tbody>
                </table>
            }
        </div>

        <!-- Order Status Breakdown — same year -->
        <div class="print-panel pi-card">
            <div class="pi-card-header">Order Status — @year</div>

            @{
                bool hasStatusData = false;
                int totalForPct = 0;
                foreach (var s in statusData) { hasStatusData = true; totalForPct += (int)s.Count; }
            }

            @if (!hasStatusData)
            {
                <div style="color:var(--pi-text-2);font-size:13px;padding:16px 0;">
                    No data for @year
                </div>
            }
            else
            {
                <table class="pi-table">
                    <thead>
                        <tr>
                            <th style="width:140px;">Status</th>
                            <th style="width:60px;text-align:center;">Count</th>
                            <th style="text-align:right;width:100px;">Order Value</th>
                            <th style="width:80px;text-align:right;">Share</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var s in statusData)
                        {
                            var badgeClass = (string)s.Status switch {
                                "Submitted"      => "pi-badge-submitted",
                                "ActionRequired" => "pi-badge-action",
                                "Confirmed"      => "pi-badge-confirmed",
                                "Cancelled"      => "pi-badge-cancelled",
                                _ => "pi-badge-submitted"
                            };
                            var statusLabel = (string)s.Status == "ActionRequired"
                                ? "Action Required"
                                : (string)s.Status;
                            double share = totalForPct > 0
                                ? (double)(int)s.Count / totalForPct * 100 : 0;
                            <tr>
                                <td>
                                    <span class="pi-badge @badgeClass">@statusLabel</span>
                                </td>
                                <td style="text-align:center;font-size:13px;">@s.Count</td>
                                <td style="text-align:right;font-size:13px;font-weight:500;">
                                    $@(((decimal)s.Revenue).ToString("N0"))
                                </td>
                                <td style="text-align:right;font-size:12px;color:var(--pi-text-2);">
                                    @share.ToString("F0")%
                                </td>
                            </tr>
                        }
                        <!-- Total row -->
                        @{
                            decimal totalRevForStatus = 0m;
                            foreach (var s in statusData) { totalRevForStatus += (decimal)s.Revenue; }
                        }
                        <tr style="border-top:2px solid var(--pi-border);font-weight:700;">
                            <td>Total</td>
                            <td style="text-align:center;">@totalForPct</td>
                            <td style="text-align:right;">$@totalRevForStatus.ToString("N0")</td>
                            <td style="text-align:right;color:var(--pi-text-2);font-size:12px;">100%</td>
                        </tr>
                    </tbody>
                </table>
            }
        </div>
    </div>
}

<style>
@@media screen {
    .print-header { display: none; }
}

@@media print {
    /* ── Hide UI chrome ────────────────────── */
    nav, .navbar, header,
    form, button, a.pi-btn,
    .nav-icon-btn, .sidebar,
    .dropdown, .dropdown-menu,
    [class*="dropdown"],
    .print-hide,
    .alert {
        display: none !important;
    }

    /* ── Page setup ────────────────────────── */
    @@page {
        size: A4 portrait;
        margin: 12mm 14mm;
    }

    html, body {
        width: 100%;
        margin: 0;
        padding: 0;
        background: white !important;
        font-family: 'DM Sans', sans-serif;
        font-size: 11px;
        color: #111827;
        -webkit-print-color-adjust: exact;
        print-color-adjust: exact;
    }

    /* ── Print header ──────────────────────── */
    .print-header {
        display: flex !important;
        align-items: center;
        gap: 12px;
        padding-bottom: 10px;
        margin-bottom: 16px;
        border-bottom: 2px solid #332F29;
    }
    .print-header img {
        height: 32px !important;
        width: auto !important;
    }
    .print-header-text h2 {
        font-size: 15px;
        font-weight: 700;
        margin: 0;
        color: #332F29;
    }
    .print-header-text p {
        font-size: 10px;
        color: #6B7280;
        margin: 2px 0 0;
    }

    /* ── Hide screen heading ───────────────── */
    .screen-heading {
        display: none !important;
    }

    /* ── Main content ──────────────────────── */
    .container,
    .container-fluid,
    main,
    [role="main"],
    .main-content {
        padding: 0 !important;
        margin: 0 !important;
        max-width: 100% !important;
        width: 100% !important;
    }

    /* ── Stat cards row ────────────────────── */
    .print-stats-row {
        display: flex !important;
        gap: 10px !important;
        margin-bottom: 16px !important;
    }
    .pi-stat {
        flex: 1 !important;
        border: 1px solid #E5E7EB !important;
        border-radius: 6px !important;
        padding: 10px !important;
        break-inside: avoid !important;
    }
    .pi-stat-label {
        font-size: 9px !important;
        color: #6B7280 !important;
    }
    .pi-stat-value {
        font-size: 20px !important;
        font-weight: 700 !important;
        color: #111827 !important;
    }
    .pi-stat-sub {
        font-size: 9px !important;
        color: #6B7280 !important;
    }

    /* ── Chart card ────────────────────────── */
    .pi-card {
        border: 1px solid #E5E7EB !important;
        border-radius: 6px !important;
        box-shadow: none !important;
        padding: 12px !important;
        margin-bottom: 14px !important;
        break-inside: avoid !important;
    }
    .pi-card-header {
        font-size: 9px !important;
        font-weight: 700 !important;
        letter-spacing: 0.5px !important;
        color: #6B7280 !important;
        margin-bottom: 10px !important;
        padding-bottom: 6px !important;
        border-bottom: 1px solid #E5E7EB !important;
    }

    /* ── Bar chart: pixel heights ──────────── */
    .chart-container {
        display: flex !important;
        align-items: flex-end !important;
        gap: 4px !important;
        height: 120px !important;
        padding: 0 2px !important;
    }
    .chart-bar-wrap {
        flex: 1 !important;
        display: flex !important;
        flex-direction: column !important;
        align-items: center !important;
        justify-content: flex-end !important;
        gap: 2px !important;
        height: 120px !important;
    }
    .chart-bar {
        width: 100% !important;
        border-radius: 3px 3px 0 0 !important;
    }

    /* ── Bottom two panels ─────────────────── */
    .print-panels-row {
        display: flex !important;
        gap: 12px !important;
        break-before: avoid !important;
    }
    .print-panel {
        flex: 1 !important;
        break-inside: avoid !important;
    }

    /* ── Tables ────────────────────────────── */
    .pi-table {
        width: 100% !important;
        border-collapse: collapse !important;
        font-size: 10px !important;
    }
    .pi-table thead th {
        background: #F3F4F6 !important;
        color: #374151 !important;
        padding: 6px 8px !important;
        font-size: 9px !important;
        border-bottom: 1px solid #E5E7EB !important;
    }
    .pi-table tbody td {
        padding: 6px 8px !important;
        border-bottom: 1px solid #F3F4F6 !important;
        font-size: 10px !important;
    }
    .pi-table tbody tr:last-child td {
        border-bottom: none !important;
    }

    /* ── Badges in print ───────────────────── */
    .pi-badge {
        border: 1px solid #E5E7EB !important;
        border-radius: 10px !important;
        padding: 1px 6px !important;
        font-size: 9px !important;
        font-weight: 600 !important;
    }

    /* ── Inline bar (dealer table) ─────────── */
    .dealer-bar-bg {
        height: 3px !important;
        background: #E5E7EB !important;
        border-radius: 2px !important;
        margin-top: 2px !important;
    }
    .dealer-bar-fill {
        height: 100% !important;
        background: #59B7FF !important;
        border-radius: 2px !important;
    }
}
</style>
