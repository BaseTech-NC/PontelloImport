@model PontelloImport.Models.DealerApplication
@using PontelloImport.Models
@{
    Layout = "~/Views/Admin/Shared/_AdminLayout.cshtml";
    ViewBag.Title = "Review Application";
    var paymentTerms = ViewBag.PaymentTerms as List<PaymentTerms> ?? new List<PaymentTerms>();

    var displayName = !string.IsNullOrWhiteSpace(Model.Company)
        ? Model.Company
        : (!string.IsNullOrWhiteSpace(Model.SubmittedCompanyName) ? Model.SubmittedCompanyName : $"{Model.FirstName} {Model.LastName}");

    var displayEmail = Model.Email ?? Model.SubmittedEmail ?? "—";
    var displayPhone = Model.Phone ?? Model.SubmittedContactPhone ?? "—";
    var displayCity = Model.City ?? Model.SubmittedAddress?.City ?? "—";
    var displayStreet = Model.Address ?? Model.SubmittedAddress?.Street;
    var displayProvince = Model.ProvinceState ?? Model.SubmittedAddress?.Province;
    var displayPostal = Model.PostalZipCode ?? Model.SubmittedAddress?.PostalCode;
}

<div class="container-fluid mt-4" style="max-width:780px;">
    <div class="row mb-4 align-items-center">
        <div class="col-auto">
            <a asp-action="Index" class="pi-btn pi-btn-ghost pi-btn-sm">
                &#8592; Back to Applications
            </a>
        </div>
        <div class="col">
            <h1 class="h4 mb-0">Review Application — @displayName</h1>
        </div>
        <div class="col-auto">
            <span class="pi-badge @(Model.Status == "Pending" ? "pi-badge-pending" : Model.Status == "Approved" ? "pi-badge-confirmed" : "pi-badge-cancelled")">
                @Model.Status
            </span>
        </div>
    </div>

    <!-- Application details -->
    <div class="pi-card mb-4">
        <div class="pi-section-label">Application Details</div>
            <dl class="row mb-0">
                <dt class="col-sm-4 text-muted">First Name</dt>
                <dd class="col-sm-8 fw-semibold">@Model.FirstName</dd>

                <dt class="col-sm-4 text-muted">Last Name</dt>
                <dd class="col-sm-8 fw-semibold">@Model.LastName</dd>

                <dt class="col-sm-4 text-muted">Email</dt>
                <dd class="col-sm-8"><a href="mailto:@displayEmail">@displayEmail</a></dd>

                <dt class="col-sm-4 text-muted">Phone</dt>
                <dd class="col-sm-8">@displayPhone</dd>

                @if (!string.IsNullOrWhiteSpace(Model.Company ?? Model.SubmittedCompanyName))
                {
                    <dt class="col-sm-4 text-muted">Company Name</dt>
                    <dd class="col-sm-8">@(Model.Company ?? Model.SubmittedCompanyName)</dd>
                }

                @if (!string.IsNullOrWhiteSpace(displayStreet))
                {
                    <dt class="col-sm-4 text-muted">Address</dt>
                    <dd class="col-sm-8">
                        @displayStreet, @displayCity,
                        @displayProvince @displayPostal
                    </dd>
                }

                @if (!string.IsNullOrWhiteSpace(Model.CompanyDescription))
                {
                    <dt class="col-sm-4 text-muted">Company Description</dt>
                    <dd class="col-sm-8" style="white-space:pre-wrap;">@Model.CompanyDescription</dd>
                }

                @if (!string.IsNullOrWhiteSpace(Model.WebsiteSocialMedia))
                {
                    <dt class="col-sm-4 text-muted">Website / Social</dt>
                    <dd class="col-sm-8">@Model.WebsiteSocialMedia</dd>
                }

                <dt class="col-sm-4 text-muted">Submitted</dt>
                <dd class="col-sm-8">@Model.SubmittedDate.ToLocalTime().ToString("MMM d, yyyy h:mm tt")</dd>

                @if (!string.IsNullOrWhiteSpace(Model.ReviewNotes))
                {
                    <dt class="col-sm-4 text-muted">Notes</dt>
                    <dd class="col-sm-8">@Model.ReviewNotes</dd>
                }
            </dl>
    </div>

    @if (Model.Status == "Pending")
    {
        <!-- Approve section -->
        <div class="pi-card mb-3" style="border-left:4px solid var(--pi-emerald);">
            <div class="pi-section-label" style="color:var(--pi-emerald);">Approve this application</div>
                <div class="alert mb-3 p-3" style="background:var(--pi-cool-blue); border:1px solid var(--pi-nitro-blue); border-radius:8px; font-size:0.875rem; color:#0D47A1;">
                    <strong>Approving will:</strong>
                    <ul class="mb-0 mt-1" style="padding-left:1.2rem;">
                        <li>Create a dealer account immediately</li>
                        <li>Auto-generate a temporary password</li>
                        <li>Email login credentials to the dealer</li>
                        <li>You will see the temporary password on the next screen in case email fails</li>
                    </ul>
                </div>
                <form asp-action="ApproveApplication" asp-route-id="@Model.ApplicationID" method="post">
                    @Html.AntiForgeryToken()

                    <div class="pi-card mb-3">
                        <div class="pi-section-label">Account settings (set before approving)</div>
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label fw-semibold">Payment Terms</label>
                                <select name="paymentTermsId" class="form-select">
                                    @foreach (var term in paymentTerms)
                                    {
                                        <option value="@term.PaymentTermsID">@term.TermName</option>
                                    }
                                </select>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-semibold">Tax Status</label>
                                <div class="mt-2">
                                    <div class="form-check">
                                        <input type="checkbox" name="isTaxExempt" id="taxExempt"
                                               value="true" class="form-check-input">
                                        <label for="taxExempt" class="form-check-label">Tax exempt</label>
                                    </div>
                                    <div style="font-size:11px;color:var(--pi-text-2);margin-top:4px;">
                                        Check if dealer is HST exempt
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <button type="submit" class="pi-btn pi-btn-primary">
                        <i class="bi bi-check-circle me-1"></i> Approve Application
                    </button>
                </form>
        </div>

        <!-- Reject section -->
        <div class="pi-card" style="border-left:4px solid var(--pi-danger);">
            <div class="pi-section-label" style="color:var(--pi-danger);">Reject Application</div>
                <form asp-action="RejectApplication" asp-route-id="@Model.ApplicationID" method="post">
                    @Html.AntiForgeryToken()
                    <div class="row g-3 align-items-end">
                        <div class="col-md-7">
                            <label class="form-label fw-semibold">
                                Reason <span class="text-muted fw-normal small">(optional)</span>
                            </label>
                            <textarea name="reason" class="form-control" rows="2"
                                      placeholder="e.g. Outside service area." maxlength="500"></textarea>
                        </div>
                        <div class="col-auto">
                            <button type="submit" class="pi-btn pi-btn-danger">
                                Reject
                            </button>
                        </div>
                    </div>
                </form>
        </div>
    }
    else
    {
        <div class="pi-notice pi-notice-info">
            This application has already been <strong>@Model.Status.ToLower()</strong>
            @if (Model.ReviewedDate.HasValue)
            {
                <span>on @Model.ReviewedDate.Value.ToLocalTime().ToString("MMM d, yyyy")</span>
            }.
        </div>
    }
</div>
