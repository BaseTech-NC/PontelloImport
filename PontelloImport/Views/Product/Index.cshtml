@model IEnumerable<PontelloImport.Models.Product>

@{
    ViewData["Title"] = "Products";
    }

<h1>Products</h1>

<p>
    <a asp-action="Create" class="btn btn-primary">Add New Product</a>
</p>

<table class="table table-hover">
    <thead class="table">
        <tr>
            <th>@Html.DisplayNameFor(model => model.Title)</th>
            <th>@Html.DisplayNameFor(model => model.SKU)</th>
            <th>@Html.DisplayNameFor(model => model.Vendor)</th>
            <th>@Html.DisplayNameFor(model => model.ProductCategory)</th>
            <th>@Html.DisplayNameFor(model => model.Price)</th>
            <th>@Html.DisplayNameFor(model => model.InventoryQuantity)</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
            {
            <tr>
                <td>@Html.DisplayFor(modelItem => item.Title)</td>
                <td>@Html.DisplayFor(modelItem => item.SKU)</td>
                <td>@Html.DisplayFor(modelItem => item.Vendor.VendorName)</td>
                <td>@Html.DisplayFor(modelItem => item.ProductCategory.CategoryName)</td>
                <td>@Html.DisplayFor(modelItem => item.Price)</td>
                <td>@Html.DisplayFor(modelItem => item.InventoryQuantity)</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.ProductID" class="btn btn-sm btn-outline-primary">Edit</a>
                    <a asp-action="Details" asp-route-id="@item.ProductID" class="btn btn-sm btn-outline-secondary">Details</a>
                    <a asp-action="Delete" asp-route-id="@item.ProductID" class="btn btn-sm btn-outline-danger">Archive</a>
                </td>
            </tr>
            }
    </tbody>
</table>

@if (!Model.Any())
    {
    <div class="alert alert-info">
        No products found. <a asp-action="Create">Add your first product</a>.
    </div>
    }