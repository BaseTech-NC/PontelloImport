        @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
        }
    } *@

@model PontelloImport.Models.Product

@{
    ViewData["Title"] = "Create Product";
    }

<h1>Create Product</h1>

<hr />
<div class="row">
    <div class="col-md-8">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <!-- Basic Information -->
            <fieldset class="border p-3 mb-3">
                <legend class="w-auto px-2">Basic Information</legend>

                <div class="mb-3">
                    <label asp-for="Title" class="form-label"></label>
                    <input asp-for="Title" class="form-control" placeholder="e.g., Birel ART RY30-S8 Chassis" />
                    <small class="form-text text-muted">Product name as it appears in catalog</small><br>
                    <span asp-validation-for="Title" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="BodyHTML" class="form-label">Description</label>
                    <textarea asp-for="BodyHTML" class="form-control" rows="4" placeholder="Enter detailed product description. You can use basic HTML tags like <p>, <strong>, <ul>, etc."></textarea>
                    <small class="form-text text-muted">Product description. Basic HTML supported (&lt;p&gt;, &lt;strong&gt;, &lt;ul&gt;)</small>
                    <span asp-validation-for="BodyHTML" class="text-danger"></span>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="VendorID" class="form-label"></label>
                        <select asp-for="VendorID" class="form-select" asp-items="ViewBag.VendorID">
                            <option value="">-- Select Vendor --</option>
                        </select>
                        <small class="form-text text-muted">Select the product manufacturer/vendor</small>
                        <span asp-validation-for="VendorID" class="text-danger"></span>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label asp-for="ProductCategoryID" class="form-label"></label>
                        <select asp-for="ProductCategoryID" class="form-select" asp-items="ViewBag.ProductCategoryID">
                            <option value="">-- Select Category --</option>
                        </select>
                        <small class="form-text text-muted">Select the product category</small>
                        <span asp-validation-for="ProductCategoryID" class="text-danger"></span>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="Type" class="form-label"></label>
                        <input asp-for="Type" class="form-control" placeholder="e.g., Chassis, Engine, Tire" />
                        <small class="form-text text-muted">Product type (e.g., "Chassis", "Engine", "Tire")</small>
                        <span asp-validation-for="Type" class="text-danger"></span>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label asp-for="Tags" class="form-label"></label>
                        <input asp-for="Tags" class="form-control" placeholder="e.g., racing, chassis, competitive, birel" />
                        <small class="form-text text-muted">Comma-separated keywords</small>
                        <span asp-validation-for="Tags" class="text-danger"></span>
                    </div>
                </div>
            </fieldset>

            <!-- Pricing & Inventory -->
            <fieldset class="border p-3 mb-3">
                <legend class="w-auto px-2">Pricing & Inventory</legend>

                <div class="row">
                    <div class="col-md-4 mb-3">
                        <label asp-for="Price" class="form-label"></label>
                        <div class="input-group">
                            <span class="input-group-text">$</span>
                            <input asp-for="Price" class="form-control" type="number" step="0.01" min="0" placeholder="2499.99" />
                        </div>
                        <small class="form-text text-muted">Dealer price in CAD</small>
                        <span asp-validation-for="Price" class="text-danger"></span>
                    </div>
                    <div class="col-md-4 mb-3">
                        <label asp-for="CompareAtPrice" class="form-label">MSRP</label>
                        <div class="input-group">
                            <span class="input-group-text">$</span>
                            <input asp-for="CompareAtPrice" class="form-control" type="number" step="0.01" min="0" placeholder="3299.99" />
                        </div>
                        <small class="form-text text-muted">Optional. Manufacturer's suggested retail price</small>
                        <span asp-validation-for="CompareAtPrice" class="text-danger"></span>
                    </div>
                    <div class="col-md-4 mb-3">
                        <label asp-for="InventoryQuantity" class="form-label"></label>
                        <input asp-for="InventoryQuantity" class="form-control" type="number" min="0" placeholder="12" />
                        <small class="form-text text-muted">Current stock on hand</small>
                        <span asp-validation-for="InventoryQuantity" class="text-danger"></span>
                    </div>
                </div>

                <div class="mb-3">
                    <label asp-for="InventoryPolicy" class="form-label"></label>
                    <select asp-for="InventoryPolicy" class="form-select">
                        <option value="">-- Select Policy --</option>
                        <option value="deny">Deny - Stop sales when out of stock</option>
                        <option value="continue">Continue - Allow backorders</option>
                    </select>
                    <small class="form-text text-warning">"deny" stops sales at zero inventory, "continue" allows backorders</small>
                    <span asp-validation-for="InventoryPolicy" class="text-danger"></span>
                </div>
            </fieldset>

            <!-- Physical Details -->
            <fieldset class="border p-3 mb-3">
                <legend class="w-auto px-2">Physical Details (Optional)</legend>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="Weight" class="form-label"></label>
                        <div class="input-group">
                            <input asp-for="Weight" class="form-control" type="number" step="0.01" min="0" placeholder="15.5" />
                            <span class="input-group-text">grams</span>
                        </div>
                        <small class="form-text text-muted">Product weight in grams</small>
                        <span asp-validation-for="Weight" class="text-danger"></span>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label asp-for="Barcode" class="form-label"></label>
                        <input asp-for="Barcode" class="form-control" placeholder="e.g., 012345678905" />
                        <small class="form-text text-muted">Optional. Manufacturer barcode (UPC/EAN)</small>
                        <span asp-validation-for="Barcode" class="text-danger"></span>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <div class="form-check">
                            <input asp-for="RequiresShipping" class="form-check-input" type="checkbox" checked />
                            <label asp-for="RequiresShipping" class="form-check-label"></label>
                            <small class="form-text text-muted d-block">Check if product needs physical shipping</small>
                        </div>
                    </div>
                    <div class="col-md-6 mb-3">
                        <div class="form-check">
                            <input asp-for="IsTaxable" class="form-check-input" type="checkbox" checked />
                            <label asp-for="IsTaxable" class="form-check-label"></label>
                            <small class="form-text text-muted d-block">Check if product is subject to sales tax</small>
                        </div>
                    </div>
                </div>
            </fieldset>

            <!-- VARIANT TOGGLE SECTION - NEW -->
            <fieldset class="border p-3 mb-3">
                <legend class="w-auto px-2">Product Variants</legend>

                <!-- Variant Toggle Checkbox -->
                <div class="mb-3">
                    <div class="form-check form-switch">
                        <input class="form-check-input" type="checkbox" id="hasVariantsToggle">
                        <label class="form-check-label fw-bold" for="hasVariantsToggle">
                            This product has variants (e.g., different sizes, colors, or configurations)
                        </label>
                    </div>
                    <small class="form-text text-muted">
                        Enable this if your product comes in multiple variations like Size, Color, Material, etc.
                    </small>
                </div>

                <!-- Variant Fields Container - Hidden by default -->
                <div id="variantFieldsContainer" style="display: none;">

                    <div class="alert alert-info">
                        <strong>Creating a Variant Product?</strong>
                        <ul class="mb-0 mt-2">
                            <li>First, create the <strong>parent product</strong> (leave variant fields empty, just basic info)</li>
                            <li>Note the parent's <strong>Handle</strong> after creation (e.g., "birel-art-ry30-s8-chassis")</li>
                            <li>Then create each <strong>variant</strong> by filling in the fields below</li>
                        </ul>
                    </div>

                    <!-- Parent Product Handle -->
                    <div class="mb-3">
                        <label asp-for="ParentProductHandle" class="form-label">Parent Product Handle</label>
                        <input asp-for="ParentProductHandle" class="form-control" placeholder="e.g., birel-art-ry30-s8-chassis" />
                        <small class="form-text text-muted">
                            For variants only - enter the Handle (slug) of the parent product.
                            Leave blank if this IS the parent product.
                        </small>
                        <span asp-validation-for="ParentProductHandle" class="text-danger"></span>
                    </div>

                    <hr class="my-4" />

                    <!-- Option 1 -->
                    <div class="mb-4">
                        <h6 class="text-primary">Option 1 (Required for variants)</h6>
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="Option1Name" class="form-label">Attribute Name</label>
                                <input asp-for="Option1Name" class="form-control" placeholder="e.g., Size" />
                                <small class="form-text text-muted">What attribute varies? (e.g., "Size", "Color", "Length")</small>
                                <span asp-validation-for="Option1Name" class="text-danger"></span>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="Option1Value" class="form-label">Attribute Value</label>
                                <input asp-for="Option1Value" class="form-control" placeholder="e.g., Small" />
                                <small class="form-text text-muted">This variant's value (e.g., "Small", "Red", "30cm")</small>
                                <span asp-validation-for="Option1Value" class="text-danger"></span>
                            </div>
                        </div>
                    </div>

                    <!-- Option 2 -->
                    <div class="mb-4">
                        <h6 class="text-secondary">Option 2 (Optional)</h6>
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="Option2Name" class="form-label">Attribute Name</label>
                                <input asp-for="Option2Name" class="form-control" placeholder="e.g., Color" />
                                <small class="form-text text-muted">Optional second attribute</small>
                                <span asp-validation-for="Option2Name" class="text-danger"></span>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="Option2Value" class="form-label">Attribute Value</label>
                                <input asp-for="Option2Value" class="form-control" placeholder="e.g., Blue" />
                                <small class="form-text text-muted">This variant's second value</small>
                                <span asp-validation-for="Option2Value" class="text-danger"></span>
                            </div>
                        </div>
                    </div>

                    <!-- Option 3 -->
                    <div class="mb-4">
                        <h6 class="text-secondary">Option 3 (Optional)</h6>
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="Option3Name" class="form-label">Attribute Name</label>
                                <input asp-for="Option3Name" class="form-control" placeholder="e.g., Material" />
                                <small class="form-text text-muted">Optional third attribute</small>
                                <span asp-validation-for="Option3Name" class="text-danger"></span>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="Option3Value" class="form-label">Attribute Value</label>
                                <input asp-for="Option3Value" class="form-control" placeholder="e.g., Aluminum" />
                                <small class="form-text text-muted">This variant's third value</small>
                                <span asp-validation-for="Option3Value" class="text-danger"></span>
                            </div>
                        </div>
                    </div>

                    <!-- Variant Example -->
                    <div class="alert alert-success">
                        <strong>Example:</strong> Creating a chassis that comes in Small, Medium, Large
                        <ul class="mb-0 mt-2">
                            <li><strong>Parent:</strong> Title = "Birel ART RY30-S8 Chassis", Leave variants blank</li>
                            <li><strong>Variant 1:</strong> Title = "Birel ART RY30-S8 Chassis - Small", ParentHandle = "birel-art-ry30-s8-chassis", Option1Name = "Size", Option1Value = "Small"</li>
                            <li><strong>Variant 2:</strong> Same but Option1Value = "Medium"</li>
                            <li><strong>Variant 3:</strong> Same but Option1Value = "Large"</li>
                        </ul>
                    </div>

                </div>
            </fieldset>

            <!-- Status -->
            <fieldset class="border p-3 mb-3">
                <legend class="w-auto px-2">Status</legend>

                <div class="form-check">
                    <input asp-for="IsActive" class="form-check-input" type="checkbox" checked />
                    <label asp-for="IsActive" class="form-check-label"></label>
                    <small class="form-text text-muted d-block">Uncheck to archive this product (hidden from catalog)</small>
                </div>
            </fieldset>

            <!-- Auto-Generated Fields (Read-Only Info) -->
            <div class="alert alert-secondary">
                <strong>Auto-Generated Fields:</strong>
                <ul class="mb-0">
                    <li><strong>Handle:</strong> URL-friendly slug auto-generated from Title</li>
                    <li><strong>SKU:</strong> Product code auto-generated (PROD-0001 format)</li>
                </ul>
                <small>You don't need to fill these - they're created automatically when you save.</small>
            </div>

            <!-- Submit Buttons -->
            <div class="mb-3">
                <button type="submit" class="btn btn-primary">Create Product</button>
                <a asp-action="Index" class="btn btn-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>

    @section Scripts {
        @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
        }

    <script>
        // Toggle variant fields visibility
        document.getElementById('hasVariantsToggle').addEventListener('change', function() {
            const variantContainer = document.getElementById('variantFieldsContainer');
            if (this.checked) {
                variantContainer.style.display = 'block';
            } else {
                variantContainer.style.display = 'none';
            }
        });
    </script>
    }
