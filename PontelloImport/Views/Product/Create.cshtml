@model PontelloImport.Models.Product

@{
    ViewData["Title"] = "Create Product";
    }

<h1>Create Product</h1>

<hr />
<div class="row">
    <div class="col-md-8">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <fieldset class="border p-3 mb-3">
                <legend class="w-auto px-2">Basic Information</legend>

                <div class="mb-3">
                    <label asp-for="Title" class="form-label"></label>
                    <input asp-for="Title" class="form-control" placeholder="Enter product title" />
                    <span asp-validation-for="Title" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="BodyHTML" class="form-label">Description</label>
                    <textarea asp-for="BodyHTML" class="form-control" rows="4" placeholder="Enter product description"></textarea>
                    <span asp-validation-for="BodyHTML" class="text-danger"></span>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="VendorID" class="form-label"></label>
                        <select asp-for="VendorID" class="form-select" asp-items="ViewBag.VendorID">
                            <option value="">-- Select Vendor --</option>
                        </select>
                        <span asp-validation-for="VendorID" class="text-danger"></span>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label asp-for="ProductCategoryID" class="form-label"></label>
                        <select asp-for="ProductCategoryID" class="form-select" asp-items="ViewBag.ProductCategoryID">
                            <option value="">-- Select Category --</option>
                        </select>
                        <span asp-validation-for="ProductCategoryID" class="text-danger"></span>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="Type" class="form-label"></label>
                        <input asp-for="Type" class="form-control" placeholder="e.g., Tire, Chassis, Brake Pad" />
                        <span asp-validation-for="Type" class="text-danger"></span>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label asp-for="Tags" class="form-label"></label>
                        <input asp-for="Tags" class="form-control" placeholder="Comma-separated tags" />
                        <span asp-validation-for="Tags" class="text-danger"></span>
                    </div>
                </div>
            </fieldset>

            <fieldset class="border p-3 mb-3">
                <legend class="w-auto px-2">Pricing & Inventory</legend>

                <div class="row">
                    <div class="col-md-4 mb-3">
                        <label asp-for="Price" class="form-label"></label>
                        <div class="input-group">
                            <span class="input-group-text">$</span>
                            <input asp-for="Price" class="form-control" type="number" step="0.01" min="0" />
                        </div>
                        <span asp-validation-for="Price" class="text-danger"></span>
                    </div>
                    <div class="col-md-4 mb-3">
                        <label asp-for="CompareAtPrice" class="form-label"></label>
                        <div class="input-group">
                            <span class="input-group-text">$</span>
                            <input asp-for="CompareAtPrice" class="form-control" type="number" step="0.01" min="0" />
                        </div>
                        <span asp-validation-for="CompareAtPrice" class="text-danger"></span>
                    </div>
                    <div class="col-md-4 mb-3">
                        <label asp-for="InventoryQuantity" class="form-label"></label>
                        <input asp-for="InventoryQuantity" class="form-control" type="number" min="0" />
                        <span asp-validation-for="InventoryQuantity" class="text-danger"></span>
                    </div>
                </div>

                <div class="mb-3">
                    <label asp-for="InventoryPolicy" class="form-label"></label>
                    <select asp-for="InventoryPolicy" class="form-select">
                        <option value="deny">Deny - Don't allow orders when out of stock</option>
                        <option value="continue">Continue - Allow backorders</option>
                    </select>
                    <span asp-validation-for="InventoryPolicy" class="text-danger"></span>
                </div>
            </fieldset>

            <fieldset class="border p-3 mb-3">
                <legend class="w-auto px-2">Physical Details (Optional)</legend>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="Weight" class="form-label"></label>
                        <div class="input-group">
                            <input asp-for="Weight" class="form-control" type="number" step="0.01" min="0" />
                            <span class="input-group-text">grams</span>
                        </div>
                        <span asp-validation-for="Weight" class="text-danger"></span>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label asp-for="Barcode" class="form-label"></label>
                        <input asp-for="Barcode" class="form-control" placeholder="UPC/EAN barcode" />
                        <span asp-validation-for="Barcode" class="text-danger"></span>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <div class="form-check">
                            <input asp-for="RequiresShipping" class="form-check-input" type="checkbox" checked />
                            <label asp-for="RequiresShipping" class="form-check-label"></label>
                        </div>
                    </div>
                    <div class="col-md-6 mb-3">
                        <div class="form-check">
                            <input asp-for="IsTaxable" class="form-check-input" type="checkbox" checked />
                            <label asp-for="IsTaxable" class="form-check-label"></label>
                        </div>
                    </div>
                </div>
            </fieldset>

            <div class="mb-3">
                <button type="submit" class="btn btn-primary">Create Product</button>
                <a asp-action="Index" class="btn btn-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>

    @section Scripts {
        @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
        }
    }