@model PontelloImport.Models.Product

@{
    ViewData["Title"] = "Product Details";
    }

<h1>Product Details</h1>

<div class="row">
    <div class="col-md-8">
        <div class="card">
            <div class="card-header">
                <h4>@Model.Title</h4>
                <span class="badge bg-secondary">@Model.SKU</span>
                @if (!Model.IsActive)
                    {
                    <span class="badge bg-danger">Archived</span>
                    }
            </div>
            <div class="card-body">
                <dl class="row">
                    <dt class="col-sm-3">Handle</dt>
                    <dd class="col-sm-9">@Model.Handle</dd>

                    <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Vendor)</dt>
                    <dd class="col-sm-9">@Model.Vendor?.VendorName</dd>

                    <dt class="col-sm-3">@Html.DisplayNameFor(model => model.ProductCategory)</dt>
                    <dd class="col-sm-9">@Model.ProductCategory?.CategoryName</dd>

                    <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Type)</dt>
                    <dd class="col-sm-9">@(Model.Type ?? "—")</dd>

                    <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Tags)</dt>
                    <dd class="col-sm-9">@(Model.Tags ?? "—")</dd>

                    <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Price)</dt>
                    <dd class="col-sm-9">@Model.Price.ToString("C")</dd>

                    <dt class="col-sm-3">@Html.DisplayNameFor(model => model.CompareAtPrice)</dt>
                    <dd class="col-sm-9">@(Model.CompareAtPrice?.ToString("C") ?? "—")</dd>

                    <dt class="col-sm-3">@Html.DisplayNameFor(model => model.InventoryQuantity)</dt>
                    <dd class="col-sm-9">@Model.InventoryQuantity</dd>

                    <dt class="col-sm-3">@Html.DisplayNameFor(model => model.InventoryPolicy)</dt>
                    <dd class="col-sm-9">@Model.InventoryPolicy</dd>

                    <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Weight)</dt>
                    <dd class="col-sm-9">@(Model.Weight?.ToString("N2") ?? "—") g</dd>

                    <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Barcode)</dt>
                    <dd class="col-sm-9">@(Model.Barcode ?? "—")</dd>

                    <dt class="col-sm-3">@Html.DisplayNameFor(model => model.RequiresShipping)</dt>
                    <dd class="col-sm-9">@(Model.RequiresShipping ? "Yes" : "No")</dd>

                    <dt class="col-sm-3">@Html.DisplayNameFor(model => model.IsTaxable)</dt>
                    <dd class="col-sm-9">@(Model.IsTaxable ? "Yes" : "No")</dd>
                </dl>

                @if (!string.IsNullOrEmpty(Model.BodyHTML))
                    {
                    <hr />
                    <h5>Description</h5>
                    <div class="border p-3 bg-light">
                        @Html.Raw(Model.BodyHTML)
                    </div>
                    }
            </div>
            <div class="card-footer text-muted">
                <small>
                    Created: @Model.CreatedDate?.ToString("yyyy-MM-dd HH:mm") |
                    Modified: @Model.ModifiedDate?.ToString("yyyy-MM-dd HH:mm")
                </small>
            </div>
        </div>

        <div class="mt-3">
            <a asp-action="Edit" asp-route-id="@Model.ProductID" class="btn btn-primary">Edit</a>
            <a asp-action="Index" class="btn btn-secondary">Back to List</a>
        </div>
    </div>
</div>