<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Pontello Imports</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/PontelloImport.styles.css" asp-append-version="true" />
    <style>
        *, *::before, *::after { font-family: Inter, system-ui, sans-serif; }
        body { background-color: #F8FAFC; color: #111827; }

        .navbar {
            border-bottom: 1px solid #E5E7EB !important;
            box-shadow: none !important;
            padding-top: 0.6rem;
            padding-bottom: 0.6rem;
        }
        .navbar-landing {
            background-color: #091F1C !important;
            border-bottom: 1px solid rgba(255,255,255,0.12) !important;
        }
        .navbar-site    { background-color: #ffffff !important; }

        .navbar-site .nav-link {
            color: #4B5563 !important;
            font-size: 0.9rem; font-weight: 500;
            padding: 0.35rem 0.75rem; border-radius: 6px;
            transition: color 150ms, background 150ms;
        }
        .navbar-site .nav-link:hover { color: #111827 !important; background-color: #F3F4F6; }

        .navbar-landing .nav-link {
            color: rgba(255,255,255,0.85) !important;
            font-size: 0.9rem; font-weight: 500;
            padding: 0.35rem 0.75rem; border-radius: 6px;
            transition: color 150ms, background 150ms;
        }
        .navbar-landing .nav-link:hover { color: #ffffff !important; background: rgba(255,255,255,0.1); }
    </style>
</head>
<body>
    <header>
        @{
            bool isLanding = (bool?)ViewData["LandingPage"] == true;
        }
        <nav class="navbar navbar-expand-sm @(isLanding ? "navbar-landing" : "navbar-site")" aria-label="Main navigation">
            <div class="container-fluid px-4">

                <a class="navbar-brand p-0 me-4" asp-controller="Home" asp-action="Index">
                    <img src="~/images/pontello-Imports-Logo.png" alt="Pontello Imports"
                         style="height:38px; width:auto;" />
                </a>

                <button class="navbar-toggler" type="button" data-bs-toggle="collapse"
                        data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between align-items-center">
                    @if (User.IsInRole("Admin") || User.IsInRole("SuperAdmin"))
                    {
                        <ul class="navbar-nav flex-grow-1">
                            <li class="nav-item"><a class="nav-link" asp-controller="ProductVariants" asp-action="Index">Products</a></li>
                            <li class="nav-item"><a class="nav-link" asp-controller="AdminOrders" asp-action="Index">Orders</a></li>
                            <li class="nav-item"><a class="nav-link" asp-controller="AdminDealers" asp-action="Index">Dealers</a></li>
                        </ul>
                        <form asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="/" method="post" class="d-inline">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-sm btn-outline-primary">Sign Out</button>
                        </form>
                    }
                    else if (User.IsInRole("Dealer"))
                    {
                        <ul class="navbar-nav flex-grow-1">
                            <li class="nav-item"><a class="nav-link" asp-controller="Shop" asp-action="Index">Shop</a></li>
                            <li class="nav-item">
                                @{
                                    var unviewedCount = (int)(ViewData["UnviewedOrderCount"] ?? 0);
                                }
                                <a class="nav-link d-flex align-items-center gap-2"
                                   asp-controller="Shop" asp-action="OrderHistory">
                                    Order History
                                    @if (unviewedCount > 0)
                                    {
                                        <span class="badge rounded-pill bg-success">@unviewedCount</span>
                                    }
                                </a>
                            </li>
                        </ul>
                        <form asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="/" method="post" class="d-inline">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-sm btn-outline-secondary">Sign Out</button>
                        </form>
                    }
                    else
                    {
                        <ul class="navbar-nav flex-grow-1"></ul>
                        <div class="d-flex gap-2">
                            <a asp-area="Identity" asp-page="/Account/Login" class="btn btn-sm btn-outline-light">Sign In</a>
                            <a asp-controller="Home" asp-action="Apply"
                               class="btn btn-sm fw-semibold" style="background:#02C39A; color:#111827; border:none;">
                                Apply for Dealer Access
                            </a>
                        </div>
                    }
                </div>
            </div>
        </nav>
    </header>

    @if ((bool?)ViewData["FullWidth"] == true)
    {
        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show mx-4 mt-3" role="alert">
                @TempData["Success"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show mx-4 mt-3" role="alert">
                @TempData["Error"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
        @RenderBody()
    }
    else
    {
        <div class="container">
            <main role="main" class="pb-3">
                @if (TempData["Success"] != null)
                {
                    <div class="alert alert-success alert-dismissible fade show mt-3" role="alert">
                        @TempData["Success"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }
                @if (TempData["Warning"] != null)
                {
                    <div class="alert alert-warning alert-dismissible fade show mt-3" role="alert">
                        @TempData["Warning"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }
                @if (TempData["Error"] != null)
                {
                    <div class="alert alert-danger alert-dismissible fade show mt-3" role="alert">
                        @TempData["Error"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }
                @RenderBody()
            </main>
        </div>

        @if ((bool?)ViewData["HideFooter"] != true)
        {
            <footer class="border-top text-muted mt-5">
                <div class="container py-3" style="font-size:0.8rem; color:#4B5563;">
                    &copy; 2025–2026 Pontello Imports &mdash;
                    <a asp-controller="Home" asp-action="Privacy" style="color:#4B5563;">Privacy</a>
                </div>
            </footer>
        }
    }

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
