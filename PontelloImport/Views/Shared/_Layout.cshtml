<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Pontello Imports</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Archivo+Narrow:ital,wght@0,700;1,700&family=DM+Sans:wght@400;500;600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/PontelloImport.styles.css" asp-append-version="true" />
    <style>
        .navbar-site { background-color: var(--pi-nav-bg) !important; }
    </style>
</head>
<body>
    <header>
        @{
            bool isLanding = (bool?)ViewData["LandingPage"] == true;
        }
        <nav class="navbar navbar-expand-sm @(isLanding ? "navbar-landing" : "navbar-site")" aria-label="Main navigation">
            <div class="container-fluid px-4">

                <a class="navbar-brand p-0 me-4" asp-controller="Home" asp-action="Index">
                    <img src="~/images/pontello-Imports-Logo.png" alt="Pontello Imports" />
                </a>

                <button class="navbar-toggler" type="button" data-bs-toggle="collapse"
                        data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between align-items-center">
                    @if (User.IsInRole("Admin") || User.IsInRole("SuperAdmin"))
                    {
                        <ul class="navbar-nav flex-grow-1">
                            <li class="nav-item"><a class="nav-link" asp-controller="ProductVariants" asp-action="Index">Products</a></li>
                            <li class="nav-item"><a class="nav-link" asp-controller="AdminOrders" asp-action="Index">Orders</a></li>
                            <li class="nav-item"><a class="nav-link" asp-controller="AdminDealers" asp-action="Index">Dealers</a></li>
                        </ul>
                        <form asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="/" method="post" class="d-inline">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="pi-btn pi-btn-ghost pi-btn-sm">Sign Out</button>
                        </form>
                    }
                    else if (User.IsInRole("Dealer"))
                    {
                        var unviewedCount    = (int)(ViewData["UnviewedOrderCount"] ?? 0);
                        var dealerFirstName  = ViewData["DealerFirstName"] as string ?? User.Identity?.Name?.Split('@')[0] ?? "Dealer";
                        var dealerCompany    = ViewData["DealerCompanyName"] as string;
                        var dealerNotifs     = ViewData["DealerNotifications"] as List<PontelloImport.Models.Notification>
                                              ?? new List<PontelloImport.Models.Notification>();
                        var dealerUnread     = (int)(ViewData["DealerUnreadCount"] ?? 0);
                        var cartCount        = (int)(ViewData["CartCount"] ?? 0);
                        <ul class="navbar-nav flex-grow-1">
                            <li class="nav-item"><a class="nav-link" asp-controller="Shop" asp-action="Index">Shop</a></li>
                            <li class="nav-item">
                                <a class="nav-link d-flex align-items-center gap-2"
                                   asp-controller="Shop" asp-action="OrderHistory">
                                    Order History
                                    @if (unviewedCount > 0)
                                    {
                                        <span class="badge rounded-pill bg-success">@unviewedCount</span>
                                    }
                                </a>
                            </li>
                        </ul>

                        @* Dealer cart icon *@
                        <a asp-controller="Shop"
                           asp-action="Cart"
                           class="nav-icon-btn position-relative me-1"
                           aria-label="Shopping cart"
                           style="text-decoration:none;">
                            <svg width="20" height="20" viewBox="0 0 24 24" fill="none"
                                 stroke="currentColor" stroke-width="2"
                                 stroke-linecap="round" stroke-linejoin="round">
                                <circle cx="9" cy="21" r="1"/>
                                <circle cx="20" cy="21" r="1"/>
                                <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/>
                            </svg>
                            @if (cartCount > 0)
                            {
                                <span style="position:absolute;top:-4px;right:-6px;
                                             background:var(--pi-emerald);color:#000000;
                                             border-radius:50%;width:17px;height:17px;
                                             font-size:10px;font-weight:700;
                                             display:flex;align-items:center;justify-content:center;
                                             font-family:var(--pi-font-body);line-height:1;">
                                    @(cartCount > 9 ? "9+" : cartCount.ToString())
                                </span>
                            }
                        </a>

                        @* Dealer notification bell *@
                        <div class="dropdown me-2" id="notifDropdown">
                            <button class="nav-icon-btn position-relative"
                                    type="button" data-bs-toggle="dropdown" aria-expanded="false"
                                    aria-label="Notifications">
                                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="currentColor" viewBox="0 0 16 16">
                                    <path d="M8 16a2 2 0 0 0 2-2H6a2 2 0 0 0 2 2z"/>
                                    <path d="M8 1.918l-.797.161A4 4 0 0 0 4 6c0 .628-.134 2.197-.459 3.742-.16.767-.376 1.566-.663 2.258h10.244c-.287-.692-.502-1.49-.663-2.258C12.134 8.197 12 6.628 12 6a4 4 0 0 0-3.203-3.92L8 1.917zM14.22 12c.223.447.481.801.78 1H1c.299-.199.557-.553.78-1C2.68 10.2 3 6.88 3 6c0-2.42 1.72-4.44 4.005-4.901a1 1 0 1 1 1.99 0A5 5 0 0 1 13 6c0 .88.32 4.2 1.22 6z"/>
                                </svg>
                                <span id="notifBadge" class="position-absolute top-0 start-100 translate-middle badge rounded-pill"
                                      style="background:var(--pi-nitro-blue); font-size:0.6rem; min-width:16px; padding:2px 4px;
                                             transform: translate(-70%, 0%) !important;
                                             @(dealerUnread == 0 ? "display:none;" : "")">
                                    @(dealerUnread > 9 ? "9+" : dealerUnread.ToString())
                                </span>
                            </button>
                            <div class="dropdown-menu dropdown-menu-end shadow p-0"
                                 style="min-width:310px; font-size:0.875rem; max-height:420px; overflow-y:auto;">
                                <div class="px-3 py-2 border-bottom d-flex align-items-center justify-content-between"
                                     style="position:sticky;top:0;background:#fff;z-index:1;">
                                    <span class="fw-semibold text-dark">Notifications</span>
                                    <div class="d-flex gap-2 align-items-center">
                                        <button type="button" id="markAllReadBtn"
                                                class="btn btn-link p-0"
                                                style="font-size:0.75rem; color:var(--pi-nitro-blue); text-decoration:none;
                                                       @(dealerUnread == 0 ? "display:none;" : "")"
                                                onclick="dealerMarkAllRead()">
                                            Mark all read
                                        </button>
                                        @if (dealerNotifs.Any())
                                        {
                                            <button type="button"
                                                    id="dealerClearAllBtn"
                                                    onclick="dealerClearAll(event)"
                                                    style="font-size:0.75rem;color:var(--pi-danger);
                                                           background:none;border:none;cursor:pointer;
                                                           font-family:var(--pi-font-body);padding:0;">
                                                Clear all
                                            </button>
                                        }
                                    </div>
                                </div>
                                <div id="notifList">
                                    @if (!dealerNotifs.Any())
                                    {
                                        <div class="px-3 py-4 text-center text-muted" id="notifEmpty">
                                            <small>No notifications</small>
                                        </div>
                                    }
                                    else
                                    {
                                        foreach (var dn in dealerNotifs)
                                        {
                                            var dnDiff = DateTime.UtcNow - dn.CreatedDate;
                                            string dnRel;
                                            if (dnDiff.TotalMinutes < 2)      dnRel = "just now";
                                            else if (dnDiff.TotalHours < 1)   dnRel = $"{(int)dnDiff.TotalMinutes}m ago";
                                            else if (dnDiff.TotalDays < 1)    dnRel = $"{(int)dnDiff.TotalHours}h ago";
                                            else if (dnDiff.TotalDays < 7)    dnRel = $"{(int)dnDiff.TotalDays}d ago";
                                            else                              dnRel = dn.CreatedDate.ToLocalTime().ToString("MMM d");

                                            <div class="pi-notif @(dn.IsRead ? "" : "unread")"
                                                 id="notif-@dn.NotificationID"
                                                 data-id="@dn.NotificationID">
                                                <div class="pi-notif-msg">
                                                    @if (!string.IsNullOrEmpty(dn.ActionUrl))
                                                    {
                                                        <a href="@dn.ActionUrl" class="pi-notif-link">@dn.Message</a>
                                                    }
                                                    else
                                                    {
                                                        @dn.Message
                                                    }
                                                </div>
                                                <div class="pi-notif-time">@dnRel</div>
                                                <div class="pi-notif-actions">
                                                    @if (!dn.IsRead)
                                                    {
                                                        <button type="button" class="pi-notif-btn pi-notif-read"
                                                                title="Mark as read"
                                                                onclick="dealerMarkRead(@dn.NotificationID, this)">✓</button>
                                                    }
                                                    <button type="button" class="pi-notif-btn pi-notif-dismiss"
                                                            title="Dismiss"
                                                            onclick="dealerDismiss(@dn.NotificationID, this)"></button>
                                                </div>
                                            </div>
                                        }
                                    }
                                </div>
                            </div>
                        </div>
                        @* Hidden CSRF input for AJAX *@
                        <input type="hidden" id="piCsrfToken" name="__RequestVerificationToken"
                               value="@(ViewContext.HttpContext.RequestServices
                                   .GetService(typeof(Microsoft.AspNetCore.Antiforgery.IAntiforgery)) is
                                   Microsoft.AspNetCore.Antiforgery.IAntiforgery af
                                   ? af.GetAndStoreTokens(ViewContext.HttpContext).RequestToken
                                   : "")" />

                        <div class="dropdown me-2">
                            <button class="btn btn-link dropdown-toggle p-0"
                                    type="button" data-bs-toggle="dropdown"
                                    style="color:var(--pi-nav-text);font-size:0.875rem;font-weight:500;text-decoration:none;">
                                @dealerFirstName
                                @if (!string.IsNullOrWhiteSpace(dealerCompany))
                                {
                                    <span class="fw-normal" style="color:var(--pi-text-2);"> — @dealerCompany</span>
                                }
                            </button>
                            <ul class="dropdown-menu dropdown-menu-end shadow" style="font-size:0.875rem;">
                                <li>
                                    <a asp-controller="DealerAccount" asp-action="ManageAccount"
                                       class="dropdown-item">
                                        Manage Account
                                    </a>
                                </li>
                                <li><hr class="dropdown-divider" /></li>
                                <li>
                                    <form asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="/" method="post">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="dropdown-item text-danger">Sign Out</button>
                                    </form>
                                </li>
                            </ul>
                        </div>
                    }
                    else
                    {
                        <ul class="navbar-nav flex-grow-1"></ul>
                        <div class="d-flex gap-2">
                            <a asp-area="Identity" asp-page="/Account/Login"
                               style="background:#C7EEFF; color:#000000; border:none;
                                      font-family:var(--pi-font-body); font-weight:600;
                                      letter-spacing:1.5px; text-transform:uppercase;
                                      font-size:12px; padding:10px 22px;
                                      border-radius:5px; text-decoration:none;
                                      display:inline-flex; align-items:center;
                                      cursor:pointer; transition:opacity 0.15s;"
                               onmouseover="this.style.opacity='0.85'"
                               onmouseout="this.style.opacity='1'">Sign In</a>
                            <a asp-controller="Home" asp-action="Apply"
                               style="background:#55DA7D; color:#000000; border:none;
                                      font-family:var(--pi-font-body); font-weight:600;
                                      letter-spacing:1.5px; text-transform:uppercase;
                                      font-size:12px; padding:10px 22px;
                                      border-radius:5px; text-decoration:none;
                                      display:inline-flex; align-items:center;
                                      cursor:pointer; transition:opacity 0.15s;"
                               onmouseover="this.style.opacity='0.85'"
                               onmouseout="this.style.opacity='1'">
                                Open a Dealer Account
                            </a>
                        </div>
                    }
                </div>
            </div>
        </nav>
    </header>

    @if ((bool?)ViewData["FullWidth"] == true)
    {
        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show mx-4 mt-3" role="alert">
                @TempData["Success"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show mx-4 mt-3" role="alert">
                @TempData["Error"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
        @RenderBody()
    }
    else
    {
        <div class="container">
            <main role="main" class="pb-3">
                @if (TempData["Success"] != null)
                {
                    <div class="alert alert-success alert-dismissible fade show mt-3" role="alert">
                        @TempData["Success"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }
                @if (TempData["Warning"] != null)
                {
                    <div class="alert alert-dismissible fade show mt-3" role="alert"
                         style="background:#F0F9FF;border-left:3px solid #0284C7;color:#0C4A6E;border-radius:6px;">
                        @TempData["Warning"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }
                @if (TempData["Error"] != null)
                {
                    <div class="alert alert-danger alert-dismissible fade show mt-3" role="alert">
                        @TempData["Error"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }
                @RenderBody()
            </main>
        </div>

        @if ((bool?)ViewData["HideFooter"] != true)
        {
            <footer class="border-top text-muted mt-5">
                <div class="container py-3" style="font-size:0.8rem; color:#4B5563;">
                    &copy; 2025–2026 Pontello Imports &mdash;
                    <a asp-controller="Home" asp-action="Privacy" style="color:#4B5563;">Privacy</a>
                </div>
            </footer>
        }
    }

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script>
    function togglePwd(fieldId, btn) {
        var f = document.getElementById(fieldId);
        var isHidden = f.type === 'password';
        f.type = isHidden ? 'text' : 'password';
        var svg = btn.querySelector('svg');
        if (isHidden) {
            svg.innerHTML = '<path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"/><line x1="1" y1="1" x2="23" y2="23"/>';
        } else {
            svg.innerHTML = '<path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/>';
        }
    }
    </script>
    <script>
    document.addEventListener('DOMContentLoaded', function () {
        var tooltipEls = document.querySelectorAll('[data-bs-toggle="tooltip"]');
        tooltipEls.forEach(function (el) {
            new bootstrap.Tooltip(el, {
                trigger: 'hover',
                placement: el.dataset.bsPlacement || 'top'
            });
        });
    });
    </script>
    <script>
    function piCsrf() {
        var el = document.getElementById('piCsrfToken');
        return el ? el.value : '';
    }
    function dealerUpdateBadge() {
        var unread = document.querySelectorAll('#notifList .pi-notif.unread').length;
        var badge = document.getElementById('notifBadge');
        var markAllBtn = document.getElementById('markAllReadBtn');
        if (badge) {
            badge.textContent = unread > 9 ? '9+' : unread;
            badge.style.display = unread === 0 ? 'none' : '';
        }
        if (markAllBtn) markAllBtn.style.display = unread === 0 ? 'none' : '';
    }
    function dealerMarkRead(id, btn) {
        fetch('/Shop/DealerMarkNotificationReadJson/' + id, {
            method: 'POST',
            headers: { 'RequestVerificationToken': piCsrf() }
        }).then(function(r) { return r.json(); }).then(function(d) {
            if (!d.ok) return;
            var item = document.getElementById('notif-' + id);
            if (item) {
                item.classList.remove('unread');
                if (btn) btn.remove();
            }
            dealerUpdateBadge();
        });
    }
    function dealerDismiss(id, btn) {
        fetch('/Shop/DealerDismissNotificationJson/' + id, {
            method: 'POST',
            headers: { 'RequestVerificationToken': piCsrf() }
        }).then(function(r) { return r.json(); }).then(function(d) {
            if (!d.ok) return;
            var item = document.getElementById('notif-' + id);
            if (item) item.remove();
            if (document.querySelectorAll('#notifList .pi-notif').length === 0) {
                var list = document.getElementById('notifList');
                if (list) list.innerHTML = '<div class="px-3 py-4 text-center text-muted"><small>No notifications</small></div>';
            }
            dealerUpdateBadge();
        });
    }
    function dealerMarkAllRead() {
        document.querySelectorAll('#notifList .pi-notif.unread').forEach(function(item) {
            var id = item.dataset.id;
            dealerMarkRead(id, item.querySelector('.pi-notif-read'));
        });
    }
    async function dealerClearAll(e) {
        e.stopPropagation();
        var unread = document.querySelectorAll('#notifList .pi-notif.unread').length;
        if (unread > 0) {
            if (!confirm('You have ' + unread + ' unread notification' + (unread > 1 ? 's' : '') + '. Clear everything?'))
                return;
        }
        await fetch('/Shop/DealerClearAllNotificationsJson', {
            method: 'POST',
            headers: { 'RequestVerificationToken': piCsrf() }
        });
        document.querySelectorAll('#notifList .pi-notif').forEach(function(n) { n.remove(); });
        var badge = document.getElementById('notifBadge');
        if (badge) badge.style.display = 'none';
        var clearBtn = document.getElementById('dealerClearAllBtn');
        if (clearBtn) clearBtn.style.display = 'none';
        var markAllBtn = document.getElementById('markAllReadBtn');
        if (markAllBtn) markAllBtn.style.display = 'none';
        var list = document.getElementById('notifList');
        if (list && list.querySelectorAll('.pi-notif').length === 0)
            list.innerHTML = '<div class="px-3 py-4 text-center text-muted"><small>No notifications</small></div>';
    }
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
