@model PontelloImport.Models.Product

@{
    ViewData["Title"] = Model.Title;
    var variants = Model.ProductVariants.ToList();
    var isSimpleProduct = variants.Any() && variants[0].Option1Name == "Title";
    var hasMultipleVariants = !isSimpleProduct && variants.Count > 1;
    var defaultVariant = variants.FirstOrDefault(v => v.IsDefault) ?? variants.FirstOrDefault();
    var hasDescription = !string.IsNullOrWhiteSpace(Model.Description);
    var hasSpecs = Model.ProductSpecifications.Any();
}

<style>
    .product-price-display { font-size: 1.75rem; font-weight: 700; color: #111827; }
    .stock-badge-in    { display: inline-block; padding: 2px 10px; border-radius: 999px; font-size: 0.78rem; font-weight: 600; background: #F0FDF4; color: #15803D; }
    .stock-badge-low   { display: inline-block; padding: 2px 10px; border-radius: 999px; font-size: 0.78rem; font-weight: 600; background: #FFF7ED; color: #92400E; }
    .stock-badge-out   { display: inline-block; padding: 2px 10px; border-radius: 999px; font-size: 0.78rem; font-weight: 600; background: #FEF2F2; color: #B91C1C; }
    .product-desc { color: #374151; line-height: 1.7; font-size: 0.95rem; }
    .spec-table th { font-size: 0.82rem; font-weight: 500; color: #6B7280; width: 40%; background: transparent; border-color: #F3F4F6; }
    .spec-table td { font-size: 0.875rem; color: #111827; border-color: #F3F4F6; }
    .product-card { background: #ffffff; border: 1px solid #E5E7EB; border-radius: 12px; padding: 1.5rem; }
</style>

<nav aria-label="breadcrumb" class="mb-3">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-controller="Shop" asp-action="Index">Shop</a></li>
        <li class="breadcrumb-item active">@Model.Title</li>
    </ol>
</nav>

<div class="row g-4">

    <!-- ── Left column: content ─────────────────────────────────────────── -->
    <div class="col-lg-7">

        <h1 class="h3 fw-bold mb-1" style="color:#111827;">@Model.Title</h1>
        <p class="text-muted mb-3" style="font-size:0.875rem;">
            @(Model.Vendor?.VendorName ?? "—")
            @if (Model.ProductCategory != null)
            {
                <span class="mx-1">·</span>@Model.ProductCategory.CategoryName
            }
        </p>

        @if (hasDescription)
        {
            <div class="product-desc mb-4">
                @Model.Description
            </div>
        }

        @if (hasSpecs)
        {
            <div class="mb-4">
                <h6 class="fw-semibold mb-2" style="color:#374151; font-size:0.875rem; text-transform:uppercase; letter-spacing:0.04em;">Specifications</h6>
                <table class="table table-sm spec-table">
                    <tbody>
                        @foreach (var spec in Model.ProductSpecifications)
                        {
                            <tr>
                                <th>@spec.Name</th>
                                <td>@spec.Value</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }

        @if (!hasDescription && !hasSpecs)
        {
            <div class="bg-light rounded p-5 text-center text-muted">
                <div class="fs-1 mb-2">📦</div>
                @if (Model.ProductCategory != null)
                {
                    <div class="fw-medium mb-1">@Model.ProductCategory.CategoryName</div>
                }
                @if (Model.Vendor != null)
                {
                    <div class="small">by @Model.Vendor.VendorName</div>
                }
            </div>
        }

    </div>

    <!-- ── Right column: buy panel ──────────────────────────────────────── -->
    <div class="col-lg-5">
        <div class="product-card">
            <form asp-action="AddToCart" method="post">
                @Html.AntiForgeryToken()

                <!-- Price display -->
                <div class="product-price-display mb-1" id="variantPrice">
                    $@(defaultVariant?.Price.ToString("F2") ?? "0.00")
                </div>
                <p class="text-muted small mb-3" id="variantSku">SKU: @(defaultVariant?.SKU ?? "")</p>

                <!-- Variant selector (multi-variant) -->
                @if (hasMultipleVariants)
                {
                    <div class="mb-3">
                        <label class="form-label fw-semibold" style="font-size:0.875rem;">Select Option</label>
                        <select id="variantSelect" name="productVariantId" class="form-select">
                            @foreach (var v in variants)
                            {
                                var label = BuildVariantLabel(v);
                                <option value="@v.VariantID"
                                        data-price="@v.Price.ToString("F2", System.Globalization.CultureInfo.InvariantCulture)"
                                        data-sku="@v.SKU"
                                        data-stock="@v.InventoryQuantity"
                                        data-options="@BuildOptionsJson(v)"
                                        selected="@(v.VariantID == defaultVariant?.VariantID)">
                                    @label — $@v.Price.ToString("F2")
                                </option>
                            }
                        </select>
                    </div>
                    <div id="variantOptions" class="mb-3"></div>
                }
                else if (defaultVariant != null)
                {
                    <input type="hidden" name="productVariantId" value="@defaultVariant.VariantID" />

                    var opts = GetOptionPairs(defaultVariant);
                    if (opts.Any())
                    {
                        <div class="mb-3">
                            <table class="table table-sm table-borderless mb-0">
                                @foreach (var (name, val) in opts)
                                {
                                    <tr>
                                        <th class="ps-0 text-muted" style="font-size:0.82rem; width:40%;">@name</th>
                                        <td style="font-size:0.875rem;">@val</td>
                                    </tr>
                                }
                            </table>
                        </div>
                    }
                }

                <!-- Stock indicator -->
                @{
                    var stockQty = defaultVariant?.InventoryQuantity ?? 0;
                }
                <div class="mb-3" id="stockIndicator">
                    @if (stockQty > 10)
                    {
                        <span class="stock-badge-in">In Stock</span>
                    }
                    else if (stockQty >= 1)
                    {
                        <span class="stock-badge-low">Low Stock (@stockQty left)</span>
                    }
                    else
                    {
                        <span class="stock-badge-out">Out of Stock</span>
                    }
                </div>

                <!-- Quantity -->
                <div class="mb-3">
                    <label class="form-label fw-semibold" style="font-size:0.875rem;">Quantity</label>
                    <input type="number" name="quantity" id="qtyInput" class="form-control"
                           value="1" min="1" style="max-width:100px;"
                           @(stockQty == 0 ? "disabled" : "") />
                </div>

                <!-- Add to Cart -->
                <button type="submit" id="addToCartBtn"
                        class="btn btn-primary w-100 btn-lg"
                        @(stockQty == 0 ? "disabled" : "")>
                    @(stockQty == 0 ? "Out of Stock" : "Add to Cart")
                </button>

            </form>

            <div class="mt-3 text-center" style="border-top:1px solid #F3F4F6; padding-top:0.75rem;">
                <a asp-action="Cart" class="text-decoration-none text-muted small">View Cart</a>
                &nbsp;·&nbsp;
                <a asp-action="Index" class="text-decoration-none text-muted small">Continue Shopping</a>
            </div>
        </div>
    </div>

</div>

@functions {
    string BuildVariantLabel(PontelloImport.Models.ProductVariant v)
    {
        var parts = new List<string>();
        if (!string.IsNullOrWhiteSpace(v.Option1Value) && v.Option1Name != "Title") parts.Add(v.Option1Value!);
        if (!string.IsNullOrWhiteSpace(v.Option2Value)) parts.Add(v.Option2Value!);
        if (!string.IsNullOrWhiteSpace(v.Option3Value)) parts.Add(v.Option3Value!);
        if (!string.IsNullOrWhiteSpace(v.Option4Value)) parts.Add(v.Option4Value!);
        if (!string.IsNullOrWhiteSpace(v.Option5Value)) parts.Add(v.Option5Value!);
        return parts.Any() ? string.Join(" / ", parts) : v.SKU;
    }

    string BuildOptionsJson(PontelloImport.Models.ProductVariant v)
    {
        var pairs = GetOptionPairs(v);
        var items = pairs.Select(p => $"{{\"name\":\"{EscapeJson(p.Item1)}\",\"value\":\"{EscapeJson(p.Item2)}\"}}");
        return "[" + string.Join(",", items) + "]";
    }

    List<(string, string)> GetOptionPairs(PontelloImport.Models.ProductVariant v)
    {
        var list = new List<(string, string)>();
        if (!string.IsNullOrWhiteSpace(v.Option1Name) && !string.IsNullOrWhiteSpace(v.Option1Value) && v.Option1Name != "Title")
            list.Add((v.Option1Name!, v.Option1Value!));
        if (!string.IsNullOrWhiteSpace(v.Option2Name) && !string.IsNullOrWhiteSpace(v.Option2Value))
            list.Add((v.Option2Name!, v.Option2Value!));
        if (!string.IsNullOrWhiteSpace(v.Option3Name) && !string.IsNullOrWhiteSpace(v.Option3Value))
            list.Add((v.Option3Name!, v.Option3Value!));
        if (!string.IsNullOrWhiteSpace(v.Option4Name) && !string.IsNullOrWhiteSpace(v.Option4Value))
            list.Add((v.Option4Name!, v.Option4Value!));
        if (!string.IsNullOrWhiteSpace(v.Option5Name) && !string.IsNullOrWhiteSpace(v.Option5Value))
            list.Add((v.Option5Name!, v.Option5Value!));
        return list;
    }

    string EscapeJson(string s) => s.Replace("\\", "\\\\").Replace("\"", "\\\"");
}

@section Scripts {
    @if (hasMultipleVariants)
    {
        <script>
        (function () {
            var select   = document.getElementById('variantSelect');
            var priceEl  = document.getElementById('variantPrice');
            var skuEl    = document.getElementById('variantSku');
            var optionsEl = document.getElementById('variantOptions');
            var stockEl  = document.getElementById('stockIndicator');
            var qtyEl    = document.getElementById('qtyInput');
            var addBtn   = document.getElementById('addToCartBtn');

            function stockHtml(qty) {
                if (qty > 10) return '<span class="stock-badge-in">In Stock</span>';
                if (qty >= 1) return '<span class="stock-badge-low">Low Stock (' + qty + ' left)</span>';
                return '<span class="stock-badge-out">Out of Stock</span>';
            }

            function updateVariant() {
                var opt = select.options[select.selectedIndex];
                priceEl.textContent = '$' + opt.getAttribute('data-price');
                skuEl.textContent   = 'SKU: ' + opt.getAttribute('data-sku');
                var qty = parseInt(opt.getAttribute('data-stock') || '0', 10);
                stockEl.innerHTML   = stockHtml(qty);
                var outOfStock = qty === 0;
                qtyEl.disabled  = outOfStock;
                addBtn.disabled = outOfStock;
                addBtn.textContent = outOfStock ? 'Out of Stock' : 'Add to Cart';

                var optionsJson = opt.getAttribute('data-options');
                try {
                    var options = JSON.parse(optionsJson);
                    if (options.length > 0) {
                        var html = '<table class="table table-sm table-borderless mb-0"><tbody>';
                        options.forEach(function (o) {
                            html += '<tr><th class="ps-0 text-muted" style="font-size:0.82rem;width:40%;">' + escHtml(o.name) + '</th><td style="font-size:0.875rem;">' + escHtml(o.value) + '</td></tr>';
                        });
                        html += '</tbody></table>';
                        optionsEl.innerHTML = html;
                    } else { optionsEl.innerHTML = ''; }
                } catch (e) { optionsEl.innerHTML = ''; }
            }

            function escHtml(s) {
                return s.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
            }

            select.addEventListener('change', updateVariant);
            updateVariant();
        })();
        </script>
    }
}
