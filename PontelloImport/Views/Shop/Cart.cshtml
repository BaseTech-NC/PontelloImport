@model PontelloImport.Models.Cart?

@{
    ViewData["Title"] = "Cart";
    var items = Model?.CartItems?.ToList() ?? new List<PontelloImport.Models.CartItem>();
    var subtotal = items.Sum(ci => ci.Quantity * (ci.ProductVariant?.Price ?? 0m));
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="mb-0">Your Cart</h2>
    <a asp-action="Index" class="btn btn-outline-secondary">
        &larr; Continue Shopping
    </a>
</div>

@if (!items.Any())
{
    <div class="alert alert-info">
        Your cart is empty. <a asp-action="Index">Browse products</a> to get started.
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table align-middle">
            <thead class="table-light">
                <tr>
                    <th>Product</th>
                    <th>Variant / SKU</th>
                    <th class="text-end">Unit Price</th>
                    <th class="text-center" style="width: 160px;">Quantity</th>
                    <th class="text-end">Line Total</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in items)
                {
                    var variant = item.ProductVariant;
                    var product = variant?.Product;
                    var lineTotal = item.Quantity * (variant?.Price ?? 0m);

                    var variantLabel = BuildVariantLabel(variant);

                    <tr>
                        <td>
                            @if (product != null)
                            {
                                <a asp-action="Product" asp-route-id="@product.ProductID"
                                   class="text-decoration-none fw-semibold">
                                    @product.Title
                                </a>
                            }
                            else
                            {
                                <span class="text-muted">Unknown product</span>
                            }
                        </td>
                        <td>
                            <span class="d-block">@variantLabel</span>
                            <span class="text-muted small">SKU: @(variant?.SKU ?? "—")</span>
                        </td>
                        <td class="text-end">$@(variant?.Price.ToString("F2") ?? "0.00")</td>
                        <td class="text-center">
                            <form asp-action="UpdateCart" method="post" class="d-flex align-items-center gap-1 justify-content-center">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="cartItemId" value="@item.CartItemID" />
                                <input type="number" name="quantity" value="@item.Quantity"
                                       min="0" class="form-control form-control-sm text-center"
                                       style="width: 65px;" />
                                <button type="submit" class="btn btn-sm btn-outline-secondary">Update</button>
                            </form>
                        </td>
                        <td class="text-end fw-semibold">$@lineTotal.ToString("F2")</td>
                        <td class="text-end">
                            <form asp-action="RemoveFromCart" method="post">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="cartItemId" value="@item.CartItemID" />
                                <button type="submit" class="btn btn-sm btn-outline-danger"
                                        onclick="return confirm('Remove this item?')">Remove</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
            <tfoot>
                <tr>
                    <td colspan="4" class="text-end fw-bold fs-5">Subtotal</td>
                    <td class="text-end fw-bold fs-5">$@subtotal.ToString("F2")</td>
                    <td></td>
                </tr>
            </tfoot>
        </table>
    </div>

    <div class="d-flex justify-content-between align-items-center mt-3">
        <a asp-action="Index" class="btn btn-outline-secondary">&larr; Continue Shopping</a>
        <a asp-controller="Shop" asp-action="Checkout" class="btn btn-success btn-lg">
            Proceed to Checkout &rarr;
        </a>
    </div>
}

@functions {
    string BuildVariantLabel(PontelloImport.Models.ProductVariant? v)
    {
        if (v == null) return "—";
        var parts = new List<string>();
        if (!string.IsNullOrWhiteSpace(v.Option1Value)) parts.Add(v.Option1Value!);
        if (!string.IsNullOrWhiteSpace(v.Option2Value)) parts.Add(v.Option2Value!);
        if (!string.IsNullOrWhiteSpace(v.Option3Value)) parts.Add(v.Option3Value!);
        if (!string.IsNullOrWhiteSpace(v.Option4Value)) parts.Add(v.Option4Value!);
        if (!string.IsNullOrWhiteSpace(v.Option5Value)) parts.Add(v.Option5Value!);
        return parts.Any() ? string.Join(" / ", parts) : v.SKU;
    }
}
