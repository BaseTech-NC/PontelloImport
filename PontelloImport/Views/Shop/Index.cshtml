@model List<PontelloImport.Models.Product>

@{
    ViewData["Title"] = "Shop";
    var categories = ViewBag.Categories as List<PontelloImport.Models.ProductCategory> ?? new();
    string? currentSearch = ViewBag.Search as string;
    int? currentCategoryId = ViewBag.CategoryId as int?;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="mb-0">Product Catalog</h2>
    <a asp-controller="Shop" asp-action="Cart" class="btn btn-outline-dark">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="currentColor" class="bi bi-cart3 me-1" viewBox="0 0 16 16">
            <path d="M0 1.5A.5.5 0 0 1 .5 1H2a.5.5 0 0 1 .485.379L2.89 3H14.5a.5.5 0 0 1 .491.592l-1.5 8A.5.5 0 0 1 13 12H4a.5.5 0 0 1-.491-.408L2.01 3.607 1.61 2H.5a.5.5 0 0 1-.5-.5M3.102 4l1.313 7h8.17l1.313-7zM5 12a2 2 0 1 0 0 4 2 2 0 0 0 0-4m7 0a2 2 0 1 0 0 4 2 2 0 0 0 0-4m-7 1a1 1 0 1 1 0 2 1 1 0 0 1 0-2m7 0a1 1 0 1 1 0 2 1 1 0 0 1 0-2"/>
        </svg>
        View Cart
    </a>
</div>

<form method="get" asp-action="Index" class="mb-4">
    <div class="row g-2">
        <div class="col-md-5">
            <input type="text" name="search" class="form-control" placeholder="Search products..." value="@currentSearch" />
        </div>
        <div class="col-md-4">
            <select name="categoryId" class="form-select">
                <option value="">All Categories</option>
                @foreach (var cat in categories)
                {
                    <option value="@cat.CategoryID" selected="@(currentCategoryId == cat.CategoryID)">
                        @cat.CategoryName
                    </option>
                }
            </select>
        </div>
        <div class="col-md-2">
            <button type="submit" class="btn btn-primary w-100">Filter</button>
        </div>
        @if (!string.IsNullOrEmpty(currentSearch) || currentCategoryId.HasValue)
        {
            <div class="col-md-1">
                <a asp-action="Index" class="btn btn-outline-secondary w-100">Clear</a>
            </div>
        }
    </div>
</form>

@if (!Model.Any())
{
    <div class="alert alert-info">No products found matching your criteria.</div>
}
else
{
    <div class="row row-cols-1 row-cols-md-3 g-4">
        @foreach (var product in Model)
        {
            var prices = product.ProductVariants.Select(v => v.Price).ToList();
            var minPrice = prices.Any() ? prices.Min() : 0m;
            var maxPrice = prices.Any() ? prices.Max() : 0m;
            var variantCount = product.ProductVariants.Count;

            <div class="col">
                <div class="card h-100 shadow-sm">
                    <div class="card-body d-flex flex-column">
                        <h5 class="card-title">@product.Title</h5>
                        <p class="text-muted small mb-1">
                            <strong>Vendor:</strong> @(product.Vendor?.VendorName ?? "—")
                        </p>
                        <p class="text-muted small mb-2">
                            <strong>Category:</strong> @(product.ProductCategory?.CategoryName ?? "—")
                        </p>
                        <div class="mt-auto">
                            <p class="fw-semibold text-dark mb-3">
                                @if (variantCount == 1 || minPrice == maxPrice)
                                {
                                    @($"${minPrice:F2}")
                                }
                                else
                                {
                                    @($"${minPrice:F2} – ${maxPrice:F2}")
                                }
                                @if (variantCount > 1)
                                {
                                    <span class="text-muted fw-normal small ms-1">(@variantCount variants)</span>
                                }
                            </p>
                            <a asp-action="Product" asp-route-id="@product.ProductID"
                               class="btn btn-primary w-100">View Product</a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>

    <p class="text-muted mt-3">Showing @Model.Count product@(Model.Count == 1 ? "" : "s")</p>
}
