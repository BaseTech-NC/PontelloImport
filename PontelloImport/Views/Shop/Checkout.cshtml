@model PontelloImport.Models.Cart

@{
    ViewData["Title"] = "Checkout";
    var dealer = ViewBag.Dealer as PontelloImport.Models.Dealer;
    var allAddr = ViewBag.AllAddresses as List<PontelloImport.Models.Address>
                  ?? new List<PontelloImport.Models.Address>();
    var billingAddresses = ViewBag.BillingAddresses as List<PontelloImport.Models.Address>
                           ?? new List<PontelloImport.Models.Address>();
    var shippingAddresses = ViewBag.ShippingAddresses as List<PontelloImport.Models.Address>
                            ?? new List<PontelloImport.Models.Address>();
    // Fallback: typed filter may be empty if all addresses are a type not yet used
    if (!billingAddresses.Any() && allAddr.Any()) billingAddresses = allAddr;
    if (!shippingAddresses.Any() && allAddr.Any()) shippingAddresses = allAddr;
    var defaultId = (int?)ViewBag.DefaultAddressId;
    var items = Model.CartItems.ToList();
    var subtotal = items.Sum(ci => ci.Quantity * (ci.ProductVariant?.Price ?? 0m));
    var isTaxExempt = dealer?.IsTaxExempt ?? false;
    var taxAmount = isTaxExempt ? (decimal?)null : Math.Round(subtotal * 0.13m, 2);
    var total = subtotal + (taxAmount ?? 0);
}

<nav aria-label="breadcrumb" class="mb-3">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-action="Index">Shop</a></li>
        <li class="breadcrumb-item"><a asp-action="Cart">Cart</a></li>
        <li class="breadcrumb-item active">Checkout</li>
    </ol>
</nav>

<h1 class="mb-4 h2">Review Your Order</h1>

<div class="row g-4">
    <div class="col-lg-8">
        <div class="pi-card mb-4" style="padding:0;">
            <div style="padding:14px 16px 8px 16px;font-size:11px;font-weight:500;letter-spacing:0.5px;text-transform:uppercase;color:var(--pi-text-2);border-bottom:1px solid var(--pi-border);">Order Items</div>
            <div style="padding:0;">
                <table class="pi-table" style="margin-bottom:0;">
                    <thead>
                        <tr>
                            <th>Product</th>
                            <th>Variant / SKU</th>
                            <th class="text-center">Qty</th>
                            <th class="text-end">Unit Price</th>
                            <th class="text-end">Line Total</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in items)
                        {
                            var v = item.ProductVariant;
                            var lineTotal = item.Quantity * (v?.Price ?? 0m);
                            var optValues = new[] { v?.Option1Value, v?.Option2Value, v?.Option3Value, v?.Option4Value, v?.Option5Value }
                                .Where(o => !string.IsNullOrWhiteSpace(o) &&
                                            !string.Equals(o, "Default Title", StringComparison.OrdinalIgnoreCase) &&
                                            !string.Equals(o, "Title", StringComparison.OrdinalIgnoreCase));
                            var variantLabel = optValues.Any() ? string.Join(" / ", optValues) : "";

                            <tr>
                                <td class="fw-semibold">@(v?.Product?.Title ?? "—")</td>
                                <td>
                                    @if (!string.IsNullOrEmpty(variantLabel))
                                    {
                                        <span class="d-block">@variantLabel</span>
                                    }
                                    <span class="text-muted small">SKU: @(v?.SKU ?? "—")</span>
                                </td>
                                <td class="text-center">@item.Quantity</td>
                                <td class="text-end">$@(v?.Price.ToString("F2") ?? "0.00")</td>
                                <td class="text-end fw-semibold">$@lineTotal.ToString("F2")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        @if (dealer != null)
        {
            <div class="pi-card">
                <div class="pi-section-label">Billing Information</div>
                    <p class="mb-2 fw-semibold">@dealer.CompanyName</p>
                    <p class="mb-0">
                        <strong>Payment Terms:</strong>
                        @(dealer.PaymentTerms?.TermName ?? "—")
                        @if (dealer.IsTaxExempt)
                        {
                            <span class="pi-badge pi-badge-confirmed ms-2">Tax Exempt</span>
                        }
                    </p>
            </div>
        }

        @* Address selection *@
        <div class="pi-card mt-3">
            <div class="pi-section-label">Addresses</div>
                @if (allAddr.Any())
                {
                    <div class="mb-3">
                        <label for="BillingAddressId" class="form-label fw-semibold" style="font-size:0.875rem;">
                            Billing Address
                        </label>
                        <select id="BillingAddressId" name="BillingAddressId" class="form-select form-select-sm">
                            @foreach (var a in billingAddresses)
                            {
                                <option value="@a.AddressID"
                                        selected="@(a.AddressID == defaultId ? "selected" : null)">
                                    @a.Street, @a.City @a.Province @a.PostalCode
                                </option>
                            }
                        </select>
                    </div>

                    <div class="mb-2">
                        <div class="form-check">
                            <input type="checkbox" id="sameAddr" class="form-check-input"
                                   checked onchange="toggleShippingAddr(this)" />
                            <label for="sameAddr" class="form-check-label"
                                   style="font-size:13px;">
                                Shipping address same as billing
                            </label>
                        </div>
                    </div>

                    <div id="shippingAddrSection" style="display:none;">
                        @if (shippingAddresses.Any())
                        {
                            <label for="ShippingAddressId" class="form-label fw-semibold" style="font-size:0.875rem;">
                                Shipping Address
                            </label>
                            <select id="ShippingAddressId" name="ShippingAddressId" class="form-select form-select-sm">
                                @foreach (var a in shippingAddresses)
                                {
                                    <option value="@a.AddressID">
                                        @a.Street, @a.City @a.Province @a.PostalCode
                                    </option>
                                }
                            </select>
                        }
                        else
                        {
                            <div class="pi-notice pi-notice-info">
                                No shipping address on file.
                                <a href="/DealerAccount/ManageAccount" style="color:var(--pi-info);">
                                    Add one in Manage Account
                                </a>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="pi-notice pi-notice-warning">
                        No addresses on file.
                        <a href="/DealerAccount/ManageAccount"
                           style="color:var(--pi-warning);font-weight:500;">
                            Add an address before checking out
                        </a>
                    </div>
                }

                <div style="margin-top:10px;">
                    <button type="button"
                            class="pi-btn pi-btn-ghost pi-btn-sm"
                            onclick="toggleNewAddress()"
                            id="addAddressToggle">
                        + Add a new address
                    </button>
                </div>

                <!-- Inline address form — hidden by default -->
                <div id="newAddressForm"
                     style="display:none;margin-top:16px;padding:16px;
                            background:var(--pi-bg-subtle);border-radius:var(--pi-radius);
                            border:1px solid var(--pi-border);">

                    <div style="font-size:12px;font-weight:600;color:var(--pi-text-1);
                                margin-bottom:12px;text-transform:uppercase;letter-spacing:0.5px;">
                        Add New Address
                    </div>

                    <form id="inlineAddressForm">
                        @Html.AntiForgeryToken()
                        <div class="row g-2">
                            <div class="col-12">
                                <label class="form-label">Street Address <span style="color:var(--pi-danger);">*</span></label>
                                <input type="text" id="newStreet" class="form-control form-control-sm"
                                       placeholder="88 Speedway Drive" required>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">City</label>
                                <input type="text" id="newCity" class="form-control form-control-sm" placeholder="Toronto">
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Province / State</label>
                                <input type="text" id="newProvince" class="form-control form-control-sm" placeholder="ON">
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Postal / Zip Code</label>
                                <input type="text" id="newPostal" class="form-control form-control-sm"
                                       placeholder="M5V 1A1" maxlength="10">
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Country</label>
                                <input type="text" id="newCountry" class="form-control form-control-sm" value="Canada">
                            </div>
                            <div class="col-12">
                                <label class="form-label">Address Type</label>
                                <select id="newAddressType" class="form-select form-select-sm">
                                    <option value="Both">Billing &amp; Shipping</option>
                                    <option value="Billing">Billing only</option>
                                    <option value="Shipping">Shipping only</option>
                                </select>
                            </div>
                            <div class="col-12">
                                <div class="form-check">
                                    <input type="checkbox" id="newIsDefault" class="form-check-input">
                                    <label for="newIsDefault" class="form-check-label" style="font-size:13px;">
                                        Set as default address
                                    </label>
                                </div>
                            </div>
                            <div class="col-12" style="display:flex;gap:8px;margin-top:4px;">
                                <button type="button" class="pi-btn pi-btn-primary pi-btn-sm"
                                        onclick="saveNewAddress()">
                                    Save Address
                                </button>
                                <button type="button" class="pi-btn pi-btn-ghost pi-btn-sm"
                                        onclick="toggleNewAddress()">
                                    Cancel
                                </button>
                            </div>
                            <div id="addressSaveError" style="display:none;"
                                 class="pi-notice pi-notice-danger col-12">
                                Failed to save address. Please check the fields and try again.
                            </div>
                        </div>
                    </form>
                </div>
        </div>
    </div>

    <div class="col-lg-4">
        <div class="pi-card">
            <div class="pi-section-label">Order Summary</div>
                <table class="pi-table" style="margin-bottom:0;border:none;">
                    <tr>
                        <td>Subtotal</td>
                        <td class="text-end">$@subtotal.ToString("F2")</td>
                    </tr>
                    @if (isTaxExempt)
                    {
                        <tr>
                            <td>Tax</td>
                            <td class="text-end text-muted">Tax Exempt</td>
                        </tr>
                    }
                    else
                    {
                        <tr>
                            <td>Tax (13%)</td>
                            <td class="text-end">$@taxAmount!.Value.ToString("F2")</td>
                        </tr>
                    }
                    <tr class="border-top">
                        <th>Total</th>
                        <th class="text-end fs-5">$@total.ToString("F2")</th>
                    </tr>
                </table>

                <div class="pi-notice pi-notice-info mt-3 mb-3" style="font-size:0.82rem;">
                    <strong>What happens next?</strong>
                    <ul class="mb-0 mt-1 ps-3">
                        <li>Pontello Imports will review and confirm your order.</li>
                        <li>You'll be notified of any changes before shipment.</li>
                        <li>Shipping cost is added once the order ships.</li>
                    </ul>
                </div>

                <div class="pi-notice pi-notice-info" style="margin-bottom:16px;">
                    <div>
                        <strong style="display:block;margin-bottom:3px;">Please note</strong>
                        Pontello Imports may adjust your order if there are any stock or pricing changes.
                        You will be notified of any modifications before your order is confirmed.
                    </div>
                </div>
                <form asp-action="SubmitOrder" method="post">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="pi-btn pi-btn-primary pi-btn-lg w-100">
                        Confirm and Submit Order
                    </button>
                </form>

                <div class="text-center mt-2">
                    <a asp-action="Cart" class="text-muted small text-decoration-none">&larr; Back to Cart</a>
                </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
    function toggleShippingAddr(cb) {
        document.getElementById('shippingAddrSection').style.display =
            cb.checked ? 'none' : 'block';
    }

    function toggleNewAddress() {
        const form = document.getElementById('newAddressForm');
        const btn  = document.getElementById('addAddressToggle');
        const isHidden = form.style.display === 'none';
        form.style.display = isHidden ? 'block' : 'none';
        btn.textContent   = isHidden ? '− Cancel' : '+ Add a new address';
    }

    async function saveNewAddress() {
        const street      = document.getElementById('newStreet').value.trim();
        const city        = document.getElementById('newCity').value.trim();
        const province    = document.getElementById('newProvince').value.trim();
        const postal      = document.getElementById('newPostal').value.trim();
        const country     = document.getElementById('newCountry').value.trim();
        const addressType = document.getElementById('newAddressType').value;
        const isDefault   = document.getElementById('newIsDefault').checked;
        const token       = document.querySelector('[name=__RequestVerificationToken]')?.value ?? '';

        if (!street) { alert('Street address is required.'); return; }

        const errEl = document.getElementById('addressSaveError');
        errEl.style.display = 'none';

        try {
            const res = await fetch('/DealerAccount/AddAddressJson', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': token
                },
                body: JSON.stringify({ street, city, provinceState: province,
                    postalZipCode: postal, country: country || 'Canada',
                    addressType, isDefault })
            });

            if (!res.ok) throw new Error();
            const data = await res.json();
            if (!data.success) throw new Error(data.message);

            addAddressToDropdowns(data.addressId,
                `${street}, ${city} ${postal}`, addressType, isDefault);

            toggleNewAddress();
            document.getElementById('newStreet').value   = '';
            document.getElementById('newCity').value     = '';
            document.getElementById('newProvince').value = '';
            document.getElementById('newPostal').value   = '';
            document.getElementById('newIsDefault').checked = false;
        } catch {
            errEl.style.display = 'flex';
        }
    }

    function addAddressToDropdowns(id, label, type, isDefault) {
        if (type === 'Billing' || type === 'Both') {
            const sel = document.querySelector('[name=BillingAddressId]');
            if (sel) {
                sel.add(new Option(label, id));
                if (isDefault) sel.value = id;
            }
        }
        if (type === 'Shipping' || type === 'Both') {
            const sel = document.querySelector('[name=ShippingAddressId]');
            if (sel) {
                sel.add(new Option(label, id));
                if (isDefault) sel.value = id;
            }
        }
    }
    </script>
}
