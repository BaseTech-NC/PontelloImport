@model PontelloImport.ViewModels.DealerApplicationViewModel
@{
    ViewData["Title"] = "Become a Dealer — Pontello Imports";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="row justify-content-center mt-4 mb-5">
    <div class="col-lg-7 col-md-9">

        <div class="mb-4">
            <h1 style="font-size:1.5rem; font-weight:700; color:#0D3D38;">Apply for Dealer Access</h1>
            <p class="text-muted" style="font-size:0.95rem;">
                Fill out the form below and Pontello Imports will review your application.
                You'll be contacted within 2 business days.
            </p>
        </div>

        <div class="card shadow-sm" style="border:1px solid #E5E7EB; border-radius:12px;">
            <div class="card-body p-4">

                <form asp-action="Apply" method="post">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 mb-3" role="alert"></div>

                    <h6 class="fw-semibold text-muted text-uppercase mb-3" style="font-size:0.72rem; letter-spacing:0.08em;">
                        Contact Information
                    </h6>
                    <div class="row g-3 mb-4">
                        <div class="col-sm-6">
                            <label asp-for="FirstName" class="form-label small fw-semibold">
                                First Name <span class="text-danger">*</span>
                            </label>
                            <input asp-for="FirstName" class="form-control" style="border-radius:8px;"
                                   oninput="validateName(this,'err-firstname')" />
                            <span asp-validation-for="FirstName" class="text-danger small"></span>
                            <span id="err-firstname" class="text-danger small" style="display:none;"></span>
                        </div>
                        <div class="col-sm-6">
                            <label asp-for="LastName" class="form-label small fw-semibold">
                                Last Name <span class="text-danger">*</span>
                            </label>
                            <input asp-for="LastName" class="form-control" style="border-radius:8px;"
                                   oninput="validateName(this,'err-lastname')" />
                            <span asp-validation-for="LastName" class="text-danger small"></span>
                            <span id="err-lastname" class="text-danger small" style="display:none;"></span>
                        </div>
                        <div class="col-sm-6">
                            <label asp-for="Email" class="form-label small fw-semibold">
                                Email Address <span class="text-danger">*</span>
                            </label>
                            <input asp-for="Email" class="form-control" style="border-radius:8px;"
                                   placeholder="you@yourcompany.com"
                                   oninput="validateEmail(this)" />
                            <span asp-validation-for="Email" class="text-danger small"></span>
                            <span id="err-email" class="text-danger small" style="display:none;"></span>
                        </div>
                        <div class="col-sm-6">
                            <label asp-for="Phone" class="form-label small fw-semibold">
                                Phone Number <span class="text-danger">*</span>
                            </label>
                            <input asp-for="Phone" class="form-control" style="border-radius:8px;"
                                   placeholder="e.g. 647-964-6833"
                                   oninput="validatePhone(this)" />
                            <span asp-validation-for="Phone" class="text-danger small"></span>
                            <span id="err-phone" class="text-danger small" style="display:none;"></span>
                        </div>
                    </div>

                    <h6 class="fw-semibold text-muted text-uppercase mb-3" style="font-size:0.72rem; letter-spacing:0.08em;">
                        Business Information
                    </h6>
                    <div class="row g-3 mb-4">
                        <div class="col-12">
                            <label asp-for="Company" class="form-label small fw-semibold"></label>
                            <input asp-for="Company" class="form-control" style="border-radius:8px;"
                                   placeholder="Acme Karting Ltd." />
                            <span asp-validation-for="Company" class="text-danger small"></span>
                        </div>
                        <div class="col-12">
                            <label asp-for="Address" class="form-label small fw-semibold"></label>
                            <input asp-for="Address" class="form-control" style="border-radius:8px;"
                                   placeholder="123 Racing Blvd" />
                            <span asp-validation-for="Address" class="text-danger small"></span>
                        </div>
                        <div class="col-sm-5">
                            <label asp-for="City" class="form-label small fw-semibold"></label>
                            <input asp-for="City" class="form-control" style="border-radius:8px;" />
                            <span asp-validation-for="City" class="text-danger small"></span>
                        </div>
                        <div class="col-sm-4">
                            <label asp-for="ProvinceState" class="form-label small fw-semibold"></label>
                            <select asp-for="ProvinceState" class="form-select" style="border-radius:8px;">
                                <option value="">— Select —</option>
                                <option value="AB">Alberta</option>
                                <option value="BC">British Columbia</option>
                                <option value="MB">Manitoba</option>
                                <option value="NB">New Brunswick</option>
                                <option value="NL">Newfoundland &amp; Labrador</option>
                                <option value="NS">Nova Scotia</option>
                                <option value="ON">Ontario</option>
                                <option value="PE">Prince Edward Island</option>
                                <option value="QC">Quebec</option>
                                <option value="SK">Saskatchewan</option>
                                <option value="NT">Northwest Territories</option>
                                <option value="NU">Nunavut</option>
                                <option value="YT">Yukon</option>
                                <option disabled>──────</option>
                                <option value="AL">Alabama</option>
                                <option value="AK">Alaska</option>
                                <option value="AZ">Arizona</option>
                                <option value="CA">California</option>
                                <option value="CO">Colorado</option>
                                <option value="FL">Florida</option>
                                <option value="GA">Georgia</option>
                                <option value="IL">Illinois</option>
                                <option value="MI">Michigan</option>
                                <option value="MN">Minnesota</option>
                                <option value="NY">New York</option>
                                <option value="OH">Ohio</option>
                                <option value="PA">Pennsylvania</option>
                                <option value="TX">Texas</option>
                                <option value="WA">Washington</option>
                                <option value="Other">Other</option>
                            </select>
                            <span asp-validation-for="ProvinceState" class="text-danger small"></span>
                        </div>
                        <div class="col-sm-3">
                            <label asp-for="PostalZipCode" class="form-label small fw-semibold"></label>
                            <input asp-for="PostalZipCode" class="form-control" style="border-radius:8px;"
                                   placeholder="A1B 2C3"
                                   oninput="validatePostal(this)" />
                            <span asp-validation-for="PostalZipCode" class="text-danger small"></span>
                            <span id="err-postal" class="text-danger small" style="display:none;"></span>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="CompanyDescription" class="form-label small fw-semibold"></label>
                        <textarea asp-for="CompanyDescription" class="form-control" rows="3" style="border-radius:8px;"
                                  placeholder="Tell us about your business, product lines of interest, or anything else relevant."></textarea>
                        <span asp-validation-for="CompanyDescription" class="text-danger small"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="WebsiteSocialMedia" class="form-label small fw-semibold"></label>
                        <input asp-for="WebsiteSocialMedia" class="form-control" style="border-radius:8px;"
                               placeholder="https://yoursite.com or @@yourhandle" />
                        <span asp-validation-for="WebsiteSocialMedia" class="text-danger small"></span>
                    </div>

                    <button type="submit" class="btn fw-semibold w-100"
                            style="background:#0D3D38; color:#ffffff; border-radius:8px; padding:0.7rem;">
                        Submit Application
                    </button>
                </form>

                <div class="text-center mt-3" style="font-size:0.8rem; color:#9CA3AF;">
                    Questions? 647-964-6833 or jesse@pontelloimports.com
                </div>

            </div>
        </div>

        <div class="text-center mt-3" style="font-size:0.875rem; color:#6B7280;">
            Already have an account?
            <a asp-area="Identity" asp-page="/Account/Login" style="color:#028090; font-weight:500;">Sign In</a>
        </div>

    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function setFieldState(el, errId, ok, msg) {
            el.style.borderColor = ok ? '' : '#dc2626';
            var span = document.getElementById(errId);
            if (!span) return;
            if (ok || el.value.trim() === '') {
                span.style.display = 'none';
                span.textContent = '';
            } else {
                span.textContent = msg;
                span.style.display = 'inline';
            }
        }

        function validateName(el, errId) {
            var v = el.value.trim();
            var ok = v === '' || /^[A-Za-z\s\-']{2,}$/.test(v);
            setFieldState(el, errId, ok, 'Please enter a valid name (letters only, at least 2 characters).');
        }

        function validateEmail(el) {
            var v = el.value.trim();
            var ok = v === '' || /^[^\s@@]+@@[^\s@@]+\.[^\s@@]+$/.test(v);
            setFieldState(el, 'err-email', ok, 'Please enter a valid email address.');
        }

        function validatePhone(el) {
            var v = el.value.trim();
            if (v === '') { setFieldState(el, 'err-phone', true, ''); return; }
            var fmt = /^[\d\s\-\(\)\+]{7,20}$/.test(v);
            var digits = (v.match(/\d/g) || []).length;
            var ok = fmt && digits >= 10;
            setFieldState(el, 'err-phone', ok, 'Enter a valid phone number with at least 10 digits.');
        }

        function validatePostal(el) {
            var v = el.value.trim();
            var ok = v === '' || /^[A-Za-z0-9\s\-]{5,10}$/.test(v);
            setFieldState(el, 'err-postal', ok, 'Enter a valid postal/zip code (5–10 characters).');
        }
    </script>
}
