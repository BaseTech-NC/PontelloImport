@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Pontello Imports";
}

<div class="d-flex flex-column align-items-center justify-content-center" style="min-height: 80vh; padding: 2rem 1rem;">

    <!-- Logo + Title -->
    <div class="text-center mb-5">
        <img src="~/images/pontello-Imports-Logo.png" alt="Pontello Imports" style="height: 80px;" class="mb-3" />
        <p class="text-muted mb-0" style="font-size: 1.05rem; max-width: 480px;">
            Wholesale karting &amp; motorsports components — Canada &amp; United States
        </p>
    </div>

    <!-- Portal Cards -->
    <div class="row g-4 justify-content-center w-100" style="max-width: 820px;">

        <!-- Dealer Portal -->
        <div class="col-md-5">
            <div class="card h-100 shadow-sm border-0" style="border-top: 4px solid #0d6efd !important;">
                <div class="card-body d-flex flex-column p-4">
                    <div class="mb-3">
                        <span class="badge bg-primary bg-opacity-10 text-primary fw-semibold px-3 py-2" style="font-size: 0.75rem; letter-spacing: 0.05em;">DEALER PORTAL</span>
                    </div>
                    <h4 class="card-title fw-bold mb-2">Dealer Portal</h4>
                    <p class="card-text text-muted mb-4 flex-grow-1">
                        Browse products, manage your cart, and submit orders.
                    </p>
                    <a href="/Home/EnterDealerPortal" class="btn btn-primary btn-lg w-100">
                        Enter Dealer Portal
                    </a>
                </div>
            </div>
        </div>

        <!-- Admin Panel -->
        <div class="col-md-5">
            <div class="card h-100 shadow-sm border-0" style="border-top: 4px solid #212529 !important;">
                <div class="card-body d-flex flex-column p-4">
                    <div class="mb-3">
                        <span class="badge bg-dark bg-opacity-10 text-dark fw-semibold px-3 py-2" style="font-size: 0.75rem; letter-spacing: 0.05em; background-color: #e9ecef !important;">ADMIN</span>
                    </div>
                    <h4 class="card-title fw-bold mb-2">Pontello Admin</h4>
                    <p class="card-text text-muted mb-4 flex-grow-1">
                        Manage products, process orders, and oversee dealer activity.
                    </p>
                    <a href="/Home/EnterAdminPortal" class="btn btn-dark btn-lg w-100">
                        Enter Admin Panel
                    </a>
                </div>
            </div>
        </div>

    </div>

</div>
