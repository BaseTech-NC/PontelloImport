@{
    Layout = null;
    ViewData["Title"] = "Pontello Imports - Home";
    }

<!doctype html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Pontello Imports - Dealer Portal</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", "Arial", sans-serif;
            line-height: 1.6;
            color: #333;
            background-color: #f5f5f5;
        }

        /* Header Styles */
        .header {
            background-color: #a8b5c6;
            padding: 1rem 0;
            box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
        }

        .header-content {
            max-width: 1200px;
            margin: 0 auto;
            padding: 0 2rem;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .logo {
            height: 50px;
            display: flex;
            align-items: center;
        }

            .logo img {
                height: 100%;
                width: auto;
                max-height: 60px;
            }

        .logo-text {
            font-size: 1.5rem;
            font-weight: 700;
            color: #1a1a1a;
        }

        /* Navigation */
        nav ul {
            list-style: none;
            display: flex;
            gap: 2.5rem;
            align-items: center;
        }

        nav a {
            color: #000;
            text-decoration: none;
            font-size: 0.95rem;
            font-weight: 500;
            transition: all 0.3s ease;
            letter-spacing: 0.3px;
            padding-bottom: 4px;
        }

            nav a:hover {
                color: #1a1a1a;
                border-bottom: 2px solid #000;
            }

            nav a.active {
                color: #000;
                border-bottom: 2px solid #000;
            }

            nav a.admin-link {
                background: #28a745;
                color: white;
                padding: 0.5rem 1.25rem;
                border-radius: 6px;
                border-bottom: none;
            }

                nav a.admin-link:hover {
                    background: #218838;
                    border-bottom: none;
                }

        /* Welcome Section */
        .welcome-section {
            background: linear-gradient(135deg, #ffffff 0%, #f8f8f8 100%);
            padding: 4rem 2rem;
            text-align: center;
            border-bottom: 1px solid #e0e0e0;
        }

        .welcome-content {
            max-width: 800px;
            margin: 0 auto;
        }

        .welcome-section h1 {
            font-size: 2.2rem;
            font-weight: 600;
            margin-bottom: 1rem;
            color: #1a1a1a;
            letter-spacing: -0.5px;
        }

        .welcome-section p {
            font-size: 1.1rem;
            color: #666;
            line-height: 1.7;
            max-width: 700px;
            margin: 0 auto;
        }

        /* Quick Access Grid */
        .quick-access {
            max-width: 1200px;
            margin: 0 auto;
            padding: 3rem 2rem;
        }

        .section-title {
            font-size: 1.5rem;
            font-weight: 600;
            color: #1a1a1a;
            margin-bottom: 2rem;
            text-align: center;
        }

        .cards-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
            gap: 1.5rem;
        }

        .card {
            background-color: #ffffff;
            border: 1px solid #e0e0e0;
            border-radius: 8px;
            padding: 2rem 1.5rem;
            text-align: center;
            transition: all 0.3s ease;
            cursor: default;
        }

            .card:hover {
                transform: translateY(-4px);
                box-shadow: 0 8px 16px rgba(0, 0, 0, 0.1);
                border-color: #a8b5c6;
            }

        .card-icon {
            font-size: 2.5rem;
            margin-bottom: 1rem;
            display: block;
        }

        .card h3 {
            font-size: 1.2rem;
            font-weight: 600;
            margin-bottom: 0.75rem;
            color: #1a1a1a;
        }

        .card p {
            font-size: 0.95rem;
            color: #666;
            line-height: 1.5;
        }

        /* Footer */
        .footer {
            background-color: #a8b5c6;
            color: #000;
            padding: 2.5rem 2rem;
            margin-top: 3rem;
        }

        .footer-content {
            max-width: 1200px;
            margin: 0 auto;
            text-align: center;
        }

        .footer-info {
            margin-bottom: 1rem;
        }

            .footer-info p {
                font-size: 0.9rem;
                color: #000;
                margin-bottom: 0.5rem;
            }

        .footer-links {
            margin-top: 1.5rem;
            padding-top: 1.5rem;
            border-top: 1px solid #000;
        }

            .footer-links a {
                color: #000;
                text-decoration: none;
                margin: 0 1rem;
                font-size: 0.85rem;
                transition: color 0.3s ease;
            }

                .footer-links a:hover {
                    border-bottom: 2px solid #000;
                }

        /* Responsive Design */
        @@media (max-width: 768px) {
            .header-content {
                flex-direction: column;
                gap: 1rem;
            }

            nav ul {
                gap: 1.5rem;
            }

            .welcome-section h1 {
                font-size: 1.8rem;
            }

            .welcome-section p {
                font-size: 1rem;
            }

            .cards-grid {
                grid-template-columns: 1fr;
            }

            .footer-links a {
                display: block;
                margin: 0.5rem 0;
            }
        }

        @@media (max-width: 480px) {
            nav ul {
                flex-wrap: wrap;
                gap: 1rem;
                justify-content: center;
            }
        }
    </style>
</head>
<body>
    <!-- Header -->
    <header class="header">
        <div class="header-content">
            <div class="logo">
                <!-- OPTION 1: If you have logo image, use this: -->
                <img src="~/images/pontello-Imports-Logo.png" alt="Pontello Imports Logo" />
                
                @* <div class="logo-text">PONTELLO IMPORTS</div> *@
            </div>
            <nav>
                <ul>
                    <li><a href="/" class="active">Home</a></li>
                    <li><a href="#dealer">Dealer Portal</a></li>
                    <li><a href="@Url.Action("Index", "ProductVariants")" class="admin-link">Admin Panel</a></li>
                </ul>
            </nav>
        </div>
    </header>

    <!-- Welcome Section -->
    <section class="welcome-section">
        <div class="welcome-content">
            <h1>Welcome to Your Dealer Portal</h1>
            <p>
                Access premium karting and motorsports components from leading
                international manufacturers. Browse our complete catalog, place
                orders, and manage your account—all in one streamlined platform.
            </p>
        </div>
    </section>

    <!-- Quick Access Cards -->
    <section class="quick-access" id="dealer">
        <h2 class="section-title">Quick Access</h2>
        <div class="cards-grid">
            <div class="card">
                <span class="card-icon">📦</span>
                <h3>Browse Products</h3>
                <p>
                    View our complete catalog of chassis, tires, engines, and
                    accessories from top manufacturers.
                </p>
            </div>

            <div class="card">
                <span class="card-icon">📋</span>
                <h3>Order History</h3>
                <p>
                    Review past orders, track shipments, and access purchase order
                    documents anytime.
                </p>
            </div>

            <div class="card">
                <span class="card-icon">⚙️</span>
                <h3>Account Settings</h3>
                <p>
                    Update your dealer profile, manage addresses, and configure payment
                    terms.
                </p>
            </div>
        </div>
    </section>

    <!-- Footer -->
    <footer class="footer">
        <div class="footer-content">
            <div class="footer-info">
                <p>&copy; 2025-2026 Pontello Imports - BaseTech Team. All rights reserved.</p>
                <p>Niagara College - Capstone Project</p>
                <p>Email: info@pontelloimports.ca</p>
            </div>
            <div class="footer-links">
                <a href="#support">Support</a>
                <a href="#terms">Terms of Service</a>
                <a href="#privacy">Privacy Policy</a>
                <a href="#contact">Contact Us</a>
            </div>
        </div>
    </footer>
</body>
</html>