@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Pontello Imports — Dealer Portal";
    ViewData["LandingPage"] = true;
    ViewData["FullWidth"] = true;
    ViewData["HideFooter"] = true;
}

<!-- SECTION 1 — Hero -->
<section class="hero-section" style="padding:64px 0 0 0;">
    <div class="container">
        <div class="row align-items-center g-5">

            <!-- Left: copy + CTAs -->
            <div class="col-lg-7">
                <p style="font-size:0.75rem; font-weight:700; letter-spacing:0.12em; text-transform:uppercase;
                           color:var(--pi-emerald); margin-bottom:1.25rem;">
                    CANADA'S MOTORSPORTS PARTS IMPORTER
                </p>
                <h1 class="hero-headline"
                    style="color:#FFFFFF; font-size:clamp(36px,5vw,64px);
                           margin-bottom:0.6rem;">
                    Parts ordering, simplified.
                </h1>
                <p style="font-family:'DM Sans',sans-serif; font-size:18px; font-weight:400;
                           color:rgba(255,255,255,0.80); line-height:1.6; margin-top:12px;
                           max-width:480px; margin-bottom:0;">
                    Your pit lane to Pontello Imports.
                </p>
                <div style="display:flex; gap:14px; flex-wrap:wrap;
                            margin-top:32px; padding-bottom:64px;">
                    <a asp-area="Identity" asp-page="/Account/Login"
                       style="background:#59B7FF; color:#000000; border:none; font-family:'DM Sans',sans-serif;
                              font-weight:600; font-size:12px; letter-spacing:1.5px; text-transform:uppercase;
                              padding:14px 28px; border-radius:5px; cursor:pointer; transition:opacity 0.15s;
                              text-decoration:none; display:inline-flex; align-items:center;"
                       onmouseover="this.style.opacity='0.85'" onmouseout="this.style.opacity='1'">
                        Sign In to Your Account
                    </a>
                    <a asp-controller="Home" asp-action="Apply"
                       style="background:#55DA7D; color:#000000; border:none; font-family:'DM Sans',sans-serif;
                              font-weight:600; font-size:12px; letter-spacing:1.5px; text-transform:uppercase;
                              padding:14px 28px; border-radius:5px; cursor:pointer; transition:opacity 0.15s;
                              text-decoration:none; display:inline-flex; align-items:center;"
                       onmouseover="this.style.opacity='0.85'" onmouseout="this.style.opacity='1'">
                        Open a Dealer Account
                    </a>
                </div>
            </div>

            <!-- Right: decorative order snapshot card -->
            <div class="col-lg-5">
                <div style="background:rgba(255,255,255,0.05); border:1px solid rgba(255,255,255,0.12);
                            border-radius:12px; padding:1.75rem; color:#ffffff;">
                    <div style="font-size:0.75rem; font-weight:600; letter-spacing:0.08em;
                                text-transform:uppercase; color:var(--pi-emerald); margin-bottom:0.85rem;">
                        Order #0042 — Confirmed
                    </div>
                    <div style="font-family:'Courier New', monospace; font-size:0.875rem; line-height:2;
                                color:rgba(255,255,255,0.85); border-bottom:1px solid rgba(255,255,255,0.1);
                                padding-bottom:1rem; margin-bottom:1rem;">
                        <div class="d-flex justify-content-between">
                            <span>CRG Helmet Pro &times; 2</span><span>$359.98</span>
                        </div>
                        <div class="d-flex justify-content-between">
                            <span>OTK Front Axle &times; 1</span><span>$89.99</span>
                        </div>
                        <div class="d-flex justify-content-between"
                             style="color:rgba(255,255,255,0.85); font-size:0.8rem; margin-top:0.5rem;">
                            <span>Subtotal</span><span>$449.97 + HST</span>
                        </div>
                    </div>
                    <div style="font-size:0.78rem; color:rgba(255,255,255,0.85); margin-bottom:0.65rem;">
                        Order status
                    </div>
                    <div class="d-flex gap-2 flex-wrap align-items-center">
                        <span style="background:rgba(255,255,255,0.1); color:rgba(255,255,255,0.85);
                                     font-size:0.7rem; font-weight:600; padding:0.25rem 0.65rem;
                                     border-radius:20px; letter-spacing:0.04em;">Submitted</span>
                        <span style="color:rgba(255,255,255,0.85); font-size:0.75rem;">&rarr;</span>
                        <span style="background:var(--pi-nitro-blue); color:var(--pi-black);
                                     font-size:0.7rem; font-weight:600; padding:0.25rem 0.65rem;
                                     border-radius:20px; letter-spacing:0.04em;">Confirmed</span>
                        <span style="color:rgba(255,255,255,0.85); font-size:0.75rem;">&rarr;</span>
                        <span style="background:rgba(255,255,255,0.07); color:rgba(255,255,255,0.85);
                                     font-size:0.7rem; font-weight:600; padding:0.25rem 0.65rem;
                                     border-radius:20px; letter-spacing:0.04em;">Shipped</span>
                    </div>
                </div>
            </div>

        </div>
    </div>
</section>

<!-- SECTION 2 — Feature strip -->
<section style="background:#F8FAFC; padding:4rem 0;">
    <div class="container">
        <div class="row g-4 text-center">

            <div class="col-md-4">
                <div style="width:56px; height:56px; background:var(--pi-nitro-blue); border-radius:50%;
                            display:flex; align-items:center; justify-content:center;
                            font-size:1.5rem; margin:0 auto 1.25rem;">🛒</div>
                <h2 style="font-size:1.05rem; font-weight:700; font-family:var(--pi-font-head); color:var(--pi-text-1); margin-bottom:0.5rem;">Order Anytime</h2>
                <p style="color:var(--pi-text-2); font-size:0.9rem; line-height:1.6; max-width:280px; margin:0 auto;">
                    Browse the full catalog and submit purchase orders 24/7 — no phone calls required.
                </p>
            </div>

            <div class="col-md-4">
                <div style="width:56px; height:56px; background:var(--pi-nitro-blue); border-radius:50%;
                            display:flex; align-items:center; justify-content:center;
                            font-size:1.5rem; margin:0 auto 1.25rem;">📊</div>
                <h2 style="font-size:1.05rem; font-weight:700; font-family:var(--pi-font-head); color:var(--pi-text-1); margin-bottom:0.5rem;">Track Every Order</h2>
                <p style="color:var(--pi-text-2); font-size:0.9rem; line-height:1.6; max-width:280px; margin:0 auto;">
                    See real-time status updates from submission through to invoicing.
                </p>
            </div>

            <div class="col-md-4">
                <div style="width:56px; height:56px; background:var(--pi-nitro-blue); border-radius:50%;
                            display:flex; align-items:center; justify-content:center;
                            font-size:1.5rem; margin:0 auto 1.25rem;">🔄</div>
                <h2 style="font-size:1.05rem; font-weight:700; font-family:var(--pi-font-head); color:var(--pi-text-1); margin-bottom:0.5rem;">Reorder in One Click</h2>
                <p style="color:var(--pi-text-2); font-size:0.9rem; line-height:1.6; max-width:280px; margin:0 auto;">
                    Repeat a previous order instantly — items added to your cart automatically.
                </p>
            </div>

        </div>
    </div>
</section>

<!-- SECTION 2b — About Us -->
<section style="background:var(--bs-white); padding:60px 0;">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-lg-5 mb-4 mb-lg-0">
                <div style="font-size:11px;font-weight:600;letter-spacing:1px;color:#332F29;
                            text-transform:uppercase;margin-bottom:10px;">
                    About Us
                </div>
                <h2 style="font-size:28px;font-weight:700;font-family:var(--pi-font-head);color:var(--pi-text-1);margin-bottom:16px;
                            line-height:1.3;">
                    More than just parts.
                </h2>
                <div style="width:40px;height:3px;background:var(--pi-nitro-blue);margin-bottom:20px;"></div>
            </div>
            <div class="col-lg-7">
                <p style="font-size:15px;color:var(--pi-text-1);line-height:1.8;margin-bottom:16px;">
                    At Pontello Imports, we're passionate about performance and precision.
                    As a dedicated importer of high-quality go-kart parts and components,
                    we bring the best of global engineering to racers, hobbyists, and track
                    owners across North America.
                </p>
                <p style="font-size:15px;color:var(--pi-text-1);line-height:1.8;margin-bottom:20px;">
                    From chassis and engines to tires and accessories, our curated selection
                    ensures reliability, speed, and competitive edge. Whether you're building
                    from scratch or upgrading your ride, we're here to fuel your journey —
                    one part at a time.
                </p>
                <div style="display:flex;align-items:center;gap:12px;padding:14px 18px;
                            background:rgba(89,183,255,0.12);border-radius:8px;border-left:3px solid var(--pi-nitro-blue);">
                    <div>
                        <div style="font-size:13px;font-weight:500;color:var(--pi-text-1);margin-bottom:2px;">
                            Call us today
                        </div>
                        <div style="font-size:22px;font-weight:600;color:var(--pi-nitro-blue);margin:4px 0;">
                            647-964-6833
                        </div>
                        <div style="font-size:12px;color:var(--pi-text-2);">
                            Find the perfect parts for your race-ready build
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- SECTION 3 — Existing dealer nudge -->
<section style="background:#332F29; padding:60px 0; text-align:center; border-bottom:1px solid rgba(255,255,255,0.10);">
    <div class="container">
        <h2 style="font-size:1.375rem; font-family:var(--pi-font-head); font-weight:700; color:#FFFFFF; margin-bottom:0.6rem;">
            Already a dealer?
        </h2>
        <p style="color:rgba(255,255,255,0.85); font-size:0.95rem; margin-bottom:1.75rem; max-width:420px; margin-left:auto; margin-right:auto;">
            Sign in to access your account, place orders, and view your order history.
        </p>
        <a asp-area="Identity" asp-page="/Account/Login"
           class="pi-btn pi-btn-dark-primary pi-btn-lg">
            Sign In &rarr;
        </a>
        <p style="font-size:13px;color:rgba(255,255,255,0.75);margin-top:12px;">
            Not a dealer yet?
            <a href="/Home/Apply"
               style="color:#FFFFFF;font-weight:600;text-decoration:underline;">
                Open a dealer account
            </a>
        </p>
    </div>
</section>

<!-- SECTION 4 — Footer -->
<footer style="background:#332F29; padding:2rem 0;">
    <div class="container d-flex justify-content-between align-items-start flex-wrap gap-4">
        <div>
            <img src="/images/pontello-Imports-Logo.png" alt="Pontello Imports"
                 style="height:32px; width:auto; margin-bottom:0.75rem; display:block;" />
            <div style="color:rgba(255,255,255,0.85); font-size:0.82rem; line-height:1.8;">
                141 Eastchester Avenue<br>
                St. Catharines, ON&nbsp;&nbsp;L2P 2Z5<br>
                <a href="tel:6479646833" style="color:rgba(255,255,255,0.85); text-decoration:none;"
                   onmouseover="this.style.color='#ffffff'"
                   onmouseout="this.style.color='rgba(255,255,255,0.85)'">647-964-6833</a>
            </div>
        </div>
        <div style="text-align:right; align-self:flex-end;">
            <div style="color:rgba(255,255,255,0.85); font-size:13px; margin-bottom:0.4rem;">
                &copy; 2026 Pontello Imports. All rights reserved.
            </div>
            <a asp-area="Identity" asp-page="/Account/Login"
               style="color:rgba(255,255,255,0.85); font-size:13px; text-decoration:none;"
               onmouseover="this.style.color='#FFFFFF'"
               onmouseout="this.style.color='rgba(255,255,255,0.85)'">
                Staff Login
            </a>
        </div>
    </div>
</footer>
