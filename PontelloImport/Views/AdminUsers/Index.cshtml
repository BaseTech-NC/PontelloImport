@model IEnumerable<(PontelloImport.Models.ApplicationUser User, IList<string> Roles)>
@{
    Layout = "~/Views/Admin/Shared/_AdminLayout.cshtml";
    ViewBag.Title = "Staff Accounts";
    var search = ViewBag.Search as string ?? "";
    var roleFilter = ViewBag.RoleFilter as string ?? "";
}

<div class="container-fluid mt-4">
    <div class="row mb-4 align-items-center">
        <div class="col">
            <h1 class="h4 mb-0">Staff Accounts</h1>
        </div>
        <div class="col-auto">
            <a asp-action="CreateStaff" class="btn btn-sm btn-primary">
                <i class="bi bi-plus-circle me-1"></i> Create Staff Account
            </a>
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <form method="get" class="row g-2 mb-3 align-items-end">
        <div class="col-sm-5">
            <input type="text" name="search" class="form-control form-control-sm"
                   placeholder="Search by name or email"
                   value="@search" />
        </div>
        <div class="col-sm-3">
            <select name="role" class="form-select form-select-sm">
                <option value="">All Roles</option>
                @if (roleFilter == "SuperAdmin")
                {
                    <option value="SuperAdmin" selected>Super Admin</option>
                }
                else
                {
                    <option value="SuperAdmin">Super Admin</option>
                }
                @if (roleFilter == "Admin")
                {
                    <option value="Admin" selected>Admin</option>
                }
                else
                {
                    <option value="Admin">Admin</option>
                }
                @if (roleFilter == "Staff")
                {
                    <option value="Staff" selected>Staff</option>
                }
                else
                {
                    <option value="Staff">Staff</option>
                }
            </select>
        </div>
        <div class="col-auto">
            <button type="submit" class="btn btn-sm btn-outline-secondary">Filter</button>
            @if (!string.IsNullOrEmpty(search) || !string.IsNullOrEmpty(roleFilter))
            {
                <a asp-action="Index" class="btn btn-sm btn-link text-muted ms-1">Clear</a>
            }
        </div>
    </form>

    <div class="card">
        <div class="table-responsive">
            <table class="pi-table">
                <thead class="table-light">
                    <tr>
                        <th>Name</th>
                        <th>Email</th>
                        <th>Role</th>
                        <th>Status</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var (user, roles) in Model)
                    {
                        var isLocked = user.LockoutEnabled && user.LockoutEnd.HasValue
                            && user.LockoutEnd.Value > DateTimeOffset.UtcNow;
                        var roleLabel = roles.Contains("SuperAdmin") ? "Super Admin"
                            : roles.Contains("Admin") ? "Admin"
                            : roles.Contains("Staff") ? "Staff"
                            : string.Join(", ", roles);
                        var roleBadgeClass = roles.Contains("SuperAdmin") ? "bg-danger"
                            : roles.Contains("Admin") ? "bg-primary"
                            : "bg-secondary";

                        <tr>
                            <td class="fw-semibold">
                                <a asp-action="Details" asp-route-id="@user.Id"
                                   class="text-decoration-none text-dark">
                                    @user.FirstName @user.LastName
                                </a>
                            </td>
                            <td>@user.Email</td>
                            <td>
                                <span class="badge @roleBadgeClass">@roleLabel</span>
                            </td>
                            <td>
                                @if (isLocked)
                                {
                                    <span class="badge bg-danger">Inactive</span>
                                }
                                else
                                {
                                    <span class="badge bg-success">Active</span>
                                }
                            </td>
                            <td class="text-end">
                                <a asp-action="Details" asp-route-id="@user.Id"
                                   class="btn btn-sm btn-outline-secondary me-1">Details</a>
                                @if (!roles.Contains("SuperAdmin"))
                                {
                                    if (isLocked)
                                    {
                                        <form asp-action="ReactivateUser" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="userId" value="@user.Id" />
                                            <button type="submit" class="btn btn-sm btn-outline-success">
                                                Reactivate
                                            </button>
                                        </form>
                                    }
                                    else
                                    {
                                        <form asp-action="DeactivateUser" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="userId" value="@user.Id" />
                                            <button type="submit" class="btn btn-sm btn-outline-danger">
                                                Deactivate
                                            </button>
                                        </form>
                                    }
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
