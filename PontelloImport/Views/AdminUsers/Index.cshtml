@model IEnumerable<(PontelloImport.Models.ApplicationUser User, IList<string> Roles)>
@{
    Layout = "~/Views/Admin/Shared/_AdminLayout.cshtml";
    ViewBag.Title = "Staff Accounts";
}

<div class="container-fluid mt-4">
    <div class="row mb-4 align-items-center">
        <div class="col">
            <h1 class="h4 mb-0">Staff Accounts</h1>
        </div>
        <div class="col-auto">
            <a asp-action="CreateStaff" class="btn btn-sm btn-primary">
                <i class="bi bi-plus-circle me-1"></i> Create Staff Account
            </a>
        </div>
    </div>

    <div class="card">
        <div class="table-responsive">
            <table class="table table-sm table-hover mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Name</th>
                        <th>Email</th>
                        <th>Role</th>
                        <th>Status</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var (user, roles) in Model)
                    {
                        var isLocked = user.LockoutEnabled && user.LockoutEnd.HasValue
                            && user.LockoutEnd.Value > DateTimeOffset.UtcNow;
                        var roleLabel = roles.Contains("SuperAdmin") ? "Super Admin"
                            : roles.Contains("Admin") ? "Admin"
                            : roles.Contains("Staff") ? "Staff"
                            : string.Join(", ", roles);
                        var roleBadgeClass = roles.Contains("SuperAdmin") ? "bg-danger"
                            : roles.Contains("Admin") ? "bg-primary"
                            : "bg-secondary";

                        <tr>
                            <td class="fw-semibold">@user.FirstName @user.LastName</td>
                            <td>@user.Email</td>
                            <td>
                                <span class="badge @roleBadgeClass">@roleLabel</span>
                            </td>
                            <td>
                                @if (isLocked)
                                {
                                    <span class="badge bg-danger">Inactive</span>
                                }
                                else
                                {
                                    <span class="badge bg-success">Active</span>
                                }
                            </td>
                            <td>
                                @if (!roles.Contains("SuperAdmin"))
                                {
                                    if (isLocked)
                                    {
                                        <form asp-action="ReactivateUser" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="userId" value="@user.Id" />
                                            <button type="submit" class="btn btn-sm btn-outline-success">
                                                Reactivate
                                            </button>
                                        </form>
                                    }
                                    else
                                    {
                                        <form asp-action="DeactivateUser" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="userId" value="@user.Id" />
                                            <button type="submit" class="btn btn-sm btn-outline-danger">
                                                Deactivate
                                            </button>
                                        </form>
                                    }
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
