@model List<PontelloImport.Models.Order>

@{
    Layout = "~/Views/Admin/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Orders";
    var activeTab     = ViewData["ActiveTab"] as string ?? "all";
    var currentSearch = ViewData["Search"] as string ?? "";
    var fulfillment   = ViewData["Fulfillment"] as string ?? "";
    var billing       = ViewData["Billing"] as string ?? "";
    var currentPage   = (int)(ViewData["Page"] ?? 1);
    var pageSize      = (int)(ViewData["PageSize"] ?? 25);
    var totalCount    = (int)(ViewData["TotalCount"] ?? 0);
    var totalPages    = (int)(ViewData["TotalPages"] ?? 1);
    var dateFrom      = ViewData["DateFrom"] as string ?? "";
    var dateTo        = ViewData["DateTo"] as string ?? "";

    // Pre-computed selected states for <option> elements (string? so Razor omits attr when null)
    string? selFulfillNotShipped = fulfillment == "notshipped" ? "selected" : null;
    string? selFulfillShipped    = fulfillment == "shipped"    ? "selected" : null;
    string? selBillNotInvoiced   = billing == "notinvoiced"         ? "selected" : null;
    string? selBillInvoiced      = billing == "invoiced"            ? "selected" : null;
    string? selShippedNotInv     = billing == "shipped_notinvoiced" ? "selected" : null;
    string? selInvoicedNotShip   = billing == "invoiced_notshipped" ? "selected" : null;
    string? selPs10 = pageSize == 10 ? "selected" : null;
    string? selPs25 = pageSize == 25 ? "selected" : null;
    string? selPs50 = pageSize == 50 ? "selected" : null;
}

<style>
    .orders-table-card {
        background: var(--pi-bg-card);
        border: 1px solid var(--pi-border);
        border-radius: var(--pi-radius-lg);
        overflow: hidden;
    }

    .orders-table-card table { margin-bottom: 0; }

    /* Details action button — outlined, visible on white AND cool-blue hover rows */
    .order-details-btn {
        display: inline-block;
        padding: 5px 13px;
        border-radius: var(--pi-radius-sm);
        border: 1.5px solid var(--pi-border-md);
        background: var(--pi-bg-card);
        color: var(--pi-text-1);
        font-family: var(--pi-font-body);
        font-size: 12px;
        font-weight: 600;
        text-decoration: none;
        transition: border-color 0.12s, box-shadow 0.12s;
        white-space: nowrap;
    }
    .order-details-btn:hover {
        border-color: var(--pi-nitro-blue);
        box-shadow: 0 0 0 2px rgba(89,183,255,0.20);
        color: var(--pi-text-1);
    }

    .pag { display: flex; gap: 4px; justify-content: center; flex-wrap: wrap; margin-top: 1.25rem; }
    .pag-link {
        display: inline-flex; align-items: center; justify-content: center;
        min-width: 32px; height: 32px; padding: 0 0.5rem;
        font-family: var(--pi-font-body); font-size: 0.8rem; font-weight: 500; text-decoration: none;
        border: 1px solid var(--pi-border); border-radius: 6px;
        color: var(--pi-text-2); background: var(--pi-bg-card);
    }
    .pag-link:hover { background: var(--pi-bg-subtle); color: var(--pi-text-1); }
    .pag-link.active { background: var(--pi-nitro-blue); color: #000; border-color: var(--pi-nitro-blue); }
    .pag-link.disabled { color: var(--pi-text-3); pointer-events: none; }
</style>

<div class="container-fluid mt-4" style="max-width: 1200px;">

    <!-- Header -->
    <div class="d-flex justify-content-between align-items-start mb-4">
        <div>
            <h1 style="font-weight:600;color:var(--pi-text-1);font-size:1.4rem;margin-bottom:0.2rem;">Order Management</h1>
            <p style="color:var(--pi-text-2);font-size:0.875rem;margin:0;">Review and process all dealer orders.</p>
        </div>
        <a asp-action="ExportCsv"
           asp-route-search="@currentSearch"
           asp-route-dateFrom="@dateFrom"
           asp-route-dateTo="@dateTo"
           class="pi-btn pi-btn-blue pi-btn-sm">
            Export CSV
        </a>
    </div>

    <!-- ROW 1 — Tab pills + secondary dropdowns on one line -->
    <div style="display:flex;align-items:center;gap:12px;flex-wrap:wrap;margin-bottom:16px;">

        <!-- Tab pills -->
        <div style="display:flex;gap:2px;background:var(--pi-pit-grey);border-radius:var(--pi-radius);padding:3px;">
            @{
                var tabs = new (string val, string lbl, object? cnt)[]
                {
                    ("all",            "All",             ViewData["AllCount"]),
                    ("submitted",      "Submitted",       ViewData["SubmittedCount"]),
                    ("actionrequired", "Action Required", ViewData["ActionCount"]),
                    ("confirmed",      "Confirmed",       ViewData["ConfirmedCount"]),
                    ("cancelled",      "Cancelled",       ViewData["CancelledCount"])
                };
            }
            @foreach (var (val, lbl, cnt) in tabs)
            {
                bool isActive = activeTab == val;
                int count = cnt != null ? (int)cnt : 0;
                <a href="?tab=@val&fulfillment=@fulfillment&billing=@billing&search=@currentSearch&pageSize=@pageSize"
                   style="display:inline-flex;align-items:center;gap:6px;padding:6px 14px;border-radius:6px;font-family:var(--pi-font-body);font-size:11px;font-weight:600;letter-spacing:0.8px;text-transform:uppercase;text-decoration:none;transition:all 0.12s;background:@(isActive ? "var(--pi-bg-card)" : "transparent");color:@(isActive ? "var(--pi-text-1)" : "var(--pi-text-2)");box-shadow:@(isActive ? "0 1px 3px rgba(0,0,0,0.10)" : "none");">
                    @lbl
                    @if (count > 0)
                    {
                        <span style="background:@(isActive ? "var(--pi-nitro-blue)" : "var(--pi-border-md)");color:@(isActive ? "#000000" : "var(--pi-text-2)");border-radius:10px;padding:1px 6px;font-size:10px;font-weight:700;line-height:1.4;">@count</span>
                    }
                </a>
            }
        </div>

        <!-- Secondary dropdowns — same row as tabs -->
        <form method="get" id="filterForm" style="display:flex;gap:8px;align-items:center;">
            <input type="hidden" name="tab" value="@activeTab">
            <input type="hidden" name="search" value="@currentSearch">
            <input type="hidden" name="pageSize" value="@pageSize">

            <select name="fulfillment"
                    class="form-select form-select-sm"
                    onchange="document.getElementById('filterForm').submit()"
                    style="font-family:var(--pi-font-body);font-size:12px;min-width:130px;border-color:var(--pi-border-md);">
                <option value="">All shipping</option>
                <option value="notshipped" selected="@selFulfillNotShipped">Not shipped</option>
                <option value="shipped"    selected="@selFulfillShipped">Shipped</option>
            </select>

            <select name="billing"
                    class="form-select form-select-sm"
                    onchange="document.getElementById('filterForm').submit()"
                    style="font-family:var(--pi-font-body);font-size:12px;min-width:130px;border-color:var(--pi-border-md);">
                <option value="">All billing</option>
                <option value="notinvoiced"         selected="@selBillNotInvoiced">Not invoiced</option>
                <option value="invoiced"            selected="@selBillInvoiced">Invoiced</option>
                <option value="shipped_notinvoiced" selected="@selShippedNotInv">Shipped — not invoiced</option>
                <option value="invoiced_notshipped" selected="@selInvoicedNotShip">Invoiced — not shipped</option>
            </select>

            @if (!string.IsNullOrEmpty(fulfillment) || !string.IsNullOrEmpty(billing))
            {
                <a href="?tab=@activeTab&search=@currentSearch"
                   style="font-size:12px;color:var(--pi-text-2);text-decoration:none;white-space:nowrap;">
                    Clear
                </a>
            }
        </form>
    </div>

    <!-- ROW 2 — Search + date range + page size + Apply on one line -->
    <form asp-action="Index" method="get" style="display:flex;gap:10px;align-items:center;margin-bottom:16px;flex-wrap:wrap;">
        <input type="hidden" name="tab"         value="@activeTab">
        <input type="hidden" name="fulfillment" value="@fulfillment">
        <input type="hidden" name="billing"     value="@billing">
        <input type="hidden" name="pageSize"    value="@pageSize">

        <!-- Search -->
        <div style="flex:1;min-width:220px;max-width:360px;">
            <label for="orderSearch" class="visually-hidden">Search orders</label>
            <input id="orderSearch"
                   type="text"
                   name="search"
                   class="form-control form-control-sm"
                   value="@currentSearch"
                   placeholder="Search PO number or dealer..."
                   style="font-family:var(--pi-font-body);font-size:13px;">
        </div>

        <!-- Date range -->
        <div style="display:flex;align-items:center;gap:8px;">
            <span style="font-size:12px;color:var(--pi-text-2);white-space:nowrap;">From</span>
            <input type="date"
                   name="dateFrom"
                   class="form-control form-control-sm"
                   value="@dateFrom"
                   style="font-family:var(--pi-font-body);font-size:12px;width:150px;">
            <span style="font-size:12px;color:var(--pi-text-2);">to</span>
            <input type="date"
                   name="dateTo"
                   class="form-control form-control-sm"
                   value="@dateTo"
                   style="font-family:var(--pi-font-body);font-size:12px;width:150px;">
        </div>

        <!-- Page size -->
        <div style="display:flex;align-items:center;gap:8px;">
            <span style="font-size:12px;color:var(--pi-text-2);white-space:nowrap;">Show</span>
            <select name="pageSize"
                    class="form-select form-select-sm"
                    style="width:70px;font-family:var(--pi-font-body);font-size:12px;">
                <option value="10" selected="@selPs10">10</option>
                <option value="25" selected="@selPs25">25</option>
                <option value="50" selected="@selPs50">50</option>
            </select>
        </div>

        <!-- Apply button — Cool Blue, black text -->
        <button type="submit" class="pi-btn pi-btn-blue pi-btn-sm">Apply</button>

        <!-- Clear all link -->
        @if (!string.IsNullOrEmpty(currentSearch) || !string.IsNullOrEmpty(dateFrom) || !string.IsNullOrEmpty(dateTo))
        {
            <a href="?tab=@activeTab&fulfillment=@fulfillment&billing=@billing"
               style="font-size:12px;color:var(--pi-text-2);text-decoration:none;">
                Clear
            </a>
        }
    </form>

    <!-- Orders Table -->
    <div class="orders-table-card">
        <div class="table-responsive">
            <table class="pi-table">
                <thead>
                    <tr>
                        <th class="col-po">PO Number</th>
                        <th class="col-dealer">Dealer</th>
                        <th class="col-date">Date</th>
                        <th class="col-badge">Status</th>
                        <th class="col-amount">Total</th>
                        <th class="col-action" aria-label="Actions"></th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Count == 0)
                    {
                        <tr>
                            <td colspan="6" style="text-align:center;padding:48px 20px;">
                                <div style="font-family:var(--pi-font);font-size:18px;font-weight:700;color:var(--pi-text-1);margin-bottom:8px;">
                                    No orders found
                                </div>
                                <div style="font-size:13px;color:var(--pi-text-2);margin-bottom:16px;">
                                    Try adjusting your filters or search criteria
                                </div>
                                @if (!string.IsNullOrEmpty(currentSearch) || activeTab != "all"
                                     || !string.IsNullOrEmpty(fulfillment) || !string.IsNullOrEmpty(billing))
                                {
                                    <a href="/AdminOrders" class="pi-btn pi-btn-ghost pi-btn-sm">Clear all filters</a>
                                }
                            </td>
                        </tr>
                    }
                    @foreach (var order in Model)
                    {
                        var rowBadge   = order.Status switch
                        {
                            "Submitted"      => "pi-badge-submitted",
                            "ActionRequired" => "pi-badge-action",
                            "Confirmed"      => "pi-badge-confirmed",
                            "Cancelled"      => "pi-badge-cancelled",
                            _                => "pi-badge-submitted"
                        };
                        var rowLabel   = order.Status == "ActionRequired" ? "Action Required" : order.Status;
                        var shipText   = order.FulfillmentStatus == "Shipped"  ? "Shipped"      : "Not shipped";
                        var billText   = order.BillingStatus     == "Invoiced" ? "Invoiced"     : "Not invoiced";
                        bool isWarning = order.BillingStatus == "Invoiced" && order.FulfillmentStatus == "NotShipped";
                        // #92400E = dark amber — passes WCAG AA on both white rows and the #C7EEFF hover background
                        var subColor   = isWarning ? "#92400E" : "var(--pi-text-2)";
                        bool showSub   = order.Status == "Confirmed"
                                         || order.FulfillmentStatus == "Shipped"
                                         || order.BillingStatus == "Invoiced";
                        <tr class="pi-table-row"
                            onclick="window.location='/AdminOrders/Details/@order.OrderID'"
                            style="cursor:pointer;">
                            <td style="font-weight:600;">@order.PONumber</td>
                            <td>@order.DealerCompanyName</td>
                            <td style="color:var(--pi-text-2);">@order.OrderDate.ToString("MMM d, yyyy")</td>
                            <td>
                                <span class="pi-badge @rowBadge">@rowLabel</span>
                                @if (showSub)
                                {
                                    <div style="font-size:11px;margin-top:5px;color:@subColor;font-weight:@(isWarning ? "600" : "400");">
                                        @shipText · @billText
                                    </div>
                                }
                            </td>
                            <td style="text-align:right;font-weight:600;">@order.TotalAmount.ToString("C")</td>
                            <td style="text-align:right;">
                                <a asp-action="Details" asp-route-id="@order.OrderID"
                                   class="order-details-btn"
                                   onclick="event.stopPropagation();">Details</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- Pagination -->
    @if (totalCount > 0)
    {
        var rangeStart = (currentPage - 1) * pageSize + 1;
        var rangeEnd   = Math.Min(currentPage * pageSize, totalCount);
        object PageRoute(int p) => new { tab = activeTab, fulfillment, billing, search = currentSearch, dateFrom, dateTo, pageSize, page = p };

        <div style="text-align:center;margin-top:0.75rem;">
            <small class="text-muted d-block mb-2">
                Showing @rangeStart–@rangeEnd of @totalCount orders
            </small>
        </div>

        @if (totalPages > 1)
        {
            var startPage = Math.Max(1, currentPage - 2);
            var endPage   = Math.Min(totalPages, currentPage + 2);

            <div class="pag">
                <a class="pag-link @(currentPage == 1 ? "disabled" : "")"
                   href="@Url.Action("Index", PageRoute(currentPage - 1))">← Prev</a>

                @if (startPage > 1)
                {
                    <a class="pag-link" href="@Url.Action("Index", PageRoute(1))">1</a>
                    @if (startPage > 2) { <span class="pag-link disabled">…</span> }
                }

                @for (var p = startPage; p <= endPage; p++)
                {
                    <a class="pag-link @(p == currentPage ? "active" : "")"
                       href="@Url.Action("Index", PageRoute(p))">@p</a>
                }

                @if (endPage < totalPages)
                {
                    @if (endPage < totalPages - 1) { <span class="pag-link disabled">…</span> }
                    <a class="pag-link" href="@Url.Action("Index", PageRoute(totalPages))">@totalPages</a>
                }

                <a class="pag-link @(currentPage == totalPages ? "disabled" : "")"
                   href="@Url.Action("Index", PageRoute(currentPage + 1))">Next →</a>
            </div>
        }
    }

</div>
