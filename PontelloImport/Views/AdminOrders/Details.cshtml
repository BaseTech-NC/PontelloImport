@model PontelloImport.Models.Order

@{
    Layout = "~/Views/Admin/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = $"Order {Model.PONumber}";

    var isConfirmed = Model.Status == "Confirmed";
    var isSubmitted = Model.Status == "Submitted";
    var isAction    = Model.Status == "ActionRequired";
    var isCancelled = Model.Status == "Cancelled";
    var isShipped   = Model.FulfillmentStatus == "Shipped";
    var isInvoiced  = Model.BillingStatus == "Invoiced";
    bool outOfOrder = isInvoiced && !isShipped;

    var orderBadgeClass = Model.Status switch {
        "Submitted"      => "pi-badge-submitted",
        "ActionRequired" => "pi-badge-action",
        "Confirmed"      => "pi-badge-confirmed",
        "Cancelled"      => "pi-badge-cancelled",
        _ => "pi-badge-submitted"
    };
    var orderLabel = Model.Status == "ActionRequired" ? "Action Required" : Model.Status;
}

@functions {
    string GetBadgeClass(string type) => type switch
    {
        "Submitted"       => "pi-badge-submitted",
        "Confirmed"       => "pi-badge-confirmed",
        "ActionRequired"  => "pi-badge-action",
        "FlaggedIssue"    => "pi-badge-action",
        "Shipped"         => "pi-badge-shipped",
        "TrackingAdded"   => "pi-badge-shipped",
        "ShippingUpdated" => "pi-badge-shipped",
        "Invoiced"        => "pi-badge-invoiced",
        "Cancelled"       => "pi-badge-cancelled",
        "Resolved"        => "pi-badge-confirmed",
        "AdminModified"   => "pi-badge-shipped",
        "EditInitiated"   => "pi-badge-pending",
        _                 => "pi-badge-pending"
    };

    string ChangeTypeLabel(string type) => type switch
    {
        "Submitted"       => "Order submitted",
        "Confirmed"       => "Order confirmed",
        "FlaggedIssue"    => "Issue flagged",
        "EditInitiated"   => "Edit initiated",
        "AdminModified"   => "Order lines updated",
        "Resolved"        => "Issue resolved",
        "TrackingAdded"   => "Tracking number added",
        "ShippingUpdated" => "Shipping updated",
        "Shipped"         => "Marked as shipped",
        "Invoiced"        => "Invoice issued",
        "Cancelled"       => "Order cancelled",
        _ => type
    };
}

<div class="container-fluid mt-4">

    <!-- HEADER -->
    <div style="display:flex;align-items:center;gap:8px;flex-wrap:wrap;margin-bottom:20px;">

        <a asp-action="Index" class="pi-btn pi-btn-ghost pi-btn-sm">
            &#8592; Back to Orders
        </a>

        <h1 style="font-family:var(--pi-font-head);font-size:22px;font-weight:700;margin:0;">
            Order @Model.OrderNumber
        </h1>

        <span class="pi-badge @orderBadgeClass">@orderLabel</span>

        <span class="pi-badge @(isShipped ? "pi-badge-shipped" : "pi-badge-pending")"
              style="font-size:10px;">
            @(isShipped ? "Shipped" : "Not Shipped")
        </span>

        <span class="pi-badge @(isInvoiced ? "pi-badge-invoiced" : "pi-badge-pending")"
              style="font-size:10px;">
            @(isInvoiced ? "Invoiced" : "Not Invoiced")
        </span>

        @if (outOfOrder)
        {
            <span style="font-size:11px;color:var(--pi-warning);font-weight:500;">
                Invoiced &middot; Shipping pending
            </span>
        }
    </div>

    <!-- CANCELLED BANNER -->
    @if (isCancelled)
    {
        <div class="pi-notice pi-notice-danger" style="margin-bottom:16px;">
            <strong>Order Cancelled</strong> &mdash;
            This order has been cancelled. No further actions are available.
            Existing shipping and invoice data is preserved for reference.
        </div>
    }

    <div class="row g-4">

        <!-- LEFT COLUMN -->
        <div class="col-lg-8">

            <!-- Items card -->
            <div class="pi-card mb-4" style="padding:0;">
                <div style="padding:14px 16px 8px 16px;font-size:11px;font-weight:500;letter-spacing:0.5px;text-transform:uppercase;color:var(--pi-text-2);border-bottom:1px solid var(--pi-border);">
                    Items
                </div>
                <div style="padding:0;">
                    <div class="table-responsive">
                        <table class="pi-table" style="margin-bottom:0;">
                            <thead>
                                <tr>
                                    <th>Product</th>
                                    <th>Variant</th>
                                    <th>SKU</th>
                                    <th class="text-center">Qty</th>
                                    <th class="text-end">Unit Price</th>
                                    <th class="text-end">Line Total</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var line in Model.OrderLines)
                                {
                                    <tr>
                                        <td>@line.ProductTitle</td>
                                        <td class="text-muted">@DisplayHelpers.VariantDisplay(line.VariantTitle)</td>
                                        <td><code class="text-dark">@line.SKU</code></td>
                                        <td class="text-center">@line.Quantity</td>
                                        <td class="text-end">@line.UnitPrice.ToString("C")</td>
                                        <td class="text-end fw-semibold">@line.LineTotal.ToString("C")</td>
                                    </tr>
                                }
                            </tbody>
                            <tfoot class="table-light">
                                <tr>
                                    <td colspan="5" class="text-end text-muted">Subtotal</td>
                                    <td class="text-end">@Model.SubtotalAmount.ToString("C")</td>
                                </tr>
                                @if (Model.TaxAmount.HasValue)
                                {
                                    <tr>
                                        <td colspan="5" class="text-end text-muted">
                                            Tax @(Model.TaxRate.HasValue ? $"({Model.TaxRate * 100:0.##}%)" : "")
                                        </td>
                                        <td class="text-end">@Model.TaxAmount.Value.ToString("C")</td>
                                    </tr>
                                }
                                @if (Model.ShippingCost.HasValue)
                                {
                                    <tr>
                                        <td colspan="5" class="text-end text-muted">Shipping</td>
                                        <td class="text-end">@Model.ShippingCost.Value.ToString("C")</td>
                                    </tr>
                                }
                                <tr class="border-top">
                                    <td colspan="5" class="text-end fw-semibold">Total</td>
                                    <td class="text-end fw-semibold fs-6">@Model.TotalAmount.ToString("C")</td>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                </div>
            </div>

            <!-- WORKFLOW ACTIONS — Submitted / ActionRequired -->
            @if (isSubmitted || isAction)
            {
                <div class="pi-card" style="margin-bottom:16px;">
                    <div style="display:grid;grid-template-columns:1fr 1fr;grid-template-rows:1fr 1fr;gap:10px;align-items:stretch;">

                        <!-- Top left: Confirm Order -->
                        <form asp-action="ConfirmOrder" asp-route-id="@Model.OrderID" method="post"
                              style="display:flex;height:100%;">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="pi-btn pi-btn-primary"
                                    style="width:100%;height:100%;justify-content:center;min-height:44px;">
                                Confirm Order
                            </button>
                        </form>

                        <!-- Top right: Open for Editing -->
                        <a asp-controller="AdminOrders"
                           asp-action="EditLines"
                           asp-route-id="@Model.OrderID"
                           class="pi-btn pi-btn-blue"
                           style="width:100%;justify-content:center;min-height:44px;">
                            Open for Editing
                        </a>

                        <!-- Bottom left: Flag Issue -->
                        <button type="button"
                                class="pi-btn pi-btn-ghost"
                                style="width:100%;height:100%;justify-content:center;min-height:44px;"
                                data-bs-toggle="modal"
                                data-bs-target="#flagIssueModal">
                            Flag Issue
                        </button>

                        <!-- Bottom right: Cancel Order -->
                        <form asp-action="CancelOrder" asp-route-id="@Model.OrderID" method="post"
                              style="display:flex;height:100%;"
                              onsubmit="return confirm('Cancel this order? This cannot be undone.')">
                            @Html.AntiForgeryToken()
                            <button type="submit"
                                    class="pi-btn pi-btn-danger"
                                    style="width:100%;height:100%;justify-content:center;min-height:44px;">
                                Cancel Order
                            </button>
                        </form>

                    </div>
                    <div style="margin-top:10px;padding-top:10px;border-top:1px solid var(--pi-border);font-size:11px;color:var(--pi-text-2);">
                        Use <strong>Open for Editing</strong> to adjust quantities &middot;
                        Use <strong>Flag Issue</strong> if the dealer needs to contact you first
                    </div>
                </div>
            }

            <!-- SHIPPING CARD -->
            @if (isConfirmed || isShipped || isInvoiced || isCancelled)
            {
                <div class="pi-card" style="margin-bottom:12px;@(isCancelled ? "opacity:0.6;pointer-events:none;" : "")">

                    <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:16px;">
                        <div class="pi-section-label" style="margin-bottom:0;">Shipping Details</div>
                        @if (isShipped)
                        {
                            <span class="pi-badge pi-badge-shipped">
                                Shipped
                                @if (Model.ShipDate.HasValue)
                                {
                                    <span style="font-weight:400;margin-left:4px;">
                                        @Model.ShipDate.Value.ToString("MMM d, yyyy")
                                    </span>
                                }
                            </span>
                        }
                    </div>

                    @if (isCancelled)
                    {
                        <div class="pi-notice pi-notice-danger">Order cancelled &mdash; no further actions allowed</div>
                    }

                    @if (!isShipped)
                    {
                        <!-- Not yet shipped: mark as shipped form -->
                        <form asp-action="MarkShipped" asp-route-id="@Model.OrderID" method="post">
                            @Html.AntiForgeryToken()
                            <div class="row g-3 mb-3">
                                <div class="col-md-3">
                                    <label class="form-label">
                                        Ship Date
                                        <span style="color:var(--pi-danger);">*</span>
                                    </label>
                                    <input type="date" name="shipDate"
                                           class="form-control"
                                           value="@DateTime.Now.ToString("yyyy-MM-dd")"
                                           required>
                                </div>
                                <div class="col-md-3">
                                    <label for="trackingInput" class="form-label" style="display:block;margin-bottom:6px;">Tracking Number</label>
                                    <input id="trackingInput" type="text" name="trackingNumber" class="form-control"
                                           value="@Model.TrackingNumber"
                                           placeholder="e.g. 1Z999AA1...">
                                    <div style="font-size:10px;color:var(--pi-text-2);margin-top:3px;">Optional</div>
                                </div>
                                <div class="col-md-3">
                                    <label for="carrierInput" class="form-label" style="display:block;margin-bottom:6px;">Carrier</label>
                                    <input id="carrierInput" type="text" name="carrier" class="form-control"
                                           value="@Model.Carrier"
                                           placeholder="UPS, FedEx...">
                                    <div style="font-size:10px;color:var(--pi-text-2);margin-top:3px;">Optional</div>
                                </div>
                                <div class="col-md-3">
                                    <label for="shippingInput" class="form-label" style="display:block;margin-bottom:6px;">Shipping Amount</label>
                                    <div style="position:relative;">
                                        <span style="position:absolute;left:10px;top:50%;transform:translateY(-50%);color:var(--pi-text-2);">$</span>
                                        <input id="shippingInput" type="number" name="shippingAmount" class="form-control"
                                               style="padding-left:24px;"
                                               value="@Model.ShippingCost"
                                               placeholder="0.00" min="0" step="0.01">
                                    </div>
                                    <div style="font-size:10px;color:var(--pi-text-2);margin-top:3px;">Optional</div>
                                </div>
                            </div>

                            @if (!Model.ShippingCost.HasValue || Model.ShippingCost <= 0)
                            {
                                <div class="pi-notice pi-notice-info" style="margin-bottom:12px;">
                                    No shipping amount yet. Invoice total will not include shipping until you add it.
                                </div>
                            }

                            <button type="submit" class="pi-btn pi-btn-blue">
                                Mark as Shipped
                            </button>
                            <span style="font-size:11px;color:var(--pi-text-2);margin-left:8px;">Ship date required</span>
                        </form>
                    }
                    else
                    {
                        <!-- Already shipped: summary + collapsed edit form -->
                        <div style="display:grid;grid-template-columns:repeat(4,1fr);gap:12px;margin-bottom:12px;">
                            <div>
                                <div style="font-size:11px;color:var(--pi-text-2);margin-bottom:2px;">Ship Date</div>
                                <div style="font-size:14px;font-weight:500;">
                                    @(Model.ShipDate.HasValue ? Model.ShipDate.Value.ToString("MMM d, yyyy") : "—")
                                </div>
                            </div>
                            <div>
                                <div style="font-size:11px;color:var(--pi-text-2);margin-bottom:2px;">Tracking</div>
                                <div style="font-size:14px;">@(string.IsNullOrEmpty(Model.TrackingNumber) ? "—" : Model.TrackingNumber)</div>
                            </div>
                            <div>
                                <div style="font-size:11px;color:var(--pi-text-2);margin-bottom:2px;">Carrier</div>
                                <div style="font-size:14px;">@(string.IsNullOrEmpty(Model.Carrier) ? "—" : Model.Carrier)</div>
                            </div>
                            <div>
                                <div style="font-size:11px;color:var(--pi-text-2);margin-bottom:2px;">Shipping Amount</div>
                                <div style="font-size:14px;">
                                    @(Model.ShippingCost.HasValue ? Model.ShippingCost.Value.ToString("C") : "—")
                                </div>
                            </div>
                        </div>

                        <button type="button" class="pi-btn pi-btn-ghost pi-btn-sm"
                                onclick="toggleShippingEdit()">Edit Shipping</button>

                        <div id="shippingEditForm" style="display:none;margin-top:16px;border-top:1px solid var(--pi-border);padding-top:16px;">
                            <form asp-action="SaveShipping" asp-route-id="@Model.OrderID" method="post">
                                @Html.AntiForgeryToken()
                                <div class="row g-3 mb-3">
                                    <div class="col-md-3">
                                        <label class="form-label">Ship Date</label>
                                        <input type="date" name="shipDate" class="form-control"
                                               value="@Model.ShipDate?.ToString("yyyy-MM-dd")">
                                    </div>
                                    <div class="col-md-3">
                                        <label class="form-label">Tracking Number</label>
                                        <input type="text" name="trackingNumber" class="form-control"
                                               value="@Model.TrackingNumber"
                                               placeholder="e.g. 1Z999AA1...">
                                    </div>
                                    <div class="col-md-3">
                                        <label class="form-label">Carrier</label>
                                        <input type="text" name="carrier" class="form-control"
                                               value="@Model.Carrier"
                                               placeholder="UPS, FedEx...">
                                    </div>
                                    <div class="col-md-3">
                                        <label class="form-label">Shipping Amount</label>
                                        <div style="position:relative;">
                                            <span style="position:absolute;left:10px;top:50%;transform:translateY(-50%);color:var(--pi-text-2);">$</span>
                                            <input type="number" name="shippingAmount" class="form-control"
                                                   style="padding-left:24px;"
                                                   value="@Model.ShippingCost"
                                                   placeholder="0.00" min="0" step="0.01">
                                        </div>
                                    </div>
                                </div>
                                <button type="submit" class="pi-btn pi-btn-blue pi-btn-sm">
                                    @(isInvoiced ? "Save & Resend PO" : "Update Shipping")
                                </button>
                                @if (isInvoiced)
                                {
                                    <span style="font-size:11px;color:var(--pi-text-2);margin-left:8px;">
                                        Saving will resend a revised PO to the dealer
                                    </span>
                                }
                            </form>
                        </div>
                    }
                </div>
            }

            <!-- INVOICE CARD -->
            @if (isConfirmed || isShipped || isInvoiced || isCancelled)
            {
                <div class="pi-card" style="margin-bottom:16px;@(isCancelled ? "opacity:0.6;pointer-events:none;" : "")">

                    <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:16px;">
                        <div class="pi-section-label" style="margin-bottom:0;">Invoice Details</div>
                        @if (isInvoiced)
                        {
                            <span class="pi-badge pi-badge-invoiced">Invoiced</span>
                        }
                    </div>

                    @if (isCancelled)
                    {
                        <div class="pi-notice pi-notice-danger">Order cancelled &mdash; invoicing not available</div>
                    }
                    else if (!isInvoiced)
                    {
                        <form asp-action="MarkInvoiced" asp-route-id="@Model.OrderID" method="post">
                            @Html.AntiForgeryToken()
                            <div class="row g-3 mb-3">
                                <div class="col-md-6">
                                    <label for="invoiceNumberInput" class="form-label">Invoice Number</label>
                                    <input id="invoiceNumberInput" type="text" name="invoiceNumber"
                                           class="form-control"
                                           value="@(Model.InvoiceNumber ?? $"INV-{Model.OrderNumber}")"
                                           placeholder="INV-0029">
                                    <div style="font-size:10px;color:var(--pi-text-2);margin-top:3px;">
                                        Auto-generated &mdash; edit if needed
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label">
                                        Invoice Notes
                                        <span style="font-size:10px;color:var(--pi-text-2);font-weight:400;">(optional)</span>
                                    </label>
                                    <input type="text" name="invoiceNotes" class="form-control"
                                           value="@Model.InvoiceNotes"
                                           placeholder="Any notes...">
                                </div>
                            </div>
                            <div style="display:flex;gap:10px;align-items:center;">
                                <button type="submit" class="pi-btn pi-btn-primary">
                                    Invoice Now
                                </button>
                                @if (!Model.ShippingCost.HasValue || Model.ShippingCost <= 0)
                                {
                                    <span style="font-size:11px;color:var(--pi-text-2);">
                                        Invoice now. Shipping can be added later.
                                    </span>
                                }
                            </div>
                        </form>
                    }
                    else
                    {
                        <div class="row g-3">
                            <div class="col-md-4">
                                <div style="font-size:11px;color:var(--pi-text-2);margin-bottom:3px;">Invoice Number</div>
                                <div style="font-weight:600;font-size:14px;">@Model.InvoiceNumber</div>
                            </div>
                            <div class="col-md-4">
                                <div style="font-size:11px;color:var(--pi-text-2);margin-bottom:3px;">Invoice Date</div>
                                <div style="font-size:14px;">@Model.InvoicedAt?.ToString("MMMM d, yyyy")</div>
                            </div>
                            <div class="col-md-4">
                                <div style="font-size:11px;color:var(--pi-text-2);margin-bottom:3px;">Payment Terms</div>
                                <div style="font-size:14px;">@Model.PaymentTerms?.TermName</div>
                            </div>
                        </div>

                        @if (!string.IsNullOrEmpty(Model.InvoiceNotes))
                        {
                            <div style="margin-top:12px;padding:10px 12px;background:var(--pi-bg-subtle);border-radius:var(--pi-radius-sm);font-size:13px;color:var(--pi-text-2);">
                                @Model.InvoiceNotes
                            </div>
                        }

                        <form asp-action="UpdateInvoiceNotes" asp-route-id="@Model.OrderID" method="post"
                              style="margin-top:12px;">
                            @Html.AntiForgeryToken()
                            <div style="display:flex;gap:8px;">
                                <input type="text" name="invoiceNotes" class="form-control"
                                       value="@Model.InvoiceNotes"
                                       placeholder="Add notes..."
                                       style="max-width:400px;">
                                <button type="submit" class="pi-btn pi-btn-ghost pi-btn-sm">Save Notes</button>
                            </div>
                        </form>
                    }
                </div>
            }

            <!-- History -->
            <div class="pi-card" style="padding:0;">
                <div style="padding:14px 16px 8px 16px;font-size:11px;font-weight:500;letter-spacing:0.5px;text-transform:uppercase;color:var(--pi-text-2);border-bottom:1px solid var(--pi-border);">
                    History
                </div>
                @if (!Model.OrderHistories.Any())
                {
                    <div style="padding:16px;color:var(--pi-text-2);font-size:13px;">No history entries.</div>
                }
                else
                {
                    <div style="overflow-x:auto;">
                        <table class="pi-table" style="width:100%;table-layout:fixed;">
                            <thead>
                                <tr>
                                    <th style="width:150px;min-width:150px;white-space:nowrap;">Action</th>
                                    <th>Description</th>
                                    <th style="width:160px;min-width:160px;white-space:nowrap;">By</th>
                                    <th style="width:140px;min-width:140px;white-space:nowrap;">When</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var h in Model.OrderHistories)
                                {
                                    <tr>
                                        <td style="width:150px;white-space:nowrap;">
                                            <span class="pi-badge @GetBadgeClass(h.ChangeType)">
                                                @ChangeTypeLabel(h.ChangeType)
                                            </span>
                                        </td>
                                        <td style="overflow:hidden;text-overflow:ellipsis;white-space:nowrap;max-width:0;"
                                            title="@h.ChangeDescription">
                                            @(string.IsNullOrWhiteSpace(h.ChangeDescription) ? "—" : h.ChangeDescription)
                                        </td>
                                        <td style="width:160px;white-space:nowrap;color:var(--pi-text-2);font-size:12px;">
                                            @h.ChangedBy
                                        </td>
                                        <td style="width:140px;white-space:nowrap;color:var(--pi-text-2);font-size:12px;">
                                            @h.ChangedDate.ToString("MMM d, h:mm tt")
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>

        </div>

        <!-- RIGHT COLUMN — Order Details sidebar -->
        <div class="col-lg-4">
            <div style="background:white;border:1px solid var(--pi-border);border-top:3px solid var(--pi-nitro-blue);border-radius:0 0 8px 8px;">
                <div style="padding:16px;">
                    <div style="font-size:11px;font-weight:500;letter-spacing:0.5px;text-transform:uppercase;color:var(--pi-text-2);margin-bottom:12px;">
                        Order Details
                    </div>

                    <div style="display:flex;justify-content:space-between;padding:8px 0;border-bottom:1px solid var(--pi-border);font-size:14px;">
                        <span style="color:var(--pi-text-2);">PO Number</span>
                        <span style="font-weight:500;color:var(--pi-text-1);">@Model.PONumber</span>
                    </div>
                    <div style="display:flex;justify-content:space-between;padding:8px 0;border-bottom:1px solid var(--pi-border);font-size:14px;">
                        <span style="color:var(--pi-text-2);">Dealer</span>
                        <span style="font-weight:500;color:var(--pi-text-1);">@Model.DealerCompanyName</span>
                    </div>
                    <div style="display:flex;justify-content:space-between;padding:8px 0;border-bottom:1px solid var(--pi-border);font-size:14px;">
                        <span style="color:var(--pi-text-2);">Order Date</span>
                        <span style="font-weight:500;color:var(--pi-text-1);">@Model.OrderDate.ToString("MMM d, yyyy")</span>
                    </div>
                    <div style="display:flex;justify-content:space-between;padding:8px 0;border-bottom:1px solid var(--pi-border);font-size:14px;">
                        <span style="color:var(--pi-text-2);">Payment Terms</span>
                        <span style="font-weight:500;color:var(--pi-text-1);">@(Model.PaymentTerms?.TermName ?? "—")</span>
                    </div>
                    <div style="display:flex;justify-content:space-between;padding:8px 0;border-bottom:1px solid var(--pi-border);font-size:14px;">
                        <span style="color:var(--pi-text-2);">Payment Due</span>
                        <span style="font-weight:500;color:var(--pi-text-1);">
                            @(Model.PaymentDueDate.HasValue
                                ? Model.PaymentDueDate.Value.ToString("MMM d, yyyy")
                                : "—")
                        </span>
                    </div>
                    <div style="display:flex;justify-content:space-between;padding:8px 0;border-bottom:1px solid var(--pi-border);font-size:14px;">
                        <span style="color:var(--pi-text-2);">Tax Exempt</span>
                        <span style="font-weight:500;color:var(--pi-text-1);">@(Model.IsTaxExempt ? "Yes" : "No")</span>
                    </div>

                    @if (Model.Status is "Submitted" or "ActionRequired" or "Confirmed")
                    {
                        @Html.AntiForgeryToken()
                        <div style="display:flex;justify-content:space-between;padding:8px 0;border-bottom:1px solid var(--pi-border);font-size:14px;">
                            <span style="color:var(--pi-text-2);">Tax Rate</span>
                            <div style="display:flex;align-items:center;gap:6px;">
                                <input type="number" id="taxRateInput"
                                       value="@(Model.TaxRate.HasValue ? (Model.TaxRate.Value * 100m).ToString("0.##") : "13")"
                                       min="0" max="30" step="0.5"
                                       onchange="recalcTax(this.value)"
                                       style="width:55px;text-align:center;border:1px solid var(--pi-border);border-radius:4px;padding:3px;font-size:13px;" />
                                <span style="font-size:13px;color:var(--pi-text-2);">%</span>
                                <button onclick="saveTaxRate()" class="pi-btn pi-btn-ghost pi-btn-sm">Apply</button>
                            </div>
                        </div>
                        <div style="display:flex;justify-content:space-between;padding:8px 0;border-bottom:1px solid var(--pi-border);font-size:14px;">
                            <span style="color:var(--pi-text-2);">Tax Amount</span>
                            <span id="taxAmountDisplay" style="font-weight:500;">
                                @(Model.TaxAmount.HasValue ? $"${Model.TaxAmount.Value:F2}" : "—")
                            </span>
                        </div>
                    }

                    <div style="display:flex;justify-content:space-between;align-items:center;padding:8px 0;font-size:14px;">
                        <span style="color:var(--pi-text-2);">Status</span>
                        <span class="pi-badge @orderBadgeClass" style="font-size:10px;">@orderLabel</span>
                    </div>
                </div>
            </div>
        </div>

    </div>
</div>

@section Scripts {
    <script>
    function toggleShippingEdit() {
        const form = document.getElementById('shippingEditForm');
        if (form) form.style.display = form.style.display === 'none' ? 'block' : 'none';
    }

    function recalcTax(rate) {
        const subtotal = @Model.SubtotalAmount;
        const tax = subtotal * (parseFloat(rate) / 100);
        document.getElementById('taxAmountDisplay').textContent = '$' + tax.toFixed(2);
    }

    async function saveTaxRate() {
        const rate = document.getElementById('taxRateInput').value;
        const token = document.querySelector('[name=__RequestVerificationToken]')?.value ?? '';
        await fetch('/AdminOrders/UpdateTax', {
            method: 'POST',
            body: new URLSearchParams({
                id: @Model.OrderID,
                taxRate: rate,
                __RequestVerificationToken: token
            }),
            headers: { 'Content-Type': 'application/x-www-form-urlencoded' }
        });
        location.reload();
    }

    function handleFlagReason(val) {
        const note = document.getElementById('flagReasonNote');
        if (val && val !== 'other') {
            note.placeholder = val + ' — add any additional details here.';
        }
        const presets = {
            'Out of stock / inventory shortage':
                'We currently have limited stock for one or more items in your order. ' +
                'Please call us at 647-964-6833 to discuss options.',
            'Product discontinued':
                'One or more products in your order have been discontinued. ' +
                'Please call 647-964-6833 to arrange an alternative.',
        };
        if (presets[val] && note.value === '') {
            note.value = presets[val];
        }
    }

    document.querySelector('#flagIssueModal form')
        ?.addEventListener('submit', function() {
        const sel = document.getElementById('flagReasonSelect').value;
        const note = document.getElementById('flagReasonNote');
        const combined = sel && sel !== 'other'
            ? (note.value ? sel + ': ' + note.value : sel)
            : note.value;
        note.value = combined;
    });
    </script>
}

<!-- Modal: Flag Issue -->
@if (isSubmitted || isAction)
{
    <div class="modal fade" id="flagIssueModal" tabindex="-1" aria-labelledby="flagIssueModalLabel" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <form method="post" asp-action="FlagIssue" asp-route-id="@Model.OrderID">
                    @Html.AntiForgeryToken()
                    <div class="modal-header">
                        <h5 class="modal-title" id="flagIssueModalLabel">
                            <i class="bi bi-flag me-1 text-warning"></i> Flag Issue with Order
                        </h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body">
                        <div class="mb-3">
                            <label class="form-label" style="font-size:13px;">Reason for flagging</label>
                            <select id="flagReasonSelect" class="form-select form-select-sm mb-2"
                                    onchange="handleFlagReason(this.value)">
                                <option value="">Select a reason...</option>
                                <option value="Out of stock / inventory shortage">Out of stock / inventory shortage</option>
                                <option value="Product discontinued">Product discontinued</option>
                                <option value="Pricing discrepancy">Pricing discrepancy</option>
                                <option value="Shipping restriction">Shipping restriction to this address</option>
                                <option value="Address issue">Address issue — cannot ship here</option>
                                <option value="Incorrect order details">Incorrect order details</option>
                                <option value="other">Other (add note below)</option>
                            </select>
                            <textarea id="flagReasonNote" name="reason"
                                      class="form-control form-control-sm" rows="3"
                                      placeholder="Add details or describe the issue for the dealer..."
                                      style="font-size:13px;"></textarea>
                            <div style="font-size:11px;color:var(--pi-text-2);margin-top:4px;">
                                Include 647-964-6833 so the dealer knows how to reach you.
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="pi-btn pi-btn-ghost" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="pi-btn pi-btn-ghost">
                            <i class="bi bi-flag me-1"></i> Flag Issue
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}
