@model PontelloImport.Models.Order

@{
    Layout = "~/Views/Admin/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = $"Order {Model.PONumber}";
}

@functions {
    string BadgeClass(string type) => type switch
    {
        "Submitted"      => "badge bg-secondary",
        "ActionRequired" => "badge bg-warning text-dark",
        "FlaggedIssue"   => "badge bg-warning text-dark",
        "Confirmed"      => "badge bg-success",
        "Resolved"       => "badge bg-success",
        "AdminModified"  => "badge bg-primary",
        "Shipped"        => "badge text-white",
        "TrackingAdded"  => "badge bg-info text-dark",
        "ShippingUpdated"=> "badge bg-primary",
        "Invoiced"       => "badge bg-info text-dark",
        "Cancelled"      => "badge bg-danger",
        _                => "badge bg-secondary"
    };

    string BadgeStyle(string type) =>
        type == "Shipped" ? "background:#6f42c1;" : "";
}

<div class="container-fluid mt-4">

    <!-- Breadcrumb + Header -->
    <div class="row mb-4 align-items-center">
        <div class="col-auto">
            <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
                <i class="bi bi-arrow-left me-1"></i> Back to Orders
            </a>
        </div>
        <div class="col">
            <h1 class="mb-0 h4">
                Order @Model.PONumber
                <span class="@BadgeClass(Model.Status)" style="@BadgeStyle(Model.Status) font-size:0.75rem;">
                    @Model.Status
                </span>
            </h1>
        </div>
    </div>

    <div class="row g-4">

        <!-- Left column: Lines + Actions + History -->
        <div class="col-lg-8">

            <!-- Order Lines -->
            <div class="card mb-4">
                <div class="card-header bg-dark text-white">Items</div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-sm mb-0">
                            <thead>
                                <tr>
                                    <th>Product</th>
                                    <th>Variant</th>
                                    <th>SKU</th>
                                    <th class="text-center">Qty</th>
                                    <th class="text-end">Unit Price</th>
                                    <th class="text-end">Line Total</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var line in Model.OrderLines)
                                {
                                    <tr>
                                        <td>@line.ProductTitle</td>
                                        <td class="text-muted">
                                            @{
                                                var adminDisplayVariant = (line.VariantTitle == "Default Title" || line.VariantTitle == "Title")
                                                    ? "" : line.VariantTitle;
                                            }
                                            @if (!string.IsNullOrEmpty(adminDisplayVariant))
                                            {
                                                @adminDisplayVariant
                                            }
                                            else if (string.IsNullOrEmpty(adminDisplayVariant) && string.IsNullOrEmpty(line.VariantTitle))
                                            {
                                                <span>—</span>
                                            }
                                        </td>
                                        <td><code class="text-dark">@line.SKU</code></td>
                                        <td class="text-center">@line.Quantity</td>
                                        <td class="text-end">@line.UnitPrice.ToString("C")</td>
                                        <td class="text-end fw-semibold">@line.LineTotal.ToString("C")</td>
                                    </tr>
                                }
                            </tbody>
                            <tfoot class="table-light">
                                <tr>
                                    <td colspan="5" class="text-end text-muted">Subtotal</td>
                                    <td class="text-end">@Model.SubtotalAmount.ToString("C")</td>
                                </tr>
                                @if (Model.TaxAmount.HasValue)
                                {
                                    <tr>
                                        <td colspan="5" class="text-end text-muted">
                                            Tax @(Model.TaxRate.HasValue ? $"({Model.TaxRate * 100:0.##}%)" : "")
                                        </td>
                                        <td class="text-end">@Model.TaxAmount.Value.ToString("C")</td>
                                    </tr>
                                }
                                @if (Model.ShippingCost.HasValue)
                                {
                                    <tr>
                                        <td colspan="5" class="text-end text-muted">
                                            Shipping
                                            @if (Model.Status == "Confirmed" || Model.Status == "Shipped")
                                            {
                                                <a asp-action="EditShipping" asp-route-id="@Model.OrderID"
                                                   class="ms-2 small text-primary">(Edit)</a>
                                            }
                                        </td>
                                        <td class="text-end">@Model.ShippingCost.Value.ToString("C")</td>
                                    </tr>
                                }
                                else if (Model.Status == "Confirmed" || Model.Status == "Shipped")
                                {
                                    <tr>
                                        <td colspan="5" class="text-end text-muted">
                                            Shipping
                                            <a asp-action="EditShipping" asp-route-id="@Model.OrderID"
                                               class="ms-2 small text-primary">(Edit)</a>
                                        </td>
                                        <td class="text-end text-muted">—</td>
                                    </tr>
                                }
                                <tr class="border-top">
                                    <td colspan="5" class="text-end fw-semibold">Total</td>
                                    <td class="text-end fw-semibold fs-6">@Model.TotalAmount.ToString("C")</td>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                </div>
            </div>

            <!-- Action Buttons -->
            @if (Model.Status == "Submitted")
            {
                <div class="card mb-4">
                    <div class="card-header bg-dark text-white">Actions</div>
                    <div class="card-body d-flex gap-2 flex-wrap">
                        <form method="post" asp-action="Confirm" asp-route-id="@Model.OrderID">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-success">
                                <i class="bi bi-check-circle me-1"></i> Confirm Order
                            </button>
                        </form>
                        <button type="button" class="btn btn-warning" data-bs-toggle="modal" data-bs-target="#flagIssueModal">
                            <i class="bi bi-flag me-1"></i> Flag Issue
                        </button>
                        <form method="post" asp-action="Cancel" asp-route-id="@Model.OrderID"
                              onsubmit="return confirm('Cancel this order? This cannot be undone.')">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-danger">
                                <i class="bi bi-x-circle me-1"></i> Cancel Order
                            </button>
                        </form>
                    </div>
                </div>
            }
            else if (Model.Status == "ActionRequired")
            {
                <div class="card mb-4">
                    <div class="card-header bg-dark text-white">Actions</div>
                    <div class="card-body">

                        <!-- Area 1: Edit Order Lines -->
                        <div class="mb-4 pb-3 border-bottom">
                            <a asp-action="EditLines" asp-route-id="@Model.OrderID" class="btn btn-outline-primary">
                                <i class="bi bi-pencil me-1"></i> Edit Order Lines
                            </a>
                            <div class="text-muted small mt-1">Modify quantities or remove items before confirming.</div>
                        </div>

                        <!-- Area 2: Resolve & Confirm -->
                        <div class="mb-4 pb-3 border-bottom">
                            <button type="button" class="btn btn-success" data-bs-toggle="modal" data-bs-target="#resolveModal">
                                <i class="bi bi-check-circle me-1"></i> Resolve &amp; Confirm
                            </button>
                        </div>

                        <!-- Area 3: Cancel -->
                        <div>
                            <button type="button" class="btn btn-outline-danger" data-bs-toggle="modal" data-bs-target="#cancelModal">
                                <i class="bi bi-x-circle me-1"></i> Cancel Order
                            </button>
                        </div>

                    </div>
                </div>
            }
            else if (Model.Status == "Confirmed")
            {
                <div class="card mb-4">
                    <div class="card-header bg-dark text-white">Ship Order</div>
                    <div class="card-body">
                        <!-- Save Tracking Number (does NOT change status) -->
                        <form method="post" asp-action="SaveTracking" asp-route-id="@Model.OrderID" class="mb-3">
                            @Html.AntiForgeryToken()
                            <div class="row g-3 align-items-end">
                                <div class="col-md-7">
                                    <label class="form-label fw-semibold">Tracking Number <span class="text-muted fw-normal small">(optional)</span></label>
                                    <input type="text" name="TrackingNumber" class="form-control"
                                           placeholder="e.g. 1Z999AA10123456784"
                                           value="@Model.TrackingNumber" />
                                </div>
                                <div class="col-auto">
                                    <button type="submit" class="btn btn-outline-primary">
                                        <i class="bi bi-save me-1"></i> Save Tracking
                                    </button>
                                </div>
                            </div>
                            <div class="form-text text-muted mt-1">Saves tracking number only — does not change order status.</div>
                        </form>
                        <hr />
                        <!-- Mark as Shipped (changes status) -->
                        <form method="post" asp-action="MarkShipped" asp-route-id="@Model.OrderID" class="mb-3">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-primary"
                                    onclick="return confirm('Mark this order as shipped?')">
                                <i class="bi bi-truck me-1"></i> Mark as Shipped
                            </button>
                        </form>
                        <hr />
                        <form method="post" asp-action="Cancel" asp-route-id="@Model.OrderID"
                              onsubmit="return confirm('Cancel this confirmed order? Inventory will be restored.')">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-outline-danger btn-sm">
                                <i class="bi bi-x-circle me-1"></i> Cancel Order
                            </button>
                        </form>
                    </div>
                </div>
            }
            else if (Model.Status == "Shipped")
            {
                <div class="card mb-4">
                    <div class="card-header bg-dark text-white">Actions</div>
                    <div class="card-body d-flex gap-3 align-items-center flex-wrap">
                        <form method="post" asp-action="MarkInvoiced" asp-route-id="@Model.OrderID">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-dark">
                                <i class="bi bi-receipt me-1"></i> Mark as Invoiced
                            </button>
                        </form>
                        @if (!string.IsNullOrEmpty(Model.TrackingNumber))
                        {
                            <div class="text-muted">
                                <i class="bi bi-truck me-1"></i>
                                Tracking: <code class="text-dark">@Model.TrackingNumber</code>
                            </div>
                        }
                    </div>
                </div>
            }
            else if (Model.Status == "Invoiced")
            {
                <div class="card mb-4">
                    <div class="card-body text-muted">
                        <i class="bi bi-check-all me-1"></i>
                        This order has been invoiced. No further actions are available.
                        @if (!string.IsNullOrEmpty(Model.TrackingNumber))
                        {
                            <span class="ms-3">
                                <i class="bi bi-truck me-1"></i>
                                Tracking: <code class="text-dark">@Model.TrackingNumber</code>
                            </span>
                        }
                    </div>
                </div>
            }
            else if (Model.Status == "Cancelled")
            {
                <div class="card mb-4">
                    <div class="card-body text-muted">
                        <i class="bi bi-x-circle me-1"></i>
                        This order has been cancelled. No further actions are available.
                    </div>
                </div>
            }

            <!-- Order History Timeline -->
            <div class="card">
                <div class="card-header bg-dark text-white">History</div>
                @if (!Model.OrderHistories.Any())
                {
                    <div class="card-body text-muted">No history entries.</div>
                }
                else
                {
                    <ul class="list-group list-group-flush">
                        @foreach (var h in Model.OrderHistories)
                        {
                            <li class="list-group-item @(h.ChangeType == "FlaggedIssue" ? "list-group-item-warning" : h.ChangeType == "Resolved" ? "list-group-item-success" : "")">
                                <div class="d-flex justify-content-between align-items-start">
                                    <div class="flex-grow-1">
                                        <div class="d-flex align-items-center gap-2 mb-1">
                                            <span class="@BadgeClass(h.ChangeType)" style="@BadgeStyle(h.ChangeType)">
                                                @(h.ChangeType switch {
                                                    "FlaggedIssue"  => "Flagged Issue",
                                                    "Resolved"      => "Resolved",
                                                    "AdminModified" => "Lines Edited",
                                                    "TrackingAdded" => "Tracking Added",
                                                    "ShippingUpdated" => "Shipping Updated",
                                                    _ => h.ChangeType
                                                })
                                            </span>
                                            <small class="text-muted">by @h.ChangedBy</small>
                                        </div>
                                        @if (!string.IsNullOrWhiteSpace(h.ChangeDescription))
                                        {
                                            <div class="@(h.ChangeType is "FlaggedIssue" or "Resolved" or "AdminModified" ? "fw-semibold" : "text-muted small")">
                                                @h.ChangeDescription
                                            </div>
                                        }
                                    </div>
                                    <small class="text-muted text-nowrap ms-3">
                                        @h.ChangedDate.ToString("MMM d, yyyy h:mm tt")
                                    </small>
                                </div>
                            </li>
                        }
                    </ul>
                }
            </div>

        </div>

        <!-- Right column: Order Details -->
        <div class="col-lg-4">
            <div class="card">
                <div class="card-header bg-dark text-white">Order Details</div>
                <div class="card-body">
                    <dl class="row mb-0">
                        <dt class="col-sm-5 text-muted">PO Number</dt>
                        <dd class="col-sm-7 fw-semibold">@Model.PONumber</dd>

                        <dt class="col-sm-5 text-muted">Dealer</dt>
                        <dd class="col-sm-7">@Model.DealerCompanyName</dd>

                        <dt class="col-sm-5 text-muted">Order Date</dt>
                        <dd class="col-sm-7">@Model.OrderDate.ToString("MMM d, yyyy")</dd>

                        <dt class="col-sm-5 text-muted">Payment Terms</dt>
                        <dd class="col-sm-7">@(Model.PaymentTerms?.TermName ?? "—")</dd>

                        <dt class="col-sm-5 text-muted">Payment Due</dt>
                        <dd class="col-sm-7">
                            @(Model.PaymentDueDate.HasValue
                                ? Model.PaymentDueDate.Value.ToString("MMM d, yyyy")
                                : "—")
                        </dd>

                        <dt class="col-sm-5 text-muted">Tax Exempt</dt>
                        <dd class="col-sm-7">@(Model.IsTaxExempt ? "Yes" : "No")</dd>

                        <dt class="col-sm-5 text-muted">Status</dt>
                        <dd class="col-sm-7">
                            <span class="@BadgeClass(Model.Status)" style="@BadgeStyle(Model.Status)">
                                @Model.Status
                            </span>
                        </dd>
                    </dl>
                </div>
            </div>
        </div>

    </div>
</div>

<!-- Modal: Flag Issue (Submitted orders) -->
@if (Model.Status == "Submitted")
{
    <div class="modal fade" id="flagIssueModal" tabindex="-1" aria-labelledby="flagIssueModalLabel" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <form method="post" asp-action="FlagIssue" asp-route-id="@Model.OrderID">
                    @Html.AntiForgeryToken()
                    <div class="modal-header">
                        <h5 class="modal-title" id="flagIssueModalLabel">
                            <i class="bi bi-flag me-1 text-warning"></i> Flag Issue with Order
                        </h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body">
                        <label for="flagReason" class="form-label fw-semibold">Describe the issue <span class="text-danger">*</span></label>
                        <textarea id="flagReason" name="reason" class="form-control" rows="4" required minlength="10" maxlength="500"
                                  placeholder="e.g. Item CRG-3001 is out of stock — awaiting restock in 2 weeks."></textarea>
                        <div class="form-text">Minimum 10 characters. This message will be visible to the dealer.</div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-warning">
                            <i class="bi bi-flag me-1"></i> Flag Issue
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}

<!-- Modal: Resolve & Confirm (ActionRequired orders) -->
@if (Model.Status == "ActionRequired")
{
    <div class="modal fade" id="resolveModal" tabindex="-1" aria-labelledby="resolveModalLabel" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <form method="post" asp-action="ResolveAndConfirm" asp-route-id="@Model.OrderID">
                    @Html.AntiForgeryToken()
                    <div class="modal-header">
                        <h5 class="modal-title" id="resolveModalLabel">
                            <i class="bi bi-check-circle me-1 text-success"></i> Resolve &amp; Confirm Order
                        </h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body">
                        <label for="resolutionNote" class="form-label fw-semibold">Resolution Note <span class="text-muted fw-normal small">(optional)</span></label>
                        <textarea id="resolutionNote" name="resolutionNote" class="form-control" rows="3" maxlength="500"
                                  placeholder="e.g. Spoke with dealer — reduced quantity to 5, item will ship next week."></textarea>
                        <div class="form-text">If left blank: "Issue resolved. Order confirmed by admin."</div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-success">
                            <i class="bi bi-check-circle me-1"></i> Confirm
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- Modal: Cancel (ActionRequired orders) -->
    <div class="modal fade" id="cancelModal" tabindex="-1" aria-labelledby="cancelModalLabel" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <form method="post" asp-action="Cancel" asp-route-id="@Model.OrderID">
                    @Html.AntiForgeryToken()
                    <div class="modal-header">
                        <h5 class="modal-title" id="cancelModalLabel">
                            <i class="bi bi-x-circle me-1 text-danger"></i> Cancel Order
                        </h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body">
                        <p class="text-muted">This cannot be undone.</p>
                        <label for="cancelNote" class="form-label fw-semibold">Reason <span class="text-muted fw-normal small">(optional)</span></label>
                        <textarea id="cancelNote" name="cancelNote" class="form-control" rows="3" maxlength="500"
                                  placeholder="e.g. Dealer requested cancellation — item no longer needed."></textarea>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Dismiss</button>
                        <button type="submit" class="btn btn-danger">
                            <i class="bi bi-x-circle me-1"></i> Cancel Order
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}
