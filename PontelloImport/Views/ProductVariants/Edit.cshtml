@model PontelloImport.Models.EditProductViewModel

@{
    Layout = "~/Views/Admin/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Edit Product";
    var optionNames = new[] { "Color", "Size", "Material", "Style", "Type", "Weight", "Length", "Diameter" };
}

<style>
    *, *::before, *::after { font-family: Inter, system-ui, sans-serif; }

    .create-section {
        background: #ffffff;
        border: 1px solid #E5E7EB;
        border-radius: 12px;
        margin-bottom: 1.25rem;
        overflow: hidden;
    }

    .create-section-header {
        background: #F8FAFC;
        border-bottom: 1px solid #E5E7EB;
        padding: 0.875rem 1.25rem;
        font-weight: 600;
        font-size: 0.875rem;
        color: #374151;
        letter-spacing: 0.01em;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .create-section-body { padding: 1.25rem; }

    .form-label {
        font-size: 0.875rem;
        font-weight: 500;
        color: #374151;
        margin-bottom: 0.35rem;
    }

    .form-control, .form-select {
        font-size: 0.875rem;
        border-color: #D1D5DB;
        border-radius: 8px;
    }

    .form-control:focus, .form-select:focus {
        border-color: #2563EB;
        box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.12);
    }

    .input-group-text {
        background: #F8FAFC;
        border-color: #D1D5DB;
        font-size: 0.875rem;
        color: #4B5563;
    }

    .form-text        { font-size: 0.8rem; color: #4B5563; }
    .optional-label   { font-size: 0.75rem; color: #4B5563; font-weight: 400; margin-left: 0.3rem; }

    .btn-save {
        background: #111827; color: #ffffff; border: none;
        border-radius: 8px; font-size: 0.875rem; font-weight: 500;
        padding: 0.5rem 1.5rem; cursor: pointer; transition: background 150ms;
    }
    .btn-save:hover { background: #374151; color: #ffffff; }

    .btn-save-view {
        background: #2563EB; color: #ffffff; border: none;
        border-radius: 8px; font-size: 0.875rem; font-weight: 500;
        padding: 0.5rem 1.5rem; cursor: pointer; transition: background 150ms;
    }
    .btn-save-view:hover { background: #1D4ED8; color: #ffffff; }

    .btn-cancel-link {
        color: #4B5563; border: 1px solid #E5E7EB; background: transparent;
        border-radius: 8px; font-size: 0.875rem; font-weight: 500;
        padding: 0.5rem 1.1rem; text-decoration: none; transition: background 150ms;
        display: inline-block;
    }
    .btn-cancel-link:hover { background: #F3F4F6; color: #374151; }

    /* spec rows */
    .spec-row { display: flex; gap: 0.5rem; align-items: center; margin-bottom: 0.5rem; }
    .spec-row .spec-label-col { flex: 1 1 40%; }
    .spec-row .spec-value-col { flex: 2 1 55%; }

    /* variant table */
    .var-table { font-size: 0.82rem; }
    .var-table th {
        font-size: 0.71rem; font-weight: 600; text-transform: uppercase;
        letter-spacing: 0.05em; color: #4B5563; background: #F8FAFC;
        padding: 0.5rem 0.6rem;
    }
    .var-table td { vertical-align: middle; padding: 0.35rem 0.6rem; }
    .var-table .form-control-sm { font-size: 0.82rem; }

    .row-archived { opacity: 0.4; }
    .row-archived td { text-decoration: line-through; }

    .field-instant-feedback {
        font-size: 0.85rem; margin-top: 0.25rem; display: block;
    }
    .field-instant-feedback.text-success { color: #198754 !important; }
    .field-instant-feedback.text-danger  { color: #dc3545 !important; }
</style>

<div class="container-fluid mt-4" style="max-width: 760px;">

    <div class="mb-4">
        <a asp-action="Index" style="color:#4B5563; font-size:0.875rem; text-decoration:none;">← Back to Product Catalogue</a>
    </div>

    <div class="mb-4">
        <h1 style="font-size:1.15rem; font-weight:700; color:#111827; margin:0;">Edit Product</h1>
        <div style="font-size:0.875rem; color:#4B5563; margin-top:0.2rem;">
            Fields marked <span class="text-danger">*</span> are required.
            @if (Model.IsSimpleProduct)
            {
                <span class="ms-2" style="color:#4B5563;">Simple product</span>
            }
            else
            {
                <span class="ms-2" style="color:#4B5563;">Product with variants</span>
            }
        </div>
    </div>

    <form asp-action="Edit" asp-route-id="@Model.ProductID" method="post" id="editForm">
        @Html.AntiForgeryToken()

        <!-- Round-trip hidden fields -->
        <input type="hidden" asp-for="ProductID" />
        <input type="hidden" asp-for="IsSimpleProduct" />
        @if (Model.IsSimpleProduct)
        {
            <input type="hidden" asp-for="SimpleVariantID" />
        }

        <!-- ══ VALIDATION SUMMARY ══════════════════════════════════════════════ -->
        @if (!ViewData.ModelState.IsValid &&
             ViewData.ModelState.Values.Any(v => v.Errors.Count > 0))
        {
            <div class="alert alert-danger mb-3" id="validationSummaryAlert">
                <strong>Please fix the following errors:</strong>
                <div asp-validation-summary="All" class="mt-1 mb-0 small"></div>
            </div>
        }
        else
        {
            <div class="alert alert-danger mb-3" id="validationSummaryAlert" style="display:none;">
                <strong>Please fix the following errors:</strong>
                <div asp-validation-summary="All" class="mt-1 mb-0 small"></div>
            </div>
        }

        <!-- ══ PRODUCT INFO ══════════════════════════════════════════════════ -->
        <div class="create-section">
            <div class="create-section-header">Product Info</div>
            <div class="create-section-body">

                <div class="mb-3">
                    <label asp-for="Title" class="form-label">Product Title <span class="text-danger">*</span></label>
                    <input asp-for="Title" id="titleInput" class="form-control"
                           placeholder="e.g., Safety Helmet Full-Face" />
                    <span asp-validation-for="Title" class="text-danger small"></span>
                    <span id="title-ajax-msg" class="small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Description" class="form-label">
                        Description <span class="optional-label">(optional)</span>
                    </label>
                    <textarea asp-for="Description" class="form-control" rows="3"
                              placeholder="Product description..."></textarea>
                </div>

                <div class="mb-3">
                    <label asp-for="VendorID" class="form-label">Vendor <span class="text-danger">*</span></label>
                    <select asp-for="VendorID" class="form-select" asp-items="ViewBag.VendorID">
                        <option value="0">-- Select Vendor --</option>
                    </select>
                    <span asp-validation-for="VendorID" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="ProductCategoryID" class="form-label">Category <span class="text-danger">*</span></label>
                    <select asp-for="ProductCategoryID" class="form-select" asp-items="ViewBag.ProductCategoryID">
                        <option value="0">-- Select Category --</option>
                    </select>
                    <span asp-validation-for="ProductCategoryID" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="ProductTypeID" class="form-label">
                        Product Type <span class="optional-label">(optional)</span>
                    </label>
                    <select asp-for="ProductTypeID" class="form-select"
                            asp-items="@(ViewData["ProductTypes"] as SelectList)">
                        <option value="">-- None --</option>
                    </select>
                    <span asp-validation-for="ProductTypeID" class="text-danger small"></span>
                </div>

            </div>
        </div>

        <!-- ══ SPECIFICATIONS ════════════════════════════════════════════════ -->
        <div class="create-section">
            <div class="create-section-header">Specifications</div>
            <div class="create-section-body">
                <p class="small text-muted mb-3">
                    Optional. Add technical details like Model Year, Material, Thread Size, Fitment, etc.
                </p>

                <div id="spec-rows">
                    @for (int i = 0; i < Model.Specifications.Count; i++)
                    {
                        var spec = Model.Specifications[i];
                        <div class="spec-row">
                            <div class="spec-label-col">
                                <input type="text" name="Specifications[@i].Label"
                                       value="@spec.Label"
                                       class="form-control form-control-sm"
                                       placeholder="e.g. Model Year"
                                       aria-label="Specification label" />
                            </div>
                            <div class="spec-value-col">
                                <input type="text" name="Specifications[@i].Value"
                                       value="@spec.Value"
                                       class="form-control form-control-sm"
                                       placeholder="e.g. 2023"
                                       aria-label="Specification value" />
                            </div>
                            <button type="button" class="btn btn-outline-danger btn-sm px-2"
                                    onclick="removeSpecRow(this)">×</button>
                        </div>
                    }
                </div>

                <div id="spec-limit-msg" class="text-danger small mt-1" style="display:none">
                    Maximum 10 specifications allowed.
                </div>

                <button type="button" id="addSpecBtn"
                        class="btn btn-outline-secondary btn-sm mt-2"
                        onclick="addSpecRow()">
                    + Add Specification
                </button>
            </div>
        </div>

        @if (Model.IsSimpleProduct)
        {
            <!-- ══ SIMPLE PRODUCT — LISTING DETAILS ══════════════════════════════ -->
            <div class="create-section">
                <div class="create-section-header">Listing Details</div>
                <div class="create-section-body">
                    <p class="small text-muted mb-3">Price, stock, and identifier for this product.</p>

                    <div class="mb-3">
                        <label asp-for="SKU" class="form-label">SKU <span class="text-danger">*</span></label>
                        <input asp-for="SKU" id="skuInput" class="form-control" placeholder="e.g., CRG-3001" />
                        <span asp-validation-for="SKU" class="text-danger small"></span>
                        <span id="sku-ajax-msg" class="small"></span>
                        <small class="form-text">Format: AA-000 &nbsp;e.g. CRG-3001</small>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Barcode" class="form-label">
                            Barcode (UPC / EAN) <span class="optional-label">(optional)</span>
                        </label>
                        <input asp-for="Barcode" class="form-control" id="barcodeInput"
                               placeholder="e.g. 12345678901234"
                               pattern="[0-9]{8,14}" title="Barcode must be 8–14 digits" />
                        <span asp-validation-for="Barcode" class="text-danger small"></span>
                        <small class="form-text">Optional. 8–14 digit numeric barcode.</small>
                    </div>

                    <div class="row">
                        <div class="col-4 mb-3">
                            <label asp-for="Price" class="form-label">Price <span class="text-danger">*</span></label>
                            <div class="input-group">
                                <span class="input-group-text">$</span>
                                <input asp-for="Price" type="number" step="0.01" min="0.01"
                                       class="form-control" placeholder="0.00" />
                            </div>
                            <span asp-validation-for="Price" class="text-danger small"></span>
                            <small class="form-text">CAD</small>
                        </div>
                        <div class="col-4 mb-3">
                            <label asp-for="CostPrice" class="form-label">
                                Your Cost <span class="optional-label">(not shown to dealers)</span>
                            </label>
                            <div class="input-group">
                                <span class="input-group-text">$</span>
                                <input asp-for="CostPrice" type="number" step="0.01" min="0"
                                       class="form-control" placeholder="0.00" />
                            </div>
                            <span asp-validation-for="CostPrice" class="text-danger small"></span>
                        </div>
                        <div class="col-4 mb-3">
                            <label asp-for="CompareAtPrice" class="form-label">
                                Compare At <span class="optional-label">(original price)</span>
                            </label>
                            <div class="input-group">
                                <span class="input-group-text">$</span>
                                <input asp-for="CompareAtPrice" type="number" step="0.01" min="0"
                                       class="form-control" placeholder="0.00" />
                            </div>
                            <span asp-validation-for="CompareAtPrice" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-6 mb-3">
                            <label asp-for="InventoryQuantity" class="form-label">Stock Quantity <span class="text-danger">*</span></label>
                            <input asp-for="InventoryQuantity" type="number" min="0"
                                   class="form-control" placeholder="0" />
                            <span asp-validation-for="InventoryQuantity" class="text-danger small"></span>
                        </div>
                        <div class="col-6 mb-3">
                            <label asp-for="Weight" class="form-label">
                                Weight <span class="optional-label">(grams)</span>
                            </label>
                            <input asp-for="Weight" type="number" step="0.01" min="0"
                                   class="form-control" placeholder="0" id="weightInput" />
                            <span asp-validation-for="Weight" class="text-danger small"></span>
                            <small class="form-text">Enter in grams, e.g. 450</small>
                        </div>
                    </div>

                    <div class="mt-3 pt-3" style="border-top:1px solid #E5E7EB;">
                        <div class="mb-1" style="font-size:0.875rem; font-weight:500; color:#374151;">
                            Option <span class="optional-label">(optional)</span>
                        </div>
                        <p class="small text-muted mb-2">
                            Does this product come in a specific option (e.g. Size = Small)?
                        </p>
                        <div class="row">
                            <div class="col-6 mb-1">
                                <label asp-for="SimpleOptionName" class="form-label">Option</label>
                                <select asp-for="SimpleOptionName" class="form-select" id="SimpleOptionName"
                                        onchange="onSimpleOptionNameChange()">
                                    <option value="">-- None --</option>
                                    @foreach (var n in optionNames)
                                    {
                                        <option value="@n">@n</option>
                                    }
                                </select>
                                <span asp-validation-for="SimpleOptionName" class="text-danger small"></span>
                            </div>
                            <div class="col-6 mb-1">
                                <label asp-for="SimpleOptionValue" class="form-label">Value</label>
                                <input asp-for="SimpleOptionValue" class="form-control" id="SimpleOptionValue"
                                       placeholder="e.g. Small" />
                                <span asp-validation-for="SimpleOptionValue" class="text-danger small"></span>
                            </div>
                        </div>
                    </div>

                </div>
            </div>
        }
        else
        {
            <!-- ══ VARIANT PRODUCT — OPTION NAMES + VARIANT TABLE ══════════════ -->
            <div class="create-section">
                <div class="create-section-header">Option Names</div>
                <div class="create-section-body">
                    <p class="small text-muted mb-3">
                        These names label the option columns (e.g. Color, Size). Changing them renames the column
                        headers but does not alter the variant values.
                    </p>
                    <div class="row">
                        <div class="col-4 mb-2">
                            <label asp-for="Option1Name" class="form-label">Option 1 <span class="text-danger">*</span></label>
                            <input asp-for="Option1Name" class="form-control form-control-sm"
                                   placeholder="e.g. Color" />
                            <span asp-validation-for="Option1Name" class="text-danger small"></span>
                        </div>
                        <div class="col-4 mb-2">
                            <label asp-for="Option2Name" class="form-label">
                                Option 2 <span class="optional-label">(optional)</span>
                            </label>
                            <input asp-for="Option2Name" class="form-control form-control-sm"
                                   placeholder="e.g. Size" />
                        </div>
                        <div class="col-4 mb-2">
                            <label asp-for="Option3Name" class="form-label">
                                Option 3 <span class="optional-label">(optional)</span>
                            </label>
                            <input asp-for="Option3Name" class="form-control form-control-sm"
                                   placeholder="e.g. Material" />
                        </div>
                    </div>
                </div>
            </div>

            <div class="create-section">
                <div class="create-section-header">
                    <span>Variants</span>
                    <span style="font-size:0.8rem; color:#4B5563; font-weight:400;">
                        @Model.Variants.Count variant@(Model.Variants.Count != 1 ? "s" : "")
                    </span>
                </div>
                <div class="table-responsive">
                    <table class="table table-sm var-table mb-0">
                        <thead>
                            <tr>
                                @if (!string.IsNullOrWhiteSpace(Model.Option1Name))
                                { <th>@Model.Option1Name</th> }
                                @if (!string.IsNullOrWhiteSpace(Model.Option2Name))
                                { <th>@Model.Option2Name</th> }
                                @if (!string.IsNullOrWhiteSpace(Model.Option3Name))
                                { <th>@Model.Option3Name</th> }
                                <th style="min-width:130px;">SKU <span class="text-danger">*</span></th>
                                <th style="min-width:100px;">Price <span class="text-danger">*</span></th>
                                <th style="min-width:100px;">Your Cost</th>
                                <th style="min-width:80px;">Stock Qty</th>
                                <th style="min-width:110px;">Barcode</th>
                                <th style="min-width:70px;">Default</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody id="variantTableBody">
                            @for (int i = 0; i < Model.Variants.Count; i++)
                            {
                                var row = Model.Variants[i];
                                <tr id="varRow_@i">
                                    @if (!string.IsNullOrWhiteSpace(Model.Option1Name))
                                    { <td>@(row.Option1Value ?? "")</td> }
                                    @if (!string.IsNullOrWhiteSpace(Model.Option2Name))
                                    { <td>@(row.Option2Value ?? "")</td> }
                                    @if (!string.IsNullOrWhiteSpace(Model.Option3Name))
                                    { <td>@(row.Option3Value ?? "")</td> }

                                    <td>
                                        <!-- Hidden round-trip fields inside <td> (not bare in <tr>) -->
                                        <input type="hidden" name="Variants[@i].VariantID" value="@row.VariantID" />
                                        <input type="hidden" name="Variants[@i].Option1Value" value="@(row.Option1Value ?? "")" />
                                        <input type="hidden" name="Variants[@i].Option2Value" value="@(row.Option2Value ?? "")" />
                                        <input type="hidden" name="Variants[@i].Option3Value" value="@(row.Option3Value ?? "")" />
                                        <input type="hidden" id="varIsArchived_@i" name="Variants[@i].IsArchived" value="false" />
                                        <input type="text" name="Variants[@i].SKU" value="@row.SKU"
                                               class="form-control form-control-sm var-sku-input"
                                               data-variant-id="@row.VariantID"
                                               placeholder="SKU"
                                               aria-label="SKU for variant @(i + 1)" />
                                        <span class="text-danger small" id="sku-err-@i"></span>
                                    </td>
                                    <td>
                                        <input type="number" name="Variants[@i].Price"
                                               value="@row.Price.ToString("0.00")"
                                               class="form-control form-control-sm"
                                               step="0.01" min="0.01"
                                               aria-label="Price for variant @(i + 1)" />
                                    </td>
                                    <td>
                                        <input type="number" name="Variants[@i].CostPrice"
                                               value="@(row.CostPrice.HasValue ? row.CostPrice.Value.ToString("0.00") : "")"
                                               class="form-control form-control-sm"
                                               step="0.01" min="0" placeholder="0.00"
                                               aria-label="Cost for variant @(i + 1)" />
                                    </td>
                                    <td>
                                        <input type="number" name="Variants[@i].InventoryQuantity"
                                               value="@row.InventoryQuantity"
                                               class="form-control form-control-sm" min="0"
                                               aria-label="Stock quantity for variant @(i + 1)" />
                                    </td>
                                    <td>
                                        <input type="text" name="Variants[@i].Barcode"
                                               value="@(row.Barcode ?? "")"
                                               class="form-control form-control-sm"
                                               placeholder="Barcode"
                                               pattern="[0-9]{8,14}" title="8–14 digits"
                                               aria-label="Barcode for variant @(i + 1)" />
                                    </td>
                                    <td class="text-center">
                                        <input type="radio" name="DefaultVariantID"
                                               value="@row.VariantID"
                                               @(row.VariantID == Model.DefaultVariantID ? "checked" : "")
                                               class="form-check-input" />
                                    </td>
                                    <td>
                                        <button type="button" class="btn btn-sm btn-outline-danger"
                                                onclick="archiveVariantRow(this, @i)"
                                                title="Archive this variant">
                                            Archive
                                        </button>
                                    </td>
                                </tr>
                            }
                                <tr id="emptyVariantRow" style="display:none;">
                                    <td colspan="99" class="text-center text-muted py-4" style="font-size:0.875rem;">
                                        All variants have been archived. Add a new variant below or restore archived variants from the product details page.
                                    </td>
                                </tr>
                        </tbody>
                    </table>
                </div>
                <div id="variantLimitMsg" class="px-3 py-2" style="display:none; color:#dc3545; font-size:0.82rem; border-top:1px solid #E5E7EB;">
                    Maximum 50 variants allowed.
                </div>
                <div class="px-3 py-2" style="border-top:1px solid #E5E7EB;">
                    <button type="button" class="btn btn-outline-secondary btn-sm" onclick="addVariantRow()">
                        + Add Variant
                    </button>
                </div>
            </div>
        }

        <!-- ══ BUTTONS ══════════════════════════════════════════════════════ -->
        <div class="d-flex justify-content-between align-items-center mt-3 mb-5">
            <a asp-action="Details" asp-route-id="@Model.ProductID" class="btn-cancel-link">← Back to Product</a>
            @if (Model.Status == ProductStatus.Published)
            {
                <div class="d-flex gap-2">
                    <button type="submit" name="saveAction" value="publish" class="btn btn-dark">Save Changes</button>
                    <button type="submit" name="saveAction" value="unpublish" class="btn btn-outline-secondary">Unpublish</button>
                </div>
            }
            else
            {
                <div class="d-flex gap-2">
                    <button type="submit" name="saveAction" value="publish" class="btn btn-dark">Publish</button>
                    <button type="submit" name="saveAction" value="draft" class="btn btn-outline-secondary">Save as Draft</button>
                </div>
            }
        </div>

    </form>

</div>

