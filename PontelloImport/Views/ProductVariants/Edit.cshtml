@model PontelloImport.Models.CreateProductViewModel

@{
    Layout = "~/Views/Admin/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Edit Product";
}

<style>
    *, *::before, *::after { font-family: Inter, system-ui, sans-serif; }

    .edit-section {
        background: #ffffff;
        border: 1px solid #E5E7EB;
        border-radius: 12px;
        margin-bottom: 1.25rem;
        overflow: hidden;
    }

    .edit-section-header {
        background: #F8FAFC;
        border-bottom: 1px solid #E5E7EB;
        padding: 0.875rem 1.25rem;
        font-weight: 600;
        font-size: 0.875rem;
        color: #374151;
        letter-spacing: 0.01em;
    }

    .edit-section-body {
        padding: 1.25rem;
    }

    .form-label {
        font-size: 0.875rem;
        font-weight: 500;
        color: #374151;
        margin-bottom: 0.35rem;
    }

    .form-control, .form-select {
        font-size: 0.875rem;
        border-color: #D1D5DB;
        border-radius: 8px;
    }

    .form-control:focus, .form-select:focus {
        border-color: #2563EB;
        box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.12);
    }

    .input-group-text {
        background: #F8FAFC;
        border-color: #D1D5DB;
        font-size: 0.875rem;
        color: #6B7280;
    }

    .form-text {
        font-size: 0.8rem;
        color: #9CA3AF;
    }

    .btn-save {
        background: #111827;
        color: #ffffff;
        border: none;
        border-radius: 8px;
        font-size: 0.875rem;
        font-weight: 500;
        padding: 0.5rem 1.5rem;
        cursor: pointer;
        transition: background 150ms;
    }

    .btn-save:hover { background: #374151; color: #ffffff; }

    .btn-cancel-link {
        color: #6B7280;
        border: 1px solid #E5E7EB;
        background: transparent;
        border-radius: 8px;
        font-size: 0.875rem;
        font-weight: 500;
        padding: 0.5rem 1.1rem;
        text-decoration: none;
        transition: background 150ms;
        display: inline-block;
    }

    .btn-cancel-link:hover { background: #F3F4F6; color: #374151; }

    .btn-add-attr {
        color: #374151;
        border: 1px dashed #D1D5DB;
        background: #F9FAFB;
        border-radius: 8px;
        font-size: 0.875rem;
        font-weight: 500;
        padding: 0.45rem 1rem;
        cursor: pointer;
        transition: background 150ms;
    }

    .btn-add-attr:hover { background: #F3F4F6; border-color: #9CA3AF; }

    /* Override Bootstrap style for the JS-generated Remove buttons */
    .attribute-row .btn.btn-outline-dark.btn-sm {
        color: #6B7280;
        border-color: #E5E7EB;
        background: transparent;
        border-radius: 6px;
        font-size: 0.8rem;
        font-weight: 500;
        transition: all 150ms;
    }

    .attribute-row .btn.btn-outline-dark.btn-sm:hover {
        background: #FEF2F2;
        border-color: #FECACA;
        color: #DC2626;
    }

    .attr-header-label {
        font-size: 0.8rem;
        font-weight: 600;
        color: #6B7280;
        text-transform: uppercase;
        letter-spacing: 0.05em;
    }

    .side-card {
        background: #ffffff;
        border: 1px solid #E5E7EB;
        border-radius: 12px;
        overflow: hidden;
        margin-bottom: 1rem;
    }

    .side-card-header {
        background: #F8FAFC;
        border-bottom: 1px solid #E5E7EB;
        padding: 0.75rem 1rem;
        font-size: 0.8rem;
        font-weight: 600;
        color: #374151;
    }

    .side-card-body {
        padding: 1rem;
        font-size: 0.85rem;
    }

    .status-pill {
        display: inline-block;
        padding: 0.2em 0.65em;
        border-radius: 9999px;
        font-size: 0.78rem;
        font-weight: 500;
        line-height: 1.4;
    }

    .status-draft     { background: #EFF6FF; color: #1D4ED8; }
    .status-published { background: #F0FDF4; color: #166534; }
    .status-archived  { background: #F3F4F6; color: #4B5563; }
</style>

<div class="container-fluid mt-4" style="max-width: 1020px;">

    <div class="mb-4">
        <a asp-action="Index" style="color:#6B7280; font-size:0.875rem; text-decoration:none;">← Back to Product Catalogue</a>
    </div>

    <div class="mb-4">
        <div style="font-size:1.15rem; font-weight:700; color:#111827;">Edit Product</div>
        <div style="font-size:0.875rem; color:#6B7280; margin-top:0.2rem;">
            Update product details. Fields marked <span class="text-danger">*</span> are required.
        </div>
    </div>

    <div class="row">
        <div class="col-md-8">

            <div id="standaloneForm">
                <form asp-action="Edit" method="post">

                    <input type="hidden" asp-for="Variant.ProductID" />
                    <input type="hidden" asp-for="Variant.VariantID" />

                    <div class="alert alert-danger alert-dismissible fade show" role="alert" id="validationSummaryAlert" style="@(ViewData.ModelState.IsValid ? "display:none;" : "")">
                        <strong>Please correct the following errors:</strong>
                        <div asp-validation-summary="All" class="mt-2 mb-0" data-valmsg-summary="true"></div>
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>

                    <!-- SECTION 1: BASIC INFORMATION -->
                    <div class="edit-section">
                        <div class="edit-section-header">Basic Information</div>
                        <div class="edit-section-body">

                            <div class="mb-3">
                                <label asp-for="Product.VendorID" class="form-label"></label>
                                <span class="text-danger">*</span>
                                <select asp-for="Product.VendorID" class="form-select" asp-items="ViewBag.VendorID">
                                    <option value="">-- Select Vendor --</option>
                                </select>
                                <span asp-validation-for="Product.VendorID" class="text-danger"></span>
                            </div>

                            <div class="mb-3">
                                <label asp-for="Product.ProductCategoryID" class="form-label"></label>
                                <span class="text-danger">*</span>
                                <select asp-for="Product.ProductCategoryID" class="form-select" asp-items="ViewBag.ProductCategoryID">
                                    <option value="">-- Select Category --</option>
                                </select>
                                <span asp-validation-for="Product.ProductCategoryID" class="text-danger"></span>
                            </div>

                            <div class="mb-3">
                                <label asp-for="Product.ProductTypeID" class="form-label">Product Type</label>
                                <select asp-for="Product.ProductTypeID" class="form-select" id="productTypeDropdown" asp-items="@(ViewData["ProductTypes"] as SelectList)">
                                    <option value="">-- Select Product Type --</option>
                                </select>
                                <span asp-validation-for="Product.ProductTypeID" class="text-danger"></span>
                            </div>

                            <div class="mb-3" id="customTypeContainer" style="display: none;">
                                <label for="customTypeInput" class="form-label">Specify Product Type</label>
                                <input type="text" class="form-control" id="customTypeInput" placeholder="Enter custom product type" maxlength="100" />
                                <small class="form-text">Enter a custom product type</small>
                            </div>

                            <div class="mb-3">
                                <label asp-for="Product.Title" class="form-label"></label>
                                <span class="text-danger">*</span>
                                <input asp-for="Product.Title" class="form-control" placeholder="e.g., Nerf Bar - Powder Coated Left" />
                                <span asp-validation-for="Product.Title" class="text-danger"></span>
                            </div>

                            <div class="mb-3">
                                <label asp-for="Variant.SKU" class="form-label"></label>
                                <span class="text-danger">*</span>
                                <input asp-for="Variant.SKU" class="form-control" placeholder="e.g., PROD-1001" />
                                <span asp-validation-for="Variant.SKU" class="text-danger"></span>
                                <small class="form-text">Must be unique</small>
                            </div>

                            <div class="mb-3">
                                <label asp-for="Product.Description" class="form-label"></label>
                                <textarea asp-for="Product.Description" class="form-control" rows="4" placeholder="Product description..."></textarea>
                                <span asp-validation-for="Product.Description" class="text-danger"></span>
                            </div>

                            <div class="mb-3">
                                <label asp-for="Product.Tags" class="form-label"></label>
                                <input asp-for="Product.Tags" class="form-control" placeholder="e.g., new, featured, sale" />
                                <span asp-validation-for="Product.Tags" class="text-danger"></span>
                                <small class="form-text">Comma-separated values</small>
                            </div>

                        </div>
                    </div>

                    <!-- SECTION 2: PRICING & INVENTORY -->
                    <div class="edit-section">
                        <div class="edit-section-header">Pricing &amp; Inventory</div>
                        <div class="edit-section-body">

                            <div class="row">
                                <div class="col-md-6 mb-3">
                                    <label asp-for="Variant.Price" class="form-label"></label>
                                    <span class="text-danger">*</span>
                                    <div class="input-group">
                                        <span class="input-group-text">$</span>
                                        <input asp-for="Variant.Price" type="number" step="0.01" class="form-control" placeholder="0.00" min="0" />
                                    </div>
                                    <span asp-validation-for="Variant.Price" class="text-danger"></span>
                                </div>

                                <div class="col-md-6 mb-3">
                                    <label asp-for="Variant.CompareAtPrice" class="form-label"></label>
                                    <div class="input-group">
                                        <span class="input-group-text">$</span>
                                        <input asp-for="Variant.CompareAtPrice" type="number" step="0.01" class="form-control" placeholder="0.00" min="0" />
                                    </div>
                                    <span asp-validation-for="Variant.CompareAtPrice" class="text-danger"></span>
                                    <small class="form-text">Original price for showing discounts</small>
                                </div>
                            </div>

                            <div class="mb-3">
                                <label asp-for="Variant.InventoryQuantity" class="form-label"></label>
                                <span class="text-danger">*</span>
                                <input asp-for="Variant.InventoryQuantity" type="number" class="form-control" placeholder="0" min="0" />
                                <span asp-validation-for="Variant.InventoryQuantity" class="text-danger"></span>
                            </div>

                            <div class="mb-3">
                                <label asp-for="Variant.InventoryPolicy" class="form-label"></label>
                                <span class="text-danger">*</span>
                                <select asp-for="Variant.InventoryPolicy" class="form-select">
                                    <option value="">-- Select Policy --</option>
                                    <option value="deny">Deny - Stop orders when out of stock</option>
                                    <option value="continue">Continue - Allow orders when out of stock</option>
                                </select>
                                <span asp-validation-for="Variant.InventoryPolicy" class="text-danger"></span>
                            </div>

                        </div>
                    </div>

                    <!-- SECTION 3: SHIPPING & PHYSICAL -->
                    <div class="edit-section">
                        <div class="edit-section-header">Shipping &amp; Physical Properties</div>
                        <div class="edit-section-body">

                            <div class="mb-3">
                                <label asp-for="Variant.Weight" class="form-label"></label>
                                <div class="row">
                                    <div class="col-md-8">
                                        <input asp-for="Variant.Weight" type="number" class="form-control" placeholder="0" id="weightInput" min="0" />
                                        <span asp-validation-for="Variant.Weight" class="text-danger"></span>
                                    </div>
                                    <div class="col-md-4">
                                        <select class="form-select" id="weightUnit" aria-label="Weight unit">
                                            <option value="grams" selected>grams</option>
                                            <option value="kg">kg</option>
                                            <option value="lb">lb</option>
                                            <option value="oz">oz</option>
                                        </select>
                                    </div>
                                </div>
                                <small class="form-text">Weight is stored in grams. Current value is in grams.</small>
                            </div>

                            <div class="mb-3">
                                <label asp-for="Variant.Barcode" class="form-label"></label>
                                <input asp-for="Variant.Barcode" class="form-control" placeholder="e.g., 123456789012" />
                                <span asp-validation-for="Variant.Barcode" class="text-danger"></span>
                            </div>

                            <div class="form-check mb-2">
                                <input asp-for="Variant.RequiresShipping" class="form-check-input" type="checkbox" />
                                <label asp-for="Variant.RequiresShipping" class="form-check-label"></label>
                            </div>

                            <div class="form-check">
                                <input asp-for="Variant.IsTaxable" class="form-check-input" type="checkbox" />
                                <label asp-for="Variant.IsTaxable" class="form-check-label"></label>
                            </div>

                        </div>
                    </div>

                    <!-- SECTION 4: ATTRIBUTES -->
                    <div class="edit-section">
                        <div class="edit-section-header">Attributes &amp; Specifications</div>
                        <div class="edit-section-body">

                            <p style="font-size:0.875rem; color:#6B7280; margin-bottom:1rem;">
                                Add attributes to describe this product (e.g., Color, Size, Material).
                            </p>

                            <div class="row mb-2 attribute-header" id="attributeHeaderRow">
                                <div class="col-md-5">
                                    <span class="attr-header-label">Attribute Name</span>
                                </div>
                                <div class="col-md-5">
                                    <span class="attr-header-label">Attribute Value</span>
                                </div>
                                <div class="col-md-2"></div>
                            </div>

                            <div id="attributesContainer">
                                <!-- Existing attributes will be loaded here by JavaScript -->
                            </div>

                            <button type="button" class="btn-add-attr" id="addAttributeBtn">
                                <i class="bi bi-plus-circle"></i> Add Attribute
                            </button>

                            <input type="hidden" id="attributeCounter" value="0" />

                        </div>
                    </div>

                    <!-- Action Buttons -->
                    <div class="d-flex justify-content-between mt-3 mb-5">
                        <a asp-action="Details" asp-route-id="@Model.Variant.VariantID" class="btn-cancel-link">Cancel</a>
                        <button type="submit" class="btn-save">Save Changes</button>
                    </div>

                </form>
            </div>

        </div>

        <!-- Side Panel -->
        <div class="col-md-4">

            <div class="side-card">
                <div class="side-card-header">Current Status</div>
                <div class="side-card-body">
                    <div style="font-size:0.8rem; color:#6B7280; margin-bottom:0.4rem;">Status</div>
                    @switch (Model.Variant.Status)
                    {
                        case ProductStatus.Draft:
                            <span class="status-pill status-draft">Draft</span>
                            break;
                        case ProductStatus.Published:
                            <span class="status-pill status-published">Published</span>
                            break;
                        case ProductStatus.Archived:
                            <span class="status-pill status-archived">Archived</span>
                            break;
                    }
                </div>
            </div>

            <div class="side-card">
                <div class="side-card-header">Tips</div>
                <div class="side-card-body">
                    <ul style="margin:0; padding-left:1.1rem; color:#4B5563; line-height:1.8; font-size:0.85rem;">
                        <li>Changes are saved immediately</li>
                        <li>Handle is auto-generated from Title</li>
                        <li>SKU must remain unique</li>
                        <li>Use attributes for specifications</li>
                    </ul>
                </div>
            </div>

        </div>
    </div>

</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <style>
        .field-validation-error {
            font-size: 0.85rem;
        }
        .input-validation-error {
            border-color: #dc3545 !important;
        }
        .field-instant-feedback {
            font-size: 0.85rem;
            margin-top: 0.25rem;
            display: block;
        }
        .field-instant-feedback.text-success {
            color: #198754 !important;
        }
        .field-instant-feedback.text-danger {
            color: #dc3545 !important;
        }
    </style>

    <script>
        // ===================================================================
        // JQUERY VALIDATE: SHOW SUMMARY ALERT + SCROLL TO FIRST ERROR
        // ===================================================================
        $(function () {
            var $form = $('form');
            var validator = $form.data('validator');
            if (validator) {
                validator.settings.invalidHandler = function (event, validatorObj) {
                    if (validatorObj.numberOfInvalids() > 0) {
                        $('#validationSummaryAlert').show();
                    }
                };
                $form.on('submit', function () {
                    if (!validator.valid()) {
                        $('#validationSummaryAlert').show();
                        var $firstError = $form.find('.field-validation-error:first');
                        if ($firstError.length) {
                            $('html, body').animate({ scrollTop: $firstError.closest('.mb-3').offset().top - 100 }, 300);
                        }
                    }
                });
            }
        });

        // ===================================================================
        // PRODUCT TYPE HYBRID DROPDOWN
        // ===================================================================
        (function () {
            const dropdown = document.getElementById('productTypeDropdown');
            const customContainer = document.getElementById('customTypeContainer');
            const customInput = document.getElementById('customTypeInput');

            if (dropdown) {
                dropdown.addEventListener('change', function () {
                    if (this.value === 'Other - Please Specify') {
                        customContainer.style.display = 'block';
                        customInput.focus();
                    } else {
                        customContainer.style.display = 'none';
                        customInput.value = '';
                    }
                });

                // On form submit, swap "Other" with the custom value
                var form = dropdown.closest('form');
                form.addEventListener('submit', function () {
                    if (dropdown.value === 'Other - Please Specify' && customInput.value.trim()) {
                        // Create a hidden input with the custom value to override the select
                        var hiddenInput = document.createElement('input');
                        hiddenInput.type = 'hidden';
                        hiddenInput.name = 'Product.Type';
                        hiddenInput.value = customInput.value.trim();
                        form.appendChild(hiddenInput);
                        // Disable the select so it doesn't submit
                        dropdown.disabled = true;
                    }
                });

                // If editing a product with a custom type, show the custom input pre-filled
                @if (ViewData["CustomType"] != null)
                {
                    <text>
                    customContainer.style.display = 'block';
                    customInput.value = '@ViewData["CustomType"]';
                    </text>
                }

                // If dropdown already shows "Other" on page load (validation error re-render)
                if (dropdown.value === 'Other - Please Specify') {
                    customContainer.style.display = 'block';
                }
            }
        })();

        // ===================================================================
        // LOAD EXISTING ATTRIBUTES ON PAGE LOAD
        // ===================================================================

        let attributeCounter = 0;
        let existingAttributes = @Html.Raw(Json.Serialize(Model.Attributes));

        window.addEventListener('DOMContentLoaded', function() {
            if (existingAttributes && existingAttributes.length > 0) {
                existingAttributes.forEach(function(attr) {
                    addAttributeRow(attr.attributeName, attr.attributeValue);
                });
            }
            initializeTooltips();
        });

        // ===================================================================
        // DYNAMIC ATTRIBUTES SYSTEM
        // ===================================================================
        const PREDEFINED_ATTRIBUTES = [
            'Size', 'Color', 'Material', 'Position', 'Finish',
            'Weight', 'Diameter', 'Width', 'Thread Type', 'Bolt Form',
            'Nut Form', 'Compound', 'Design', 'Condition', 'Power Source'
        ];
        const OTHER_SENTINEL = '__OTHER__';

        document.getElementById('addAttributeBtn').addEventListener('click', function() {
            addAttributeRow();
        });

        function addAttributeRow(name = '', value = '') {
            const container = document.getElementById('attributesContainer');
            const index = attributeCounter;

            // Determine if name is predefined or custom
            const isPredefined = PREDEFINED_ATTRIBUTES.includes(name);
            const isOther = (name !== '' && !isPredefined);

            // Build option tags
            let optionsHtml = '<option value="">-- Select Attribute --</option>';
            PREDEFINED_ATTRIBUTES.forEach(function(attr) {
                const selected = (isPredefined && attr === name) ? ' selected' : '';
                optionsHtml += '<option value="' + attr + '"' + selected + '>' + attr + '</option>';
            });
            const otherSelected = isOther ? ' selected' : '';
            optionsHtml += '<option value="' + OTHER_SENTINEL + '"' + otherSelected + '>Other - Specify Your Own</option>';

            const customDisplay = isOther ? 'block' : 'none';
            const customValue = isOther ? name : '';

            const rowHtml = `
                <div class="row mb-3 attribute-row" id="attributeRow${index}">
                    <div class="col-md-5">
                        <label for="attrNameSelect${index}" class="visually-hidden">Attribute Name ${index + 1}</label>
                        <select id="attrNameSelect${index}"
                                name="Attributes[${index}].AttributeName"
                                class="form-select attribute-name-select"
                                aria-label="Attribute Name"
                                data-index="${index}"
                                onchange="onAttributeSelectChange(${index})">
                            ${optionsHtml}
                        </select>
                        <div id="customAttrContainer${index}" style="display: ${customDisplay}; margin-top: 0.5rem;">
                            <input type="text"
                                   id="customAttrInput${index}"
                                   class="form-control"
                                   placeholder="Enter custom attribute name"
                                   value="${customValue}"
                                   maxlength="100" />
                        </div>
                        <input type="hidden" name="Attributes[${index}].DisplayOrder" value="${index}" />
                        <input type="hidden" name="Attributes[${index}].IsVariantAttribute" value="false" />
                    </div>
                    <div class="col-md-5">
                        <label for="attrValue${index}" class="visually-hidden">Attribute Value ${index + 1}</label>
                        <input type="text"
                               id="attrValue${index}"
                               name="Attributes[${index}].AttributeValue"
                               class="form-control"
                               aria-label="Attribute Value"
                               placeholder="e.g., Powder Coated Steel"
                               value="${value}" />
                    </div>
                    <div class="col-md-2">
                        <button type="button" class="btn btn-outline-dark btn-sm w-100"
                                aria-label="Remove attribute ${index + 1}"
                                onclick="removeAttributeRow(${index})">
                            Remove
                        </button>
                    </div>
                </div>
            `;

            container.insertAdjacentHTML('beforeend', rowHtml);
            attributeCounter++;
            document.getElementById('attributeCounter').value = attributeCounter;
            updateAttributeDropdowns();
            initializeTooltips();
        }

        function removeAttributeRow(index) {
            const row = document.getElementById('attributeRow' + index);
            if (row) {
                row.remove();
                updateAttributeDropdowns();
            }
        }

        function onAttributeSelectChange(index) {
            const select = document.getElementById('attrNameSelect' + index);
            const customContainer = document.getElementById('customAttrContainer' + index);
            const customInput = document.getElementById('customAttrInput' + index);

            if (select.value === OTHER_SENTINEL) {
                customContainer.style.display = 'block';
                customInput.focus();
            } else {
                customContainer.style.display = 'none';
                customInput.value = '';
            }
            updateAttributeDropdowns();
        }

        function updateAttributeDropdowns() {
            var allSelects = document.querySelectorAll('.attribute-name-select');
            var selectedValues = [];

            allSelects.forEach(function(sel) {
                if (sel.value && sel.value !== OTHER_SENTINEL) {
                    selectedValues.push(sel.value);
                }
            });

            allSelects.forEach(function(sel) {
                var currentValue = sel.value;
                var options = sel.querySelectorAll('option');

                options.forEach(function(opt) {
                    if (opt.value === '' || opt.value === OTHER_SENTINEL) {
                        opt.disabled = false;
                    } else if (opt.value === currentValue) {
                        opt.disabled = false;
                    } else {
                        opt.disabled = selectedValues.indexOf(opt.value) !== -1;
                    }
                });
            });
        }

        // On form submit: swap __OTHER__ with actual custom values
        document.querySelector('form').addEventListener('submit', function(e) {
            var allSelects = document.querySelectorAll('.attribute-name-select');

            allSelects.forEach(function(sel) {
                if (sel.value === OTHER_SENTINEL) {
                    var index = sel.getAttribute('data-index');
                    var customInput = document.getElementById('customAttrInput' + index);
                    var customValue = customInput ? customInput.value.trim() : '';

                    if (customValue) {
                        var hiddenInput = document.createElement('input');
                        hiddenInput.type = 'hidden';
                        hiddenInput.name = sel.name;
                        hiddenInput.value = customValue;
                        sel.closest('form').appendChild(hiddenInput);
                        sel.disabled = true;
                    }
                }
            });
        });

        function initializeTooltips() {
            var tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'));
            tooltipTriggerList.map(function (tooltipTriggerEl) {
                return new bootstrap.Tooltip(tooltipTriggerEl);
            });
        }

        // ===================================================================
        // WEIGHT UNIT CONVERSION (For Edit, weight is already in grams)
        // ===================================================================

        document.querySelector('form').addEventListener('submit', function(e) {
            const weightInput = document.getElementById('weightInput');
            const weightUnit = document.getElementById('weightUnit');

            if (weightInput && weightInput.value && weightUnit.value !== 'grams') {
                let weightInGrams = parseFloat(weightInput.value);

                switch(weightUnit.value) {
                    case 'kg':
                        weightInGrams = weightInGrams * 1000;
                        break;
                    case 'lb':
                        weightInGrams = weightInGrams * 453.592;
                        break;
                    case 'oz':
                        weightInGrams = weightInGrams * 28.3495;
                        break;
                }

                weightInput.value = Math.round(weightInGrams);
            }
        });

        // ===================================================================
        // EXTRA CLIENT-SIDE VALIDATION (SKU format, uniqueness, negatives)
        // Required fields + summary are handled by jQuery Validate above.
        // ===================================================================
        (function () {
            const currentVariantId = @Model.Variant.VariantID;

            // --- Helpers ---
            function getOrCreateFeedback(input) {
                const id = 'instant-' + input.id;
                let el = document.getElementById(id);
                if (!el) {
                    el = document.createElement('div');
                    el.id = id;
                    el.className = 'field-instant-feedback';
                    const parent = input.closest('.mb-3') || input.closest('.col-md-6');
                    if (parent) {
                        parent.appendChild(el);
                    } else {
                        input.parentNode.insertBefore(el, input.nextSibling);
                    }
                }
                return el;
            }

            function showError(input, message) {
                const fb = getOrCreateFeedback(input);
                fb.textContent = message;
                fb.className = 'field-instant-feedback text-danger';
            }

            function clearFeedback(input) {
                const fb = document.getElementById('instant-' + input.id);
                if (fb) { fb.textContent = ''; fb.className = 'field-instant-feedback'; }
            }

            // --- Negative value detection on input ---
            const numericFields = [
                { id: 'Variant_Price', name: 'Price' },
                { id: 'Variant_CompareAtPrice', name: 'Compare At Price' },
                { id: 'Variant_InventoryQuantity', name: 'Inventory Quantity' },
                { id: 'weightInput', name: 'Weight' }
            ];

            numericFields.forEach(function (field) {
                const input = document.getElementById(field.id);
                if (!input) return;

                input.addEventListener('input', function () {
                    const val = parseFloat(this.value);
                    if (!isNaN(val) && val < 0) {
                        showError(this, field.name + ' cannot be negative. Please enter a positive value.');
                    } else {
                        clearFeedback(this);
                    }
                });
            });

            // --- SKU format + uniqueness validation ---
            const skuPattern = /^[A-Z]{2,4}-\d{3,7}(-[A-Z]{1,3})?$/;
            let skuTimer = null;
            const skuInput = document.getElementById('Variant_SKU');
            if (skuInput) {
                skuInput.addEventListener('input', function () {
                    const val = this.value.trim();
                    if (!val) { clearFeedback(this); return; }

                    // Auto-uppercase
                    const cursorPos = this.selectionStart;
                    this.value = this.value.toUpperCase();
                    this.setSelectionRange(cursorPos, cursorPos);

                    if (!skuPattern.test(val.toUpperCase())) {
                        showError(this, 'SKU must follow format: AB-123 or ABC-1234-XY (letters-numbers or letters-numbers-letters)');
                    } else {
                        clearFeedback(this);
                    }
                });

                skuInput.addEventListener('blur', function () {
                    const val = this.value.trim();
                    if (!val || !skuPattern.test(val)) return;

                    clearTimeout(skuTimer);
                    skuTimer = setTimeout(function () {
                        fetch('/ProductVariants/CheckSku?sku=' + encodeURIComponent(val) + '&variantId=' + currentVariantId)
                            .then(function (r) { return r.json(); })
                            .then(function (data) {
                                if (!data.isAvailable) {
                                    showError(skuInput, 'This SKU is already in use. Please choose a unique SKU.');
                                } else {
                                    clearFeedback(skuInput);
                                }
                            })
                            .catch(function () { });
                    }, 500);
                });
            }

            // --- Title uniqueness check (debounced, excludes current variant) ---
            let titleTimer = null;
            const titleInput = document.getElementById('Variant_Title');
            if (titleInput) {
                titleInput.addEventListener('blur', function () {
                    const val = this.value.trim();
                    if (!val) return;

                    clearTimeout(titleTimer);
                    titleTimer = setTimeout(function () {
                        fetch('/ProductVariants/CheckTitle?title=' + encodeURIComponent(val) + '&variantId=' + currentVariantId)
                            .then(function (r) { return r.json(); })
                            .then(function (data) {
                                if (!data.isAvailable) {
                                    showError(titleInput, 'A product with this title already exists. Please use a different title.');
                                } else {
                                    clearFeedback(titleInput);
                                }
                            })
                            .catch(function () { });
                    }, 500);
                });
            }
        })();
    </script>
}
