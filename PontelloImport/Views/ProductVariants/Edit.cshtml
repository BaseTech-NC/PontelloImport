    function optSelectChange(sel, idx, optNum) {
        const cell = sel.closest('td');
        const newInput = document.getElementById('optNew_' + idx + '_' + optNum);
        const hidden = cell ? cell.querySelector('input[type=hidden]') : null;
        if (sel.value === '__new__') {
            if (newInput) { newInput.style.display = ''; newInput.focus(); }
            if (hidden) hidden.value = '';
        } else {
            if (newInput) newInput.style.display = 'none';
            if (hidden) hidden.value = sel.value;
        }
    }

    function syncOptVal(inp, idx, optNum) {
