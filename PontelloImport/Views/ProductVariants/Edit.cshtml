    <script>
    // ── Ids for AJAX checks ────────────────────────────────────────────────────
    const currentProductId = @Model.ProductID;
    const currentVariantId = @Model.SimpleVariantID;   // 0 for variant products

    // ── Title uniqueness AJAX check ────────────────────────────────────────────
    function getOrCreateFeedback(input, id) {
        let el = document.getElementById(id);
        if (!el) {
            el = document.createElement('span');
            el.id = id;
            el.className = 'small';
            input.parentNode.insertBefore(el, input.nextSibling);
        }
        return el;
    }

    const titleInput = document.getElementById('titleInput');
    if (titleInput) {
        let titleTimer = null;
        titleInput.addEventListener('blur', function () {
            const val = this.value.trim();
            const fb  = document.getElementById('title-ajax-msg');
            if (!val || !fb) return;
            clearTimeout(titleTimer);
            titleTimer = setTimeout(function () {
                fetch('/ProductVariants/CheckTitle?title=' + encodeURIComponent(val) + '&excludeId=' + currentProductId)
                    .then(r => r.json())
                    .then(data => {
                        if (!data.available) {
                            fb.textContent = 'A product with this title already exists.';
                            fb.className = 'small text-danger';
                        } else {
                            fb.textContent = '';
                        }
                    })
                    .catch(() => {});
            }, 400);
        });
    }

    // ── SKU uniqueness AJAX check (simple product path) ────────────────────────
    const skuInput = document.getElementById('skuInput');
    if (skuInput) {
