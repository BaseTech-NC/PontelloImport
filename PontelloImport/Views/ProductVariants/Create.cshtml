@model PontelloImport.Models.QuickCreateViewModel

@{
    Layout = "~/Views/Admin/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Add Product";
}

<style>
    *, *::before, *::after { font-family: Inter, system-ui, sans-serif; }

    .create-section {
        background: #ffffff;
        border: 1px solid #E5E7EB;
        border-radius: 12px;
        margin-bottom: 1.25rem;
        overflow: hidden;
    }

    .create-section-header {
        background: #F8FAFC;
        border-bottom: 1px solid #E5E7EB;
        padding: 0.875rem 1.25rem;
        font-weight: 600;
        font-size: 0.875rem;
        color: #374151;
        letter-spacing: 0.01em;
    }

    .create-section-body {
        padding: 1.25rem;
    }

    .form-label {
        font-size: 0.875rem;
        font-weight: 500;
        color: #374151;
        margin-bottom: 0.35rem;
    }

    .form-control, .form-select {
        font-size: 0.875rem;
        border-color: #D1D5DB;
        border-radius: 8px;
    }

    .form-control:focus, .form-select:focus {
        border-color: #2563EB;
        box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.12);
    }

    .input-group-text {
        background: #F8FAFC;
        border-color: #D1D5DB;
        font-size: 0.875rem;
        color: #6B7280;
    }

    .form-text {
        font-size: 0.8rem;
        color: #9CA3AF;
    }

    .optional-label {
        font-size: 0.75rem;
        color: #9CA3AF;
        font-weight: 400;
        margin-left: 0.3rem;
    }

    .btn-create {
        background: #111827;
        color: #ffffff;
        border: none;
        border-radius: 8px;
        font-size: 0.875rem;
        font-weight: 500;
        padding: 0.5rem 1.75rem;
        cursor: pointer;
        transition: background 150ms;
    }

    .btn-create:hover { background: #374151; color: #ffffff; }

    .btn-cancel-link {
        color: #6B7280;
        border: 1px solid #E5E7EB;
        background: transparent;
        border-radius: 8px;
        font-size: 0.875rem;
        font-weight: 500;
        padding: 0.5rem 1.1rem;
        text-decoration: none;
        transition: background 150ms;
        display: inline-block;
    }

    .btn-cancel-link:hover { background: #F3F4F6; color: #374151; }

    .option-hint {
        background: #F0F9FF;
        border: 1px solid #BAE6FD;
        border-radius: 8px;
        padding: 0.75rem 1rem;
        font-size: 0.82rem;
        color: #0369A1;
        margin-bottom: 1rem;
    }
</style>

<div class="container-fluid mt-4" style="max-width: 680px;">

    <div class="mb-4">
        <a asp-action="Index" style="color:#6B7280; font-size:0.875rem; text-decoration:none;">← Back to Product Catalogue</a>
    </div>

    <div class="mb-4">
        <div style="font-size:1.15rem; font-weight:700; color:#111827;">Add Product</div>
        <div style="font-size:0.875rem; color:#6B7280; margin-top:0.2rem;">
            Fields marked <span class="text-danger">*</span> are required.
        </div>
    </div>

    @if (!ViewData.ModelState.IsValid)
    {
        <div class="alert alert-danger alert-dismissible fade show mb-3" role="alert">
            <strong>Please fix the errors below:</strong>
            <div asp-validation-summary="All" class="mt-1 mb-0 small"></div>
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <form asp-action="Create" method="post">
        @Html.AntiForgeryToken()

        <!-- SECTION 1: PRODUCT INFO -->
        <div class="create-section">
            <div class="create-section-header">Product Info</div>
            <div class="create-section-body">

                <div class="mb-3">
                    <label asp-for="ProductTitle" class="form-label">Product Title <span class="text-danger">*</span></label>
                    <input asp-for="ProductTitle" class="form-control" placeholder="e.g., Safety Helmet Full-Face" autofocus />
                    <span asp-validation-for="ProductTitle" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="VendorID" class="form-label">Vendor <span class="text-danger">*</span></label>
                    <select asp-for="VendorID" class="form-select" asp-items="ViewBag.VendorID">
                        <option value="0">-- Select Vendor --</option>
                    </select>
                    <span asp-validation-for="VendorID" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="ProductCategoryID" class="form-label">Category <span class="text-danger">*</span></label>
                    <select asp-for="ProductCategoryID" class="form-select" asp-items="ViewBag.ProductCategoryID">
                        <option value="0">-- Select Category --</option>
                    </select>
                    <span asp-validation-for="ProductCategoryID" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="ProductTypeID" class="form-label">
                        Product Type <span class="optional-label">(optional)</span>
                    </label>
                    <select asp-for="ProductTypeID" class="form-select" asp-items="@(ViewData["ProductTypes"] as SelectList)">
                        <option value="">-- None --</option>
                    </select>
                </div>

                <div class="mb-3">
                    <label asp-for="Status" class="form-label">Status <span class="text-danger">*</span></label>
                    <select asp-for="Status" class="form-select">
                        <option value="@ProductStatus.Draft">Draft</option>
                        <option value="@ProductStatus.Published">Published</option>
                        <option value="@ProductStatus.Unlisted">Unlisted</option>
                    </select>
                </div>

            </div>
        </div>

        <!-- SECTION 2: VARIANT INFO -->
        <div class="create-section">
            <div class="create-section-header">Variant Info</div>
            <div class="create-section-body">

                <div class="mb-3">
                    <label asp-for="SKU" class="form-label">SKU <span class="text-danger">*</span></label>
                    <input asp-for="SKU" class="form-control" placeholder="e.g., CRG-3001" />
                    <span asp-validation-for="SKU" class="text-danger small"></span>
                    <small class="form-text">Format: AA-000 &nbsp;e.g. CRG-3001</small>
                </div>

                <div class="mb-3">
                    <label asp-for="Price" class="form-label">Price <span class="text-danger">*</span></label>
                    <div class="input-group">
                        <span class="input-group-text">$</span>
                        <input asp-for="Price" type="number" step="0.01" min="0.01" class="form-control" placeholder="0.00" />
                    </div>
                    <span asp-validation-for="Price" class="text-danger small"></span>
                    <small class="form-text">CAD, e.g. 89.99</small>
                </div>

                <div class="mb-3">
                    <label asp-for="InventoryQuantity" class="form-label">Inventory Quantity <span class="text-danger">*</span></label>
                    <input asp-for="InventoryQuantity" type="number" min="0" class="form-control" placeholder="0" />
                    <span asp-validation-for="InventoryQuantity" class="text-danger small"></span>
                </div>

            </div>
        </div>

        <!-- SECTION 3: OPTION (optional) -->
        <div class="create-section">
            <div class="create-section-header">Option <span class="optional-label" style="font-weight:400;">(optional)</span></div>
            <div class="create-section-body">

                <div class="option-hint">
                    Leave blank for single-variant products. The variant will automatically be set to "Default Title".
                </div>

                <div class="row">
                    <div class="col-6 mb-3">
                        <label asp-for="Option1Name" class="form-label">Option Name</label>
                        <input asp-for="Option1Name" class="form-control" placeholder="e.g. Color, Size" />
                    </div>
                    <div class="col-6 mb-3">
                        <label asp-for="Option1Value" class="form-label">Option Value</label>
                        <input asp-for="Option1Value" class="form-control" placeholder="e.g. Black, Medium" />
                    </div>
                </div>

            </div>
        </div>

        <!-- Buttons -->
        <div class="d-flex justify-content-between mt-3 mb-5">
            <a asp-action="Index" class="btn-cancel-link">Cancel</a>
            <button type="submit" class="btn-create">Save Product</button>
        </div>

    </form>

</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script>
        // Auto-uppercase SKU as user types
        const skuInput = document.getElementById('SKU');
        if (skuInput) {
            skuInput.addEventListener('input', function () {
                const pos = this.selectionStart;
                this.value = this.value.toUpperCase();
                this.setSelectionRange(pos, pos);
            });
        }
    </script>
}
