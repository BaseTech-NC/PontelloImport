    // ── Quick-add Category ────────────────────────────────────────────────────
    document.getElementById('saveCategoryBtn')?.addEventListener('click', async function () {
        const nameEl  = document.getElementById('newCategoryName');
        const errEl   = document.getElementById('newCategoryError');
        const name    = nameEl.value.trim();
        errEl.style.display = 'none';
        if (!name) { errEl.textContent = 'Category name is required.'; errEl.style.display = 'block'; return; }
        this.disabled = true;
        try {
            const res  = await fetch('/ProductVariants/QuickAddCategory', {
                method: 'POST',
                headers: { 'Content-Type': 'application/x-www-form-urlencoded', 'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value ?? '' },
                body: 'name=' + encodeURIComponent(name)
            });
            const data = await res.json();
            if (!data.success) { errEl.textContent = data.error; errEl.style.display = 'block'; return; }
            const sel = document.getElementById('categorySelect');
            const opt = document.createElement('option');
            opt.value = data.id; opt.textContent = data.name; opt.selected = true;
            sel.appendChild(opt);
            sel.value = data.id;
            nameEl.value = '';
            bootstrap.Modal.getInstance(document.getElementById('addCategoryModal'))?.hide();
        } catch { errEl.textContent = 'An error occurred. Please try again.'; errEl.style.display = 'block'; }
        finally { this.disabled = false; }
    });

    // Enter key submits category modal
    document.getElementById('newCategoryName')?.addEventListener('keydown', function (e) {
        if (e.key === 'Enter') { e.preventDefault(); document.getElementById('saveCategoryBtn')?.click(); }
    });

