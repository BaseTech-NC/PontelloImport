@model PontelloImport.Models.CreateProductViewModel

@{
    Layout = "~/Views/Admin/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Create Product";
    }

<div class="container mt-4">
    <!-- Header -->
    <div class="row mb-4">
        <div class="col-12">
            <h1 class="h2">Create New Product</h1>
            <p class="text-muted">Fill in the product details below. Fields marked with <span class="text-danger">*</span> are required.</p>
        </div>
    </div>

    <!-- Form -->
    <div class="row">
        <div class="col-md-8">
            @if (TempData["Error"] != null)
                {
                <div class="alert alert-secondary alert-dismissible fade show" role="alert">
                    @TempData["Error"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
                }

            <form asp-action="Create" method="post">

                @if (!ViewData.ModelState.IsValid)
                {
                <div class="alert alert-dark alert-dismissible fade show" role="alert">
                    <strong>Please correct the following errors:</strong>
                    <div asp-validation-summary="All" class="mt-2 mb-0"></div>
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
                }

                <!-- CARD 1: BASIC INFORMATION -->
                <div class="card mb-3">
                    <div class="card-header bg-dark text-white">
                        <h5 class="mb-0">Basic Information</h5>
                    </div>
                    <div class="card-body">
                        <!-- Vendor Dropdown -->
                        <div class="mb-3">
                            <label asp-for="Product.VendorID" class="form-label"></label>
                            <span class="text-danger">*</span>
                            <select asp-for="Product.VendorID" class="form-select" asp-items="ViewBag.VendorID">
                                <option value="">-- Select Vendor --</option>
                            </select>
                            <span asp-validation-for="Product.VendorID" class="text-danger"></span>
                        </div>

                        <!-- Category Dropdown -->
                        <div class="mb-3">
                            <label asp-for="Product.ProductCategoryID" class="form-label"></label>
                            <span class="text-danger">*</span>
                            <select asp-for="Product.ProductCategoryID" class="form-select" asp-items="ViewBag.ProductCategoryID">
                                <option value="">-- Select Category --</option>
                            </select>
                            <span asp-validation-for="Product.ProductCategoryID" class="text-danger"></span>
                        </div>

                        <!-- Type Field (Hybrid Dropdown) -->
                        <div class="mb-3">
                            <label asp-for="Product.Type" class="form-label">Product Type</label>
                            <select asp-for="Product.Type" class="form-select" id="productTypeDropdown" asp-items="@(ViewData["ProductTypes"] as SelectList)">
                                <option value="">-- Select Product Type --</option>
                            </select>
                            <span asp-validation-for="Product.Type" class="text-danger"></span>
                        </div>

                        <!-- Custom type input (hidden by default) -->
                        <div class="mb-3" id="customTypeContainer" style="display: none;">
                            <label for="customTypeInput" class="form-label">Specify Product Type</label>
                            <input type="text" class="form-control" id="customTypeInput" placeholder="Enter custom product type" maxlength="100" />
                            <small class="form-text text-muted">Enter a custom product type</small>
                        </div>

                        <!-- Title -->
                        <div class="mb-3">
                            <label asp-for="Variant.Title" class="form-label"></label>
                            <span class="text-danger">*</span>
                            <input asp-for="Variant.Title" class="form-control" placeholder="e.g., Floor Pan Bolt Kit" />
                            <span asp-validation-for="Variant.Title" class="text-danger"></span>
                        </div>

                        <!-- SKU -->
                        <div class="mb-3">
                            <label asp-for="Variant.SKU" class="form-label"></label>
                            <span class="text-danger">*</span>
                            <input asp-for="Variant.SKU" class="form-control" placeholder="e.g., PROD-1001" />
                            <span asp-validation-for="Variant.SKU" class="text-danger"></span>
                            <small class="form-text text-muted">Must be unique</small>
                        </div>

                        <!-- Description -->
                        <div class="mb-3">
                            <label asp-for="Variant.Description" class="form-label"></label>
                            <textarea asp-for="Variant.Description" class="form-control" rows="4" placeholder="Product description..."></textarea>
                            <span asp-validation-for="Variant.Description" class="text-danger"></span>
                        </div>

                        <!-- Tags -->
                        <div class="mb-3">
                            <label asp-for="Variant.Tags" class="form-label"></label>
                            <input asp-for="Variant.Tags" class="form-control" placeholder="e.g., new, featured, sale" />
                            <span asp-validation-for="Variant.Tags" class="text-danger"></span>
                            <small class="form-text text-muted">Comma-separated values</small>
                        </div>
                    </div>
                </div>

                <!-- CARD 2: PRICING & INVENTORY -->
                <div class="card mb-3">
                    <div class="card-header bg-dark text-white">
                        <h5 class="mb-0">Pricing & Inventory</h5>
                    </div>
                    <div class="card-body">
                        <!-- Price -->
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="Variant.Price" class="form-label"></label>
                                <span class="text-danger">*</span>
                                <div class="input-group">
                                    <span class="input-group-text">$</span>
                                    <input asp-for="Variant.Price" class="form-control" placeholder="0.00" step="0.01" min="0" />
                                </div>
                                <span asp-validation-for="Variant.Price" class="text-danger"></span>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label asp-for="Variant.CompareAtPrice" class="form-label"></label>
                                <div class="input-group">
                                    <span class="input-group-text">$</span>
                                    <input asp-for="Variant.CompareAtPrice" class="form-control" placeholder="0.00" step="0.01" min="0" />
                                </div>
                                <span asp-validation-for="Variant.CompareAtPrice" class="text-danger"></span>
                                <small class="form-text text-muted">Original price (optional)</small>
                            </div>
                        </div>

                        <!-- Inventory -->
                        <div class="mb-3">
                            <label asp-for="Variant.InventoryQuantity" class="form-label"></label>
                            <span class="text-danger">*</span>
                            <input asp-for="Variant.InventoryQuantity" class="form-control" type="number" placeholder="0" min="0" />
                            <span asp-validation-for="Variant.InventoryQuantity" class="text-danger"></span>
                        </div>

                        <!-- Weight -->
                        <div class="mb-3">
                            <label asp-for="Variant.Weight" class="form-label"></label>
                            <div class="input-group">
                                <input asp-for="Variant.Weight" id="weightInput" class="form-control" type="number" step="0.01" placeholder="0" min="0" />
                                <select id="weightUnit" class="form-select" aria-label="Weight unit" style="max-width: 100px;">
                                    <option value="g" selected>grams</option>
                                    <option value="kg">kg</option>
                                    <option value="lb">lb</option>
                                    <option value="oz">oz</option>
                                </select>
                            </div>
                            <span asp-validation-for="Variant.Weight" class="text-danger"></span>
                            <small class="form-text text-muted">Weight will be converted to grams</small>
                        </div>

                        <!-- Barcode -->
                        <div class="mb-3">
                            <label asp-for="Variant.Barcode" class="form-label"></label>
                            <input asp-for="Variant.Barcode" class="form-control" placeholder="e.g., 123456789012" />
                            <span asp-validation-for="Variant.Barcode" class="text-danger"></span>
                        </div>
                    </div>
                </div>

                <!-- CARD 3: SHIPPING & TAX -->
                <div class="card mb-3">
                    <div class="card-header bg-secondary text-white">
                        <h5 class="mb-0">Shipping & Tax</h5>
                    </div>
                    <div class="card-body">
                        <div class="form-check mb-3">
                            <input asp-for="Variant.RequiresShipping" class="form-check-input" type="checkbox" checked />
                            <label asp-for="Variant.RequiresShipping" class="form-check-label"></label>
                        </div>

                        <div class="form-check mb-3">
                            <input asp-for="Variant.IsTaxable" class="form-check-input" type="checkbox" checked />
                            <label asp-for="Variant.IsTaxable" class="form-check-label"></label>
                        </div>
                    </div>
                </div>

                <!-- CARD 4: ATTRIBUTES -->
                <div class="card mb-3">
                    <div class="card-header bg-secondary text-white">
                        <h5 class="mb-0">Product Attributes</h5>
                    </div>
                    <div class="card-body">
                        <p class="text-muted">Add custom attributes like Color, Size, Material, etc.</p>

                        <div class="row mb-2 attribute-header" id="attributeHeaderRow">
                            <div class="col-md-4">
                                <span class="form-label fw-semibold">Attribute Name</span>
                            </div>
                            <div class="col-md-4">
                                <span class="form-label fw-semibold">Attribute Value</span>
                            </div>
                            <div class="col-md-2">
                                <span class="form-label fw-semibold">Variant?</span>
                            </div>
                            <div class="col-md-2"></div>
                        </div>

                        <div id="attributesContainer">
                            <!-- Attributes will be added here dynamically -->
                        </div>

                        <button type="button" id="addAttributeBtn" class="btn btn-outline-secondary btn-sm mt-2">
                            + Add Attribute
                        </button>

                        <input type="hidden" id="attributeCounter" value="0" />
                    </div>
                </div>

                <!-- SUBMIT BUTTONS -->
                <div class="card">
                    <div class="card-body">
                        <div class="d-flex justify-content-between">
                            <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                            <button type="submit" class="btn btn-dark btn-lg">Review Product</button>
                        </div>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>

    @section Scripts {
        @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
        }

    <style>
        .field-validation-error {
            font-size: 0.85rem;
        }
        .input-validation-error {
            border-color: #dc3545 !important;
        }
        .field-instant-feedback {
            font-size: 0.85rem;
            margin-top: 0.25rem;
            display: block;
        }
        .field-instant-feedback.text-success {
            color: #198754 !important;
        }
        .field-instant-feedback.text-danger {
            color: #dc3545 !important;
        }
    </style>

    <script>
        // ===================================================================
        // PRODUCT TYPE HYBRID DROPDOWN
        // ===================================================================
        (function () {
            const dropdown = document.getElementById('productTypeDropdown');
            const customContainer = document.getElementById('customTypeContainer');
            const customInput = document.getElementById('customTypeInput');

            if (dropdown) {
                dropdown.addEventListener('change', function () {
                    if (this.value === 'Other - Please Specify') {
                        customContainer.style.display = 'block';
                        customInput.focus();
                    } else {
                        customContainer.style.display = 'none';
                        customInput.value = '';
                    }
                });

                // On form submit, swap "Other" with the custom value
                var form = dropdown.closest('form');
                form.addEventListener('submit', function () {
                    if (dropdown.value === 'Other - Please Specify' && customInput.value.trim()) {
                        // Create a hidden input with the custom value to override the select
                        var hiddenInput = document.createElement('input');
                        hiddenInput.type = 'hidden';
                        hiddenInput.name = 'Product.Type';
                        hiddenInput.value = customInput.value.trim();
                        form.appendChild(hiddenInput);
                        // Disable the select so it doesn't submit
                        dropdown.disabled = true;
                    }
                });

                // If dropdown already shows "Other" on page load (validation error re-render)
                if (dropdown.value === 'Other - Please Specify') {
                    customContainer.style.display = 'block';
                }
            }
        })();

        // ===================================================================
        // DYNAMIC ATTRIBUTES SYSTEM
        // ===================================================================
        let attributeCounter = 0;

        document.getElementById('addAttributeBtn').addEventListener('click', function() {
            addAttributeRow();
        });

        function addAttributeRow(name = '', value = '', isVariant = false) {
            const container = document.getElementById('attributesContainer');
            const index = attributeCounter;

            const rowHtml = `
                <div class="row mb-3 attribute-row" id="attributeRow${index}">
                    <div class="col-md-4">
                        <label for="attrName${index}" class="visually-hidden">Attribute Name ${index + 1}</label>
                        <input type="text"
                               id="attrName${index}"
                               name="Attributes[${index}].AttributeName"
                               class="form-control"
                               aria-label="Attribute Name"
                               placeholder="e.g., Material, Color, Size"
                               value="${name}" />
                        <input type="hidden" name="Attributes[${index}].DisplayOrder" value="${index}" />
                    </div>
                    <div class="col-md-4">
                        <label for="attrValue${index}" class="visually-hidden">Attribute Value ${index + 1}</label>
                        <input type="text"
                               id="attrValue${index}"
                               name="Attributes[${index}].AttributeValue"
                               class="form-control"
                               aria-label="Attribute Value"
                               placeholder="e.g., Powder Coated Steel"
                               value="${value}" />
                    </div>
                    <div class="col-md-2">
                        <div class="form-check mt-2">
                            <input type="checkbox"
                                   id="attrIsVariant${index}"
                                   name="Attributes[${index}].IsVariantAttribute"
                                   class="form-check-input"
                                   value="true"
                                   ${isVariant ? 'checked' : ''} />
                            <label class="form-check-label small" for="attrIsVariant${index}">Is Variant Attribute</label>
                            <input type="hidden" name="Attributes[${index}].IsVariantAttribute" value="false" />
                        </div>
                    </div>
                    <div class="col-md-2">
                        <button type="button" class="btn btn-outline-dark btn-sm w-100"
                                aria-label="Remove attribute ${index + 1}"
                                onclick="removeAttributeRow(${index})">
                            Remove
                        </button>
                    </div>
                </div>
            `;

            container.insertAdjacentHTML('beforeend', rowHtml);
            attributeCounter++;
            document.getElementById('attributeCounter').value = attributeCounter;
        }

        function removeAttributeRow(index) {
            const row = document.getElementById('attributeRow' + index);
            if (row) {
                row.remove();
            }
        }

        // ===================================================================
        // WEIGHT UNIT CONVERSION
        // ===================================================================
        document.querySelector('form').addEventListener('submit', function(e) {
            const weightInput = document.getElementById('weightInput');
            const weightUnit = document.getElementById('weightUnit');

            if (weightInput && weightInput.value) {
                let weightInGrams = parseFloat(weightInput.value);

                switch(weightUnit.value) {
                    case 'kg':
                        weightInGrams = weightInGrams * 1000;
                        break;
                    case 'lb':
                        weightInGrams = weightInGrams * 453.592;
                        break;
                    case 'oz':
                        weightInGrams = weightInGrams * 28.3495;
                        break;
                }

                weightInput.value = Math.round(weightInGrams);
            }
        });

        // ===================================================================
        // INSTANT CLIENT-SIDE VALIDATION
        // ===================================================================
        (function () {
            // --- Helpers ---
            function getOrCreateFeedback(input) {
                const id = 'instant-' + input.id;
                let el = document.getElementById(id);
                if (!el) {
                    el = document.createElement('div');
                    el.id = id;
                    el.className = 'field-instant-feedback';
                    const parent = input.closest('.mb-3') || input.closest('.col-md-6');
                    if (parent) {
                        parent.appendChild(el);
                    } else {
                        input.parentNode.insertBefore(el, input.nextSibling);
                    }
                }
                return el;
            }

            function showError(input, message) {
                input.classList.add('is-invalid');
                input.classList.remove('is-valid');
                const fb = getOrCreateFeedback(input);
                fb.textContent = message;
                fb.className = 'field-instant-feedback text-danger';
            }

            function clearFeedback(input) {
                input.classList.remove('is-invalid', 'is-valid');
                const fb = document.getElementById('instant-' + input.id);
                if (fb) { fb.textContent = ''; fb.className = 'field-instant-feedback'; }
            }

            // --- Required field validation on blur ---
            // For text fields, empty means no value. For number fields (Price),
            // empty string means the user cleared it.
            const requiredFields = [
                { id: 'Variant_Title', name: 'Product Title' },
                { id: 'Variant_SKU', name: 'SKU' },
                { id: 'Variant_Price', name: 'Price' },
                { id: 'Variant_InventoryQuantity', name: 'Inventory Quantity' }
            ];

            requiredFields.forEach(function (field) {
                const input = document.getElementById(field.id);
                if (!input) return;

                input.addEventListener('blur', function () {
                    if (this.value === null || this.value === undefined || this.value.toString().trim() === '') {
                        showError(this, field.name + ' is required for product creation.');
                    }
                });

                input.addEventListener('input', function () {
                    // Only clear required-field error if user is typing valid content
                    // Negative check will re-show its own error if needed
                    if (this.value !== null && this.value !== undefined && this.value.toString().trim() !== '') {
                        clearFeedback(this);
                    }
                });
            });

            // --- Negative value detection on input ---
            const numericFields = [
                { id: 'Variant_Price', name: 'Price' },
                { id: 'Variant_CompareAtPrice', name: 'Compare At Price' },
                { id: 'Variant_InventoryQuantity', name: 'Inventory Quantity' },
                { id: 'weightInput', name: 'Weight' }
            ];

            numericFields.forEach(function (field) {
                const input = document.getElementById(field.id);
                if (!input) return;

                input.addEventListener('input', function () {
                    const val = parseFloat(this.value);
                    if (!isNaN(val) && val < 0) {
                        showError(this, field.name + ' cannot be negative. Please enter a positive value.');
                    }
                });
            });

            // --- SKU format + uniqueness validation ---
            const skuPattern = /^[A-Z]{2,4}-\d{3,7}(-[A-Z]{1,3})?$/;
            let skuTimer = null;
            const skuInput = document.getElementById('Variant_SKU');
            if (skuInput) {
                // Instant format check while typing
                skuInput.addEventListener('input', function () {
                    const val = this.value.trim();
                    if (!val) { clearFeedback(this); return; }

                    // Auto-uppercase for convenience
                    const cursorPos = this.selectionStart;
                    this.value = this.value.toUpperCase();
                    this.setSelectionRange(cursorPos, cursorPos);

                    if (!skuPattern.test(val.toUpperCase())) {
                        showError(this, 'SKU must follow format: AB-123 or ABC-1234-XY (letters-numbers or letters-numbers-letters)');
                    } else {
                        clearFeedback(this);
                    }
                });

                // Uniqueness check on blur (only if format is valid)
                skuInput.addEventListener('blur', function () {
                    const val = this.value.trim();
                    if (!val) return;
                    if (!skuPattern.test(val)) return;

                    clearTimeout(skuTimer);
                    skuTimer = setTimeout(function () {
                        fetch('/ProductVariants/CheckSku?sku=' + encodeURIComponent(val))
                            .then(function (r) { return r.json(); })
                            .then(function (data) {
                                if (!data.isAvailable) {
                                    showError(skuInput, 'This SKU is already in use. Please choose a unique SKU.');
                                } else {
                                    clearFeedback(skuInput);
                                }
                            })
                            .catch(function () { });
                    }, 500);
                });
            }

            // --- Title uniqueness check (debounced) ---
            let titleTimer = null;
            const titleInput = document.getElementById('Variant_Title');
            if (titleInput) {
                titleInput.addEventListener('blur', function () {
                    const val = this.value.trim();
                    if (!val) return;

                    clearTimeout(titleTimer);
                    titleTimer = setTimeout(function () {
                        fetch('/ProductVariants/CheckTitle?title=' + encodeURIComponent(val))
                            .then(function (r) { return r.json(); })
                            .then(function (data) {
                                if (!data.isAvailable) {
                                    showError(titleInput, 'A product with this title already exists. Please use a different title.');
                                } else {
                                    clearFeedback(titleInput);
                                }
                            })
                            .catch(function () { });
                    }, 500);
                });
            }

            // --- Prevent form submit if instant errors exist ---
            const form = document.querySelector('form');
            if (form) {
                form.addEventListener('submit', function (e) {
                    // Check required fields
                    requiredFields.forEach(function (field) {
                        const input = document.getElementById(field.id);
                        if (input && (input.value === null || input.value === undefined || input.value.toString().trim() === '')) {
                            showError(input, field.name + ' is required for product creation.');
                        }
                    });

                    // Check for any instant validation errors
                    const errors = form.querySelectorAll('.is-invalid');
                    if (errors.length > 0) {
                        e.preventDefault();
                        errors[0].scrollIntoView({ behavior: 'smooth', block: 'center' });
                        errors[0].focus();
                    }
                });
            }
        })();
    </script>
    }