            skuIn.addEventListener('input', function () {
                const p = this.selectionStart;
                this.value = this.value.toUpperCase();
                this.setSelectionRange(p, p);
            });
            skuTd.appendChild(skuIn);
            tr.appendChild(skuTd);

            // Price input
            const priceTd = document.createElement('td');
            const priceIn = mkInput('number', `Variants[${i}].Price`, '', '0.00');
            Object.assign(priceIn, { step: '0.01', min: '0.01' });
            priceIn.setAttribute('aria-label', `Price for variant ${i + 1}`);
            priceTd.appendChild(priceIn);
            tr.appendChild(priceTd);

            // Cost Price input
            const costTd = document.createElement('td');
            const costIn = mkInput('number', `Variants[${i}].CostPrice`, '', '0.00');
            Object.assign(costIn, { step: '0.01', min: '0' });
            costIn.setAttribute('aria-label', `Cost for variant ${i + 1}`);
            costTd.appendChild(costIn);
            tr.appendChild(costTd);

            // Qty input
            const qtyTd = document.createElement('td');
            const qtyIn = mkInput('number', `Variants[${i}].Qty`, '0', '0');
            qtyIn.min = '0';
            qtyIn.setAttribute('aria-label', `Stock quantity for variant ${i + 1}`);
            qtyTd.appendChild(qtyIn);
            tr.appendChild(qtyTd);

            // Barcode input
            const barcodeTd = document.createElement('td');
            const barcodeIn = mkInput('text', `Variants[${i}].Barcode`, '', 'Barcode');
            barcodeIn.pattern = '[0-9]{8,14}';
            barcodeIn.title   = '8–14 digits';
            barcodeIn.setAttribute('aria-label', `Barcode for variant ${i + 1}`);
            barcodeTd.appendChild(barcodeIn);
            tr.appendChild(barcodeTd);

            // Remove button
            const remTd = document.createElement('td');
            const remBtn = document.createElement('button');
            remBtn.type = 'button';
            remBtn.className = 'btn btn-sm btn-outline-danger';
            remBtn.textContent = '×';
            remBtn.onclick = () => { tr.remove(); reindex(); refreshCount(); };
            remTd.appendChild(remBtn);
            tr.appendChild(remTd);

            tbody.appendChild(tr);
        });

        document.getElementById('variant-table-section').style.display = 'block';
        setDisabled('variant-table-section', false);
        refreshCount();
    }

    function mkInput(type, name, value, placeholder) {
        const el = document.createElement('input');
        el.type = type; el.name = name; el.value = value;
        el.placeholder = placeholder;
        el.className = 'form-control form-control-sm';
        return el;
    }

    function addHidden(parent, name, value) {
        const h = document.createElement('input');
        h.type = 'hidden'; h.name = name; h.value = value;
        parent.appendChild(h);
    }

    function removeRow(btn) { btn.closest('tr').remove(); reindex(); refreshCount(); }

