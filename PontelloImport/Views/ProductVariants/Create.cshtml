@model PontelloImport.Models.QuickCreateViewModel

@{
    Layout = "~/Views/Admin/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Add Product";

    var optionNames = new[] { "Color", "Size", "Material", "Style", "Type", "Weight", "Length", "Diameter" };
}

<style>
    *, *::before, *::after { font-family: Inter, system-ui, sans-serif; }

    .create-section {
        background: #ffffff;
        border: 1px solid #E5E7EB;
        border-radius: 12px;
        margin-bottom: 1.25rem;
        overflow: hidden;
    }

    .create-section-header {
        background: #F8FAFC;
        border-bottom: 1px solid #E5E7EB;
        padding: 0.875rem 1.25rem;
        font-weight: 600;
        font-size: 0.875rem;
        color: #374151;
        letter-spacing: 0.01em;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .create-section-body { padding: 1.25rem; }

    .form-label {
        font-size: 0.875rem;
        font-weight: 500;
        color: #374151;
        margin-bottom: 0.35rem;
    }

    .form-control, .form-select {
        font-size: 0.875rem;
        border-color: #D1D5DB;
        border-radius: 8px;
    }

    .form-control:focus, .form-select:focus {
        border-color: #2563EB;
        box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.12);
    }

    .input-group-text {
        background: #F8FAFC;
        border-color: #D1D5DB;
        font-size: 0.875rem;
        color: #6B7280;
    }

    .form-text        { font-size: 0.8rem; color: #9CA3AF; }
    .optional-label   { font-size: 0.75rem; color: #9CA3AF; font-weight: 400; margin-left: 0.3rem; }

    .btn-create {
        background: #111827; color: #ffffff; border: none;
        border-radius: 8px; font-size: 0.875rem; font-weight: 500;
        padding: 0.5rem 1.75rem; cursor: pointer; transition: background 150ms;
    }
    .btn-create:hover { background: #374151; color: #ffffff; }

    .btn-cancel-link {
        color: #6B7280; border: 1px solid #E5E7EB; background: transparent;
        border-radius: 8px; font-size: 0.875rem; font-weight: 500;
        padding: 0.5rem 1.1rem; text-decoration: none; transition: background 150ms;
        display: inline-block;
    }
    .btn-cancel-link:hover { background: #F3F4F6; color: #374151; }

    /* product type radio cards */
    .type-option {
        display: flex;
        align-items: flex-start;
        gap: 0.65rem;
        padding: 0.7rem 1rem;
        border: 1px solid #E5E7EB;
        border-radius: 8px;
        cursor: pointer;
        user-select: none;
        background: #fff;
        transition: border-color 150ms, background 150ms;
        margin-bottom: 0.5rem;
    }
    .type-option.selected {
        border-color: #2563EB;
        background: #EFF6FF;
    }
    .type-option input[type=radio] {
        margin-top: 0.18rem;
        accent-color: #2563EB;
        cursor: pointer;
    }
    .type-option-title { font-size: 0.875rem; font-weight: 600; color: #111827; }
    .type-option-hint  { font-size: 0.8rem; color: #9CA3AF; }

    /* option dimension grid */
    .dim-row {
        display: grid; grid-template-columns: 160px 1fr;
        gap: 0.75rem; align-items: start; margin-bottom: 0.75rem;
    }
    .dim-error { font-size: 0.8rem; color: #DC2626; margin-top: 0.25rem; }

    /* variant preview table */
    .var-table { font-size: 0.82rem; }
    .var-table th {
        font-size: 0.71rem; font-weight: 600; text-transform: uppercase;
        letter-spacing: 0.05em; color: #6B7280; background: #F8FAFC;
        padding: 0.5rem 0.6rem;
    }
    .var-table td { vertical-align: middle; padding: 0.35rem 0.6rem; }
    .var-table .form-control-sm { font-size: 0.82rem; }

    /* spec rows */
    .spec-row { display: flex; gap: 0.5rem; align-items: center; margin-bottom: 0.5rem; }
    .spec-row .spec-label-col { flex: 1 1 40%; }
    .spec-row .spec-value-col { flex: 2 1 55%; }
</style>

<div class="container-fluid mt-4" style="max-width: 720px;">

    <div class="mb-4">
        <a asp-action="Index" style="color:#6B7280; font-size:0.875rem; text-decoration:none;">← Back to Product Catalogue</a>
    </div>

    <div class="mb-4">
        <div style="font-size:1.15rem; font-weight:700; color:#111827;">Add Product</div>
        <div style="font-size:0.875rem; color:#6B7280; margin-top:0.2rem;">
            Fields marked <span class="text-danger">*</span> are required.
        </div>
    </div>

    <form asp-action="Create" method="post" id="createForm">
        @Html.AntiForgeryToken()

        <!-- ══ VALIDATION SUMMARY ════════════════════════════════════════════ -->
        @if (!ViewData.ModelState.IsValid &&
             ViewData.ModelState.Values.Any(v => v.Errors.Count > 0))
        {
            <div class="alert alert-danger mb-3">
                <strong>Please fix the following errors:</strong>
                <div asp-validation-summary="All" class="mt-1 mb-0 small"></div>
            </div>
        }

        <!-- ══ PRODUCT INFO ══════════════════════════════════════════════════ -->
        <div class="create-section">
            <div class="create-section-header">Product Info</div>
            <div class="create-section-body">

                <div class="mb-3">
                    <label asp-for="ProductTitle" class="form-label">Product Title <span class="text-danger">*</span></label>
                    <input asp-for="ProductTitle" class="form-control" placeholder="e.g., Safety Helmet Full-Face" autofocus />
                    <span asp-validation-for="ProductTitle" class="text-danger small"></span>
                    <span id="title-ajax-msg" class="small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="VendorID" class="form-label">Vendor <span class="text-danger">*</span></label>
                    <select asp-for="VendorID" class="form-select" asp-items="ViewBag.VendorID">
                        <option value="0">-- Select Vendor --</option>
                    </select>
                    <span asp-validation-for="VendorID" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="ProductCategoryID" class="form-label">Category <span class="text-danger">*</span></label>
                    <select asp-for="ProductCategoryID" class="form-select" asp-items="ViewBag.ProductCategoryID">
                        <option value="0">-- Select Category --</option>
                    </select>
                    <span asp-validation-for="ProductCategoryID" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="ProductTypeID" class="form-label">
                        Product Type <span class="optional-label">(optional)</span>
                    </label>
                    <select asp-for="ProductTypeID" class="form-select"
                            asp-items="@(ViewData["ProductTypes"] as SelectList)">
                        <option value="">-- None --</option>
                    </select>
                    <span asp-validation-for="ProductTypeID" class="text-danger small"></span>
                </div>

                <div class="mb-1">
                    <label asp-for="Status" class="form-label">Status <span class="text-danger">*</span></label>
                    <select asp-for="Status" class="form-select">
                        <option value="@ProductStatus.Draft">Draft</option>
                        <option value="@ProductStatus.Published">Published</option>
                        <option value="@ProductStatus.Unlisted">Unlisted</option>
                    </select>
                    <span asp-validation-for="Status" class="text-danger small"></span>
                </div>

            </div>
        </div>

        <!-- ══ SPECIFICATIONS (Task 3) ═══════════════════════════════════════ -->
        <div class="create-section">
            <div class="create-section-header">Specifications</div>
            <div class="create-section-body">
                <p class="small text-muted mb-3">
                    Optional. Add technical details like Model Year, Material, Thread Size, Fitment, etc.
                </p>

                <div id="spec-rows">
                    @for (int i = 0; i < Model.Specifications.Count; i++)
                    {
                        var spec = Model.Specifications[i];
                        <div class="spec-row">
                            <div class="spec-label-col">
                                <input type="text" name="Specifications[@i].Label"
                                       value="@spec.Label"
                                       class="form-control form-control-sm"
                                       placeholder="e.g. Model Year" />
                            </div>
                            <div class="spec-value-col">
                                <input type="text" name="Specifications[@i].Value"
                                       value="@spec.Value"
                                       class="form-control form-control-sm"
                                       placeholder="e.g. 2023" />
                            </div>
                            <button type="button" class="btn btn-outline-danger btn-sm px-2"
                                    onclick="removeSpecRow(this)">×</button>
                        </div>
                    }
                </div>

                <div id="spec-limit-msg" class="text-danger small mt-1" style="display:none">
                    Maximum 10 specifications allowed.
                </div>

                <button type="button" id="addSpecBtn"
                        class="btn btn-outline-secondary btn-sm mt-2"
                        onclick="addSpecRow()">
                    + Add Specification
                </button>
            </div>
        </div>

        <!-- ══ PRODUCT TYPE TOGGLE (Task 5 — radio buttons) ════════════════ -->
        <div class="create-section mb-3">
            <div class="create-section-body pb-2">
                <div class="mb-2" style="font-size:0.875rem; font-weight:600; color:#374151;">Product Type</div>

                <label class="type-option @(!Model.HasVariants ? "selected" : "")" for="simpleProduct">
                    <input type="radio" name="HasVariants" id="simpleProduct" value="false"
                           @Html.Raw(!Model.HasVariants ? "checked" : "")
                           onchange="applyMode(false)" />
                    <div>
                        <div class="type-option-title">Simple Product</div>
                        <div class="type-option-hint">One SKU, no options</div>
                    </div>
                </label>

                <label class="type-option @(Model.HasVariants ? "selected" : "")" for="productWithVariants">
                    <input type="radio" name="HasVariants" id="productWithVariants" value="true"
                           @Html.Raw(Model.HasVariants ? "checked" : "")
                           onchange="applyMode(true)" />
                    <div>
                        <div class="type-option-title">Product with Variants</div>
                        <div class="type-option-hint">Multiple SKUs by option (Color, Size, etc.)</div>
                    </div>
                </label>
            </div>
        </div>

        <!-- ══ SIMPLE VARIANT (HasVariants = false) ══════════════════════════ -->
        <div id="simple-section" class="create-section">
            <div class="create-section-header">Listing Details</div>
            <div class="create-section-body">
                <p class="small text-muted mb-3">Price, stock, and identifier for this product.</p>

                <div class="mb-3">
                    <label asp-for="SKU" class="form-label">SKU <span class="text-danger">*</span></label>
                    <input asp-for="SKU" class="form-control" id="simpleSku" placeholder="e.g., CRG-3001" />
                    <span asp-validation-for="SKU" class="text-danger small"></span>
                    <span id="sku-ajax-msg" class="small"></span>
                    <small class="form-text">Format: AA-000 &nbsp;e.g. CRG-3001</small>
                </div>

                <div class="row">
                    <div class="col-6 mb-3">
                        <label asp-for="Price" class="form-label">Price <span class="text-danger">*</span></label>
                        <div class="input-group">
                            <span class="input-group-text">$</span>
                            <input asp-for="Price" type="number" step="0.01" min="0.01"
                                   class="form-control" placeholder="0.00" />
                        </div>
                        <span asp-validation-for="Price" class="text-danger small"></span>
                        <small class="form-text">CAD</small>
                    </div>
                    <div class="col-6 mb-3">
                        <label asp-for="InventoryQuantity" class="form-label">Stock Quantity <span class="text-danger">*</span></label>
                        <input asp-for="InventoryQuantity" type="number" min="0"
                               class="form-control" placeholder="0" />
                        <span asp-validation-for="InventoryQuantity" class="text-danger small"></span>
                    </div>
                </div>

                <div class="mt-3 pt-3" style="border-top:1px solid #E5E7EB;">
                    <div class="mb-1" style="font-size:0.875rem; font-weight:500; color:#374151;">
                        Option <span class="optional-label">(optional)</span>
                    </div>
                    <p class="small text-muted mb-2">
                        Does this product come in a specific option right now, even if it's the only one?
                        e.g. Size = Small. This makes it easy to add more options later.
                    </p>
                    <div class="row">
                        <div class="col-6 mb-1">
                            <label asp-for="SimpleOptionName" class="form-label">Option</label>
                            <select asp-for="SimpleOptionName" class="form-select" id="SimpleOptionName"
                                    onchange="onSimpleOptionNameChange()">
                                <option value="">-- None --</option>
                                @foreach (var n in optionNames)
                                {
                                    <option value="@n">@n</option>
                                }
                            </select>
                            <span asp-validation-for="SimpleOptionName" class="text-danger small"></span>
                        </div>
                        <div class="col-6 mb-1">
                            <label asp-for="SimpleOptionValue" class="form-label">Value</label>
                            <input asp-for="SimpleOptionValue" class="form-control" id="SimpleOptionValue"
                                   placeholder="e.g. Small" />
                            <span asp-validation-for="SimpleOptionValue" class="text-danger small"></span>
                        </div>
                    </div>
                </div>

            </div>
        </div>

        <!-- ══ OPTION DIMENSIONS (HasVariants = true) ════════════════════════ -->
        <div id="variants-section">

            <div class="create-section">
                <div class="create-section-header">Option Dimensions</div>
                <div class="create-section-body">

                    <p class="small text-muted mb-3">
                        Define up to 3 dimensions and enter comma-separated values for each,
                        then click <strong>Generate Variants</strong>.
                    </p>

                    @for (int dim = 1; dim <= 3; dim++)
                    {
                        var nameField = dim == 1 ? "Option1Name"
                                      : dim == 2 ? "Option2Name"
                                      :            "Option3Name";
                        var savedName = dim == 1 ? Model.Option1Name
                                      : dim == 2 ? Model.Option2Name
                                      :            Model.Option3Name;

                        <div class="dim-row">
                            <div>
                                <label class="form-label">
                                    Option @dim
                                    @if (dim == 1) { <span class="text-danger">*</span> }
                                    else           { <span class="optional-label">(optional)</span> }
                                </label>
                                <select id="opt@(dim)Name" data-fieldname="@nameField"
                                        class="form-select opt-name-sel">
                                    <option value="">-- Select --</option>
                                    @foreach (var n in optionNames)
                                    {
                                        if (savedName == n)
                                        {
                                            <option value="@n" selected>@n</option>
                                        }
                                        else
                                        {
                                            <option value="@n">@n</option>
                                        }
                                    }
                                </select>
                            </div>
                            <div>
                                <label class="form-label">
                                    Values
                                    @if (dim == 1) { <span class="text-danger">*</span> }
                                    else           { <span class="optional-label">(optional)</span> }
                                    <span class="optional-label">— comma-separated</span>
                                </label>
                                <input type="text" id="opt@(dim)Values" class="form-control"
                                       placeholder="@(dim == 1 ? "e.g. Red, Blue, Black"
                                                    : dim == 2 ? "e.g. Small, Medium, Large"
                                                    :            "e.g. Cotton, Polyester")" />
                            </div>
                        </div>
                    }

                    <!-- Hidden fields for model binding — kept inside variants-section so setDisabled works -->
                    <div id="opt-name-hiddens"></div>

                    <div class="mt-2">
                        <button type="button" class="btn btn-outline-primary btn-sm px-3"
                                onclick="generateVariants()">
                            Generate Variants
                        </button>
                        <span id="gen-error" class="text-danger small ms-2" style="display:none"></span>
                    </div>

                </div>
            </div>

            <!-- Generated / pre-populated variant rows -->
            <div id="variant-table-section" class="create-section"
                 style="display:@(Model.HasVariants && Model.Variants.Any() ? "block" : "none");">
                <div class="create-section-header">
                    <span>Variants</span>
                    <span id="variant-count-lbl" style="font-size:0.8rem; color:#9CA3AF; font-weight:400;">
                        @(Model.Variants.Any() ? $"({Model.Variants.Count} variant{(Model.Variants.Count != 1 ? "s" : "")})" : "")
                    </span>
                </div>
                <div class="table-responsive">
                    <table class="table table-sm var-table mb-0">
                        <thead>
                            <tr id="variant-header-row">
                                <th id="th-opt1">@(Model.Option1Name ?? "Option 1")</th>
                                <th id="th-opt2">@(Model.Option2Name ?? "Option 2")</th>
                                <th id="th-opt3">@(Model.Option3Name ?? "Option 3")</th>
                                <th style="min-width:130px;">SKU <span class="text-danger">*</span></th>
                                <th style="min-width:100px;">Price <span class="text-danger">*</span></th>
                                <th style="min-width:80px;">Stock Qty</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody id="variant-rows">
                            @for (int i = 0; i < Model.Variants.Count; i++)
                            {
                                var vr = Model.Variants[i];
                                <tr>
                                    <td>@(vr.Option1Value ?? "")</td>
                                    <td>@(vr.Option2Value ?? "")</td>
                                    <td>@(vr.Option3Value ?? "")</td>
                                    <input type="hidden" name="Variants[@i].Option1Value" value="@(vr.Option1Value ?? "")" />
                                    <input type="hidden" name="Variants[@i].Option2Value" value="@(vr.Option2Value ?? "")" />
                                    <input type="hidden" name="Variants[@i].Option3Value" value="@(vr.Option3Value ?? "")" />
                                    <td>
                                        <input type="text" name="Variants[@i].SKU" value="@vr.SKU"
                                               class="form-control form-control-sm" placeholder="SKU" />
                                    </td>
                                    <td>
                                        <input type="number" name="Variants[@i].Price"
                                               value="@vr.Price.ToString("0.00")"
                                               class="form-control form-control-sm"
                                               step="0.01" min="0.01" />
                                    </td>
                                    <td>
                                        <input type="number" name="Variants[@i].Qty" value="@vr.Qty"
                                               class="form-control form-control-sm" min="0" />
                                    </td>
                                    <td>
                                        <button type="button" class="btn btn-sm btn-outline-danger"
                                                onclick="removeRow(this)">×</button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

        </div><!-- /variants-section -->

        <!-- ══ BUTTONS ══════════════════════════════════════════════════════ -->
        <div class="d-flex justify-content-between mt-3 mb-5">
            <a asp-action="Index" class="btn-cancel-link">Cancel</a>
            <button type="submit" class="btn-create">Save Product</button>
        </div>

    </form>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
    <script>
    // ── Radio button toggle ───────────────────────────────────────────────────
    function applyMode(on) {
        document.getElementById('simple-section').style.display   = on ? 'none'  : 'block';
        document.getElementById('variants-section').style.display = on ? 'block' : 'none';
        setDisabled('simple-section',   on);
        setDisabled('variants-section', !on);

        if (!on) {
            // Re-apply conditional disable for simple option value after setDisabled re-enables everything
            initSimpleOptionValueState();
        }

        // Update radio card styling
        document.querySelectorAll('.type-option').forEach(el => el.classList.remove('selected'));
        var activeFor = on ? 'productWithVariants' : 'simpleProduct';
        var lbl = document.querySelector('label[for="' + activeFor + '"]');
        if (lbl) lbl.classList.add('selected');
    }

    function setDisabled(id, disabled) {
        document.getElementById(id)
            .querySelectorAll('input, select, textarea, button')
            .forEach(el => { el.disabled = disabled; });
    }

    // ── Task 4: Simple option value disable logic ─────────────────────────────
    function initSimpleOptionValueState() {
        const nameEl = document.getElementById('SimpleOptionName');
        const valEl  = document.getElementById('SimpleOptionValue');
        if (nameEl && valEl) {
            valEl.disabled = !nameEl.value;
        }
    }

    function onSimpleOptionNameChange() {
        const nameEl = document.getElementById('SimpleOptionName');
        const valEl  = document.getElementById('SimpleOptionValue');
        if (!nameEl || !valEl) return;
        valEl.disabled = !nameEl.value;
        if (!nameEl.value) valEl.value = '';
    }

    // Initialise on load
    applyMode(@(Model.HasVariants ? "true" : "false"));

    // Auto-uppercase SKU (simple path)
    document.getElementById('simpleSku')?.addEventListener('input', function () {
        const p = this.selectionStart;
        this.value = this.value.toUpperCase();
        this.setSelectionRange(p, p);
    });

    // ── Task 4: Prevent duplicate option dimension selection ─────────────────
    function updateOptionSelects() {
        const sels = ['opt1Name', 'opt2Name', 'opt3Name']
            .map(id => document.getElementById(id))
            .filter(Boolean);

        sels.forEach((sel, idx) => {
            const otherVals = sels
                .filter((_, i) => i !== idx)
                .map(s => s.value)
                .filter(v => v !== '');

            Array.from(sel.options).forEach(opt => {
                if (opt.value === '') return; // always keep blank option enabled
                opt.disabled = otherVals.includes(opt.value);
            });
        });

        updateVariantHeaders();
    }

    document.querySelectorAll('.opt-name-sel').forEach(sel => {
        sel.addEventListener('change', updateOptionSelects);
    });

    // ── Task 5: Dynamic variant table column headers ──────────────────────────
    function updateVariantHeaders() {
        const opt1 = document.getElementById('opt1Name')?.value || 'Option 1';
        const opt2 = document.getElementById('opt2Name')?.value || 'Option 2';
        const opt3 = document.getElementById('opt3Name')?.value || 'Option 3';

        const th1 = document.getElementById('th-opt1');
        const th2 = document.getElementById('th-opt2');
        const th3 = document.getElementById('th-opt3');
        if (th1) th1.textContent = opt1;
        if (th2) th2.textContent = opt2;
        if (th3) th3.textContent = opt3;
    }

    // ── Variant generator ─────────────────────────────────────────────────────
    function parseVals(s) { return s.split(',').map(v => v.trim()).filter(Boolean); }

    function cartesian(arrays) {
        return arrays.reduce(
            (acc, cur) => acc.flatMap(a => cur.map(v => [...a, v])),
            [[]]
        );
    }

    // Sync option name selects -> hidden fields inside variants-section
    function syncOptionNameHiddens() {
        const container = document.getElementById('opt-name-hiddens');
        container.innerHTML = ''; // clear and rebuild each time
        for (let d = 1; d <= 3; d++) {
            const sel = document.getElementById(`opt${d}Name`);
            if (!sel || !sel.value) continue;
            const hid = document.createElement('input');
            hid.type  = 'hidden';
            hid.name  = sel.dataset.fieldname;
            hid.value = sel.value;
            container.appendChild(hid);
        }
    }

    function generateVariants() {
        // Clear previous inline errors
        document.querySelectorAll('.dim-error').forEach(el => el.remove());
        document.getElementById('gen-error').style.display = 'none';

        const dims = [], names = [];
        let hasError = false;
        const namesSeen = new Set();

        for (let d = 1; d <= 3; d++) {
            const nameEl = document.getElementById(`opt${d}Name`);
            const valEl  = document.getElementById(`opt${d}Values`);
            const name   = nameEl?.value.trim() ?? '';
            const rawVal = valEl?.value.trim() ?? '';
            const vals   = parseVals(rawVal);

            if (!name) continue;

            // Task 4: duplicate option name check
            if (namesSeen.has(name)) {
                showDimError(nameEl.closest('div'), `"${name}" is already selected for another option.`);
                hasError = true;
            } else {
                namesSeen.add(name);
            }

            // Task 6.8: option name selected but no values entered
            if (vals.length === 0) {
                showDimError(valEl.closest('div'), `Enter at least one value for ${name}.`);
                hasError = true;
                continue;
            }

            dims.push(vals);
            names.push(name);
        }

        if (dims.length === 0 && !hasError) {
            document.getElementById('gen-error').textContent = 'Select at least one option with values.';
            document.getElementById('gen-error').style.display = 'inline';
            return;
        }

        if (hasError) return;

        syncOptionNameHiddens();
        buildTable(cartesian(dims));
        updateVariantHeaders();
    }

    function showDimError(container, msg) {
        const err = document.createElement('div');
        err.className = 'dim-error';
        err.textContent = msg;
        container.appendChild(err);
    }

    function buildTable(combos) {
        const tbody = document.getElementById('variant-rows');
        tbody.innerHTML = '';

        combos.forEach((combo, i) => {
            const tr = document.createElement('tr');

            // Display-only option value cells (3 columns)
            for (let j = 0; j < 3; j++) {
                const c = document.createElement('td');
                c.textContent = combo[j] ?? '';
                tr.appendChild(c);
            }

            // Hidden inputs for model binding
            for (let j = 0; j < 3; j++) {
                addHidden(tr, `Variants[${i}].Option${j + 1}Value`, combo[j] ?? '');
            }

            // SKU input
            const skuTd = document.createElement('td');
            const skuIn = mkInput('text', `Variants[${i}].SKU`, '', 'SKU');
            skuIn.addEventListener('input', function () {
                const p = this.selectionStart;
                this.value = this.value.toUpperCase();
                this.setSelectionRange(p, p);
            });
            skuTd.appendChild(skuIn);
            tr.appendChild(skuTd);

            // Price input
            const priceTd = document.createElement('td');
            const priceIn = mkInput('number', `Variants[${i}].Price`, '', '0.00');
            Object.assign(priceIn, { step: '0.01', min: '0.01' });
            priceTd.appendChild(priceIn);
            tr.appendChild(priceTd);

            // Qty input
            const qtyTd = document.createElement('td');
            const qtyIn = mkInput('number', `Variants[${i}].Qty`, '0', '0');
            qtyIn.min = '0';
            qtyTd.appendChild(qtyIn);
            tr.appendChild(qtyTd);

            // Remove button
            const remTd = document.createElement('td');
            const remBtn = document.createElement('button');
            remBtn.type = 'button';
            remBtn.className = 'btn btn-sm btn-outline-danger';
            remBtn.textContent = '×';
            remBtn.onclick = () => { tr.remove(); reindex(); refreshCount(); };
            remTd.appendChild(remBtn);
            tr.appendChild(remTd);

            tbody.appendChild(tr);
        });

        document.getElementById('variant-table-section').style.display = 'block';
        setDisabled('variant-table-section', false);
        refreshCount();
    }

    function mkInput(type, name, value, placeholder) {
        const el = document.createElement('input');
        el.type = type; el.name = name; el.value = value;
        el.placeholder = placeholder;
        el.className = 'form-control form-control-sm';
        return el;
    }

    function addHidden(parent, name, value) {
        const h = document.createElement('input');
        h.type = 'hidden'; h.name = name; h.value = value;
        parent.appendChild(h);
    }

    function removeRow(btn) { btn.closest('tr').remove(); reindex(); refreshCount(); }

    function reindex() {
        document.querySelectorAll('#variant-rows tr').forEach((tr, i) => {
            tr.querySelectorAll('input[name]').forEach(el => {
                el.name = el.name.replace(/Variants\[\d+\]/, `Variants[${i}]`);
            });
        });
    }

    function refreshCount() {
        const n = document.querySelectorAll('#variant-rows tr').length;
        document.getElementById('variant-count-lbl').textContent =
            n > 0 ? `(${n} variant${n !== 1 ? 's' : ''})` : '';
    }

    // ── Task 3: Specification row management ──────────────────────────────────
    var specCount = @(Model.Specifications.Count);

    function addSpecRow() {
        if (specCount >= 10) {
            document.getElementById('spec-limit-msg').style.display = 'block';
            return;
        }
        const idx = specCount;
        const row = document.createElement('div');
        row.className = 'spec-row';
        row.innerHTML =
            `<div class="spec-label-col">
                <input type="text" name="Specifications[${idx}].Label"
                       class="form-control form-control-sm" placeholder="e.g. Model Year" />
             </div>
             <div class="spec-value-col">
                <input type="text" name="Specifications[${idx}].Value"
                       class="form-control form-control-sm" placeholder="e.g. 2023" />
             </div>
             <button type="button" class="btn btn-outline-danger btn-sm px-2"
                     onclick="removeSpecRow(this)">×</button>`;
        document.getElementById('spec-rows').appendChild(row);
        specCount++;
        updateSpecLimit();
    }

    function removeSpecRow(btn) {
        btn.closest('.spec-row').remove();
        reindexSpecs();
        updateSpecLimit();
    }

    function reindexSpecs() {
        specCount = 0;
        document.querySelectorAll('#spec-rows .spec-row').forEach((row, i) => {
            row.querySelectorAll('input[name]').forEach(el => {
                el.name = el.name.replace(/Specifications\[\d+\]/, `Specifications[${i}]`);
            });
            specCount++;
        });
    }

    function updateSpecLimit() {
        const count = document.querySelectorAll('#spec-rows .spec-row').length;
        const atLimit = count >= 10;
        document.getElementById('spec-limit-msg').style.display = atLimit ? 'block' : 'none';
        document.getElementById('addSpecBtn').disabled = atLimit;
        specCount = count;
    }

    // Initialise option selects (disable already-selected options in sibling selects)
    updateOptionSelects();

    // ── Task 2: Real-time AJAX uniqueness checks ──────────────────────────────
    function setAjaxFeedback(feedbackId, available, takenMsg) {
        let el = document.getElementById(feedbackId);
        if (!el) return;
        if (!available) {
            el.className = 'text-danger small d-block';
            el.textContent = takenMsg;
        } else {
            el.textContent = '';
        }
    }

    // Title field — blur check
    document.getElementById('ProductTitle')?.addEventListener('blur', async function () {
        const val = this.value.trim();
        if (!val) { setAjaxFeedback('title-ajax-msg', true, ''); return; }
        try {
            const res  = await fetch('/ProductVariants/CheckTitle?title=' + encodeURIComponent(val));
            const data = await res.json();
            setAjaxFeedback('title-ajax-msg', data.available,
                'This product name is already taken.');
        } catch {}
    });

    // SKU field (simple path) — blur check
    document.getElementById('SKU')?.addEventListener('blur', async function () {
        const val = this.value.trim();
        if (!val) { setAjaxFeedback('sku-ajax-msg', true, ''); return; }
        try {
            const res  = await fetch('/ProductVariants/CheckSku?sku=' + encodeURIComponent(val));
            const data = await res.json();
            setAjaxFeedback('sku-ajax-msg', data.available,
                'This SKU is already in use.');
        } catch {}
    });

    // Variant table SKU inputs — event delegation (blur doesn't bubble, use capture)
    document.getElementById('variant-rows')?.addEventListener('blur', async function (e) {
        if (!e.target.matches('input[name$=".SKU"]')) return;
        const val = e.target.value.trim();
        // Remove previous inline feedback for this cell
        e.target.parentElement.querySelectorAll('.var-sku-feedback').forEach(el => el.remove());
        if (!val) return;
        try {
            const res  = await fetch('/ProductVariants/CheckSku?sku=' + encodeURIComponent(val));
            const data = await res.json();
            if (!data.available) {
                const span = document.createElement('span');
                span.className = 'text-danger small d-block var-sku-feedback';
                span.textContent = 'SKU already in use.';
                e.target.parentElement.appendChild(span);
            }
        } catch {}
    }, true); // capture=true because blur doesn't bubble
    </script>
}
