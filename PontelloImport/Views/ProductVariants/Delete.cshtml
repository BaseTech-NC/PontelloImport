@model PontelloImport.Models.ProductVariant

@{
    Layout = "~/Views/Admin/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Archive Product";
}

<style>
    *, *::before, *::after { font-family: Inter, system-ui, sans-serif; }

    .confirm-card {
        background: #ffffff;
        border: 1px solid #E5E7EB;
        border-radius: 12px;
        max-width: 560px;
        padding: 2rem;
    }

    .confirm-icon {
        width: 44px;
        height: 44px;
        background: #FFF7ED;
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.2rem;
        margin-bottom: 1.25rem;
    }

    .confirm-title {
        font-size: 1.1rem;
        font-weight: 600;
        color: #111827;
        margin-bottom: 0.4rem;
    }

    .confirm-lead {
        color: #6B7280;
        font-size: 0.875rem;
        margin-bottom: 1.5rem;
        line-height: 1.6;
    }

    .product-summary {
        background: #F8FAFC;
        border: 1px solid #E5E7EB;
        border-radius: 8px;
        padding: 0.9rem 1rem;
        margin-bottom: 1rem;
    }

    .product-summary .ps-name {
        font-weight: 600;
        color: #111827;
        font-size: 0.95rem;
        margin-bottom: 0.25rem;
    }

    .product-summary .ps-meta {
        color: #6B7280;
        font-size: 0.8rem;
    }

    .restore-note {
        background: #EFF6FF;
        border: 1px solid #BFDBFE;
        border-radius: 8px;
        padding: 0.75rem 1rem;
        font-size: 0.85rem;
        color: #1E40AF;
        margin-bottom: 1.75rem;
        line-height: 1.5;
    }

    .btn-archive {
        background: #EA580C;
        color: #ffffff;
        border: none;
        border-radius: 8px;
        font-size: 0.875rem;
        font-weight: 500;
        padding: 0.5rem 1.25rem;
        transition: background 150ms;
        cursor: pointer;
    }

    .btn-archive:hover { background: #C2410C; color: #ffffff; }

    .btn-cancel {
        color: #6B7280;
        border: 1px solid #E5E7EB;
        background: transparent;
        border-radius: 8px;
        font-size: 0.875rem;
        font-weight: 500;
        padding: 0.5rem 1.1rem;
        text-decoration: none;
        transition: background 150ms;
    }

    .btn-cancel:hover { background: #F3F4F6; color: #374151; }
</style>

<div class="container-fluid mt-4" style="max-width: 700px;">

    <div class="mb-4">
        <a asp-action="Index" style="color:#6B7280; font-size:0.875rem; text-decoration:none;">← Back to Product Catalogue</a>
    </div>

    <div class="confirm-card">

        <div class="confirm-icon">📦</div>

        <div class="confirm-title">Archive this product?</div>
        <p class="confirm-lead">
            Archiving removes this product from the dealer shop and prevents new orders.
            The product and all its data are kept — nothing is permanently deleted.
        </p>

        <div class="product-summary">
            <div class="ps-name">@(Model.Product?.Title ?? Model.SKU)</div>
            <div class="ps-meta">
                SKU: <strong>@Model.SKU</strong>
                @if (!string.IsNullOrEmpty(Model.Option1Value))
                {
                    <span class="ms-2">· @Model.Option1Name: @Model.Option1Value</span>
                }
                @if (!string.IsNullOrEmpty(Model.Option2Value))
                {
                    <span class="ms-2">· @Model.Option2Name: @Model.Option2Value</span>
                }
                <span class="ms-2">· @Model.Price.ToString("C")</span>
                <span class="ms-2">
                    ·
                    @if (Model.InventoryQuantity > 5) { <text>@Model.InventoryQuantity in stock</text> }
                    else if (Model.InventoryQuantity >= 1) { <text>@Model.InventoryQuantity left</text> }
                    else { <text>Out of stock</text> }
                </span>
            </div>
        </div>

        <div class="restore-note">
            You can restore this product at any time from the <strong>Archived</strong> tab in the Product Catalogue.
        </div>

        <form asp-action="Delete" method="post" class="d-flex gap-2 align-items-center">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="VariantID" />
            <button type="submit" class="btn-archive">Archive Product</button>
            <a asp-action="Index" class="btn-cancel">Cancel</a>
        </form>

    </div>

</div>
