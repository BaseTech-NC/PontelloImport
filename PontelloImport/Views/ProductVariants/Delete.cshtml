@model PontelloImport.Models.ProductVariant

@{
    Layout = "~/Views/Admin/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Delete Product Variant";
    }

<div class="container mt-4">

    <!-- Warning Header -->
    <div class="alert alert-dark" role="alert">
        <h4 class="alert-heading">
            <i class="bi bi-exclamation-triangle-fill"></i> Archive Product Variant?
        </h4>
        <p class="mb-0">
            This will archive the variant and hide it from dealers. The data will remain in the system and can be restored later.
        </p>
    </div>

    <!-- Product Details Card -->
    <div class="card">
        <div class="card-header bg-dark text-white">
            <h5 class="mb-0">Variant to Archive</h5>
        </div>
        <div class="card-body">

            <div class="row">
                <div class="col-md-6">
                    <dl class="row">
                        <dt class="col-sm-4">Title:</dt>
                        <dd class="col-sm-8"><strong>@Model.Title</strong></dd>

                        <dt class="col-sm-4">SKU:</dt>
                        <dd class="col-sm-8"><code class="text-dark">@Model.SKU</code></dd>

                        <dt class="col-sm-4">Price:</dt>
                        <dd class="col-sm-8"><strong class="text-dark">@Model.Price.ToString("C")</strong></dd>

                        <dt class="col-sm-4">Inventory:</dt>
                        <dd class="col-sm-8">
                            @if (Model.InventoryQuantity > 5)
                            {
                                <span class="badge bg-success" style="font-weight:normal;">● @Model.InventoryQuantity in stock</span>
                            }
                            else if (Model.InventoryQuantity >= 1)
                            {
                                <span class="badge bg-warning" style="font-weight:normal;">● @Model.InventoryQuantity left</span>
                            }
                            else
                            {
                                <span class="badge bg-danger" style="font-weight:normal;">● Out of stock</span>
                            }
                        </dd>

                        @if (Model.Product?.Vendor != null)
                            {
                            <dt class="col-sm-4">Vendor:</dt>
                            <dd class="col-sm-8">@Model.Product.Vendor.VendorName</dd>
                            }
                    </dl>
                </div>

                <div class="col-md-6">
                    <dl class="row">
                        <dt class="col-sm-4">Status:</dt>
                        <dd class="col-sm-8">
                            @switch (Model.Status)
                                {
                                case ProductStatus.Draft:
                                <span class="badge bg-info">Draft</span>
                                break;
                                case ProductStatus.Published:
                                <span class="badge bg-success">Published</span>
                                break;
                                case ProductStatus.Archived:
                                <span class="badge bg-secondary">Archived</span>
                                break;
                                }
                        </dd>

                        <dt class="col-sm-4">Created:</dt>
                        <dd class="col-sm-8">
                            @if (Model.CreatedDate.HasValue)
                            {
                                @Model.CreatedDate.Value.ToLocalTime().ToString("MMM dd, yyyy 'at' h:mm tt")
                            }
                            else
                            {
                                <span class="text-muted">—</span>
                            }
                        </dd>

                        @if (Model.Attributes.Any())
                            {
                            <dt class="col-sm-4">Attributes:</dt>
                            <dd class="col-sm-8">
                                <span class="badge bg-secondary text-white">@Model.Attributes.Count attribute(s)</span>
                            </dd>
                            }
                    </dl>
                </div>
            </div>

            @if (Model.Attributes.Any())
                {
                <div class="mt-3">
                    <h6>Attributes:</h6>
                    <p class="mb-0">
                        @foreach (var attr in Model.Attributes)
                            {
                            <span class="badge bg-light text-dark me-1">@attr.AttributeName: @attr.AttributeValue</span>
                            }
                    </p>
                </div>
                }

        </div>
    </div>

    <!-- What Will Happen -->
    <div class="card mt-3">
        <div class="card-header bg-secondary text-white">
            <h6 class="mb-0">What will happen:</h6>
        </div>
        <div class="card-body">
            <ul class="mb-0">
                <li>Variant status will be set to <strong>Archived</strong></li>
                <li>Variant will be marked as <strong>Inactive</strong></li>
                <li>Variant will be <strong>hidden from dealers</strong></li>
                <li>All data and attributes will be <strong>preserved in the database</strong></li>
                <li>The variant can be <strong>restored later</strong> if needed</li>
            </ul>
        </div>
    </div>

    <!-- Action Buttons -->
    <form asp-action="Delete" method="post" class="mt-4">
        <input type="hidden" asp-for="VariantID" />

        <div class="d-flex justify-content-between">
            <a asp-action="Details" asp-route-id="@Model.VariantID" class="btn btn-outline-secondary">
                Cancel
            </a>
            <button type="submit" class="btn btn-dark">
                Yes, Archive This Variant
            </button>
        </div>
    </form>

</div>