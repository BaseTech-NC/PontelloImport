@model PontelloImport.Models.ProductVariant

@{
    Layout = "~/Views/Admin/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Delete Product Variant";
    }

<div class="container mt-4">

    <!-- Warning Header -->
    <div class="alert alert-danger border-danger" role="alert">
        <h4 class="alert-heading">
            <i class="bi bi-exclamation-triangle-fill"></i> Archive Product Variant?
        </h4>
        <p class="mb-0">
            This will archive the variant and hide it from dealers. The data will remain in the system and can be restored later.
        </p>
    </div>

    <!-- Product Details Card -->
    <div class="card">
        <div class="card-header bg-danger text-white">
            <h5 class="mb-0">Variant to Archive</h5>
        </div>
        <div class="card-body">

            <div class="row">
                <div class="col-md-6">
                    <dl class="row">
                        <dt class="col-sm-4">Title:</dt>
                        <dd class="col-sm-8"><strong>@Model.Title</strong></dd>

                        <dt class="col-sm-4">SKU:</dt>
                        <dd class="col-sm-8"><code class="text-primary">@Model.SKU</code></dd>

                        <dt class="col-sm-4">Price:</dt>
                        <dd class="col-sm-8"><strong class="text-success">@Model.Price.ToString("C")</strong></dd>

                        <dt class="col-sm-4">Inventory:</dt>
                        <dd class="col-sm-8">@Model.InventoryQuantity units</dd>

                        @if (Model.ProductID != null)
                            {
                            <dt class="col-sm-4">Parent Product:</dt>
                            <dd class="col-sm-8">@Model.Product?.Title</dd>
                            }
                        else
                            {
                            <dt class="col-sm-4">Type:</dt>
                            <dd class="col-sm-8"><span class="badge bg-info">Standalone Product</span></dd>
                            }
                    </dl>
                </div>

                <div class="col-md-6">
                    <dl class="row">
                        <dt class="col-sm-4">Status:</dt>
                        <dd class="col-sm-8">
                            @switch (Model.Status)
                                {
                                case ProductStatus.Draft:
                                <span class="badge bg-warning text-dark">Draft</span>
                                break;
                                case ProductStatus.Published:
                                <span class="badge bg-success">Published</span>
                                break;
                                case ProductStatus.Archived:
                                <span class="badge bg-secondary">Archived</span>
                                break;
                                }
                        </dd>

                        <dt class="col-sm-4">Active:</dt>
                        <dd class="col-sm-8">
                            @if (Model.IsActive)
                                {
                                <span class="badge bg-success">Yes</span>
                                }
                            else
                                {
                                <span class="badge bg-danger">No</span>
                                }
                        </dd>

                        <dt class="col-sm-4">Created:</dt>
                        <dd class="col-sm-8">@Model.CreatedDate</dd>

                        @if (Model.Attributes.Any())
                            {
                            <dt class="col-sm-4">Attributes:</dt>
                            <dd class="col-sm-8">
                                <span class="badge bg-warning text-dark">@Model.Attributes.Count attribute(s)</span>
                            </dd>
                            }
                    </dl>
                </div>
            </div>

            @if (Model.Attributes.Any(a => a.IsVariantAttribute))
                {
                <div class="mt-3">
                    <h6>Variant Attributes:</h6>
                    <p class="mb-0">
                        @foreach (var attr in Model.Attributes.Where(a => a.IsVariantAttribute))
                            {
                            <span class="badge bg-light text-dark me-1">@attr.AttributeName: @attr.AttributeValue</span>
                            }
                    </p>
                </div>
                }

        </div>
    </div>

    <!-- What Will Happen -->
    <div class="card mt-3">
        <div class="card-header bg-warning text-dark">
            <h6 class="mb-0">What will happen:</h6>
        </div>
        <div class="card-body">
            <ul class="mb-0">
                <li>Variant status will be set to <strong>Archived</strong></li>
                <li>Variant will be marked as <strong>Inactive</strong></li>
                <li>Variant will be <strong>hidden from dealers</strong></li>
                <li>All data and attributes will be <strong>preserved in the database</strong></li>
                <li>The variant can be <strong>restored later</strong> if needed</li>
            </ul>
        </div>
    </div>

    <!-- Action Buttons -->
    <form asp-action="Delete" method="post" class="mt-4">
        <input type="hidden" asp-for="VariantID" />

        <div class="d-flex justify-content-between">
            <a asp-action="Index" class="btn btn-secondary btn-lg">
                Cancel
            </a>
            <button type="submit" class="btn btn-danger btn-lg">
                Yes, Archive This Variant
            </button>
        </div>
    </form>

</div>