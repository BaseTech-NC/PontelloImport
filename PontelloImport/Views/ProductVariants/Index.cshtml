@model PontelloImport.Models.PaginatedList<PontelloImport.Models.ProductVariant>
@using Microsoft.AspNetCore.Mvc.Rendering

@{
    Layout = "~/Views/Admin/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Product Catalogue";
    var currentFilter = ViewBag.CurrentFilter as string ?? "all";
    var currentPageSize = ViewBag.CurrentPageSize ?? 10;
    var currentSearch = ViewBag.CurrentSearch as string ?? "";
    var currentCategoryId = ViewBag.CurrentCategoryId as int?;
    var currentVendorId = ViewBag.CurrentVendorId as int?;
    var currentProductType = ViewBag.CurrentProductType as string ?? "";
    var currentStockStatus = ViewBag.CurrentStockStatus as string ?? "";
    var currentSortBy  = ViewData["SortBy"]  as string ?? "created";
    var currentSortDir = ViewData["SortDir"] as string ?? "desc";
    var nextSortDir    = ViewData["NextDir"] as string ?? "asc";
    // Helper: direction for a sort link (toggles if active column, else defaults to asc)
    string SD(string col) => currentSortBy == col ? nextSortDir : "asc";
    // Helper: indicator icon for a column header
    string SI(string col) => currentSortBy == col ? (currentSortDir == "asc" ? "▲" : "▼") : "⇅";
    var hasActiveFilters = !string.IsNullOrEmpty(currentSearch) ||
                          currentCategoryId.HasValue ||
                          currentVendorId.HasValue ||
                          !string.IsNullOrEmpty(currentProductType) ||
                          !string.IsNullOrEmpty(currentStockStatus);
}

<style>
    *, *::before, *::after { font-family: Inter, system-ui, sans-serif; }

    /* Filter inputs */
    .cat-input {
        border: 1px solid #E5E7EB;
        border-radius: 8px;
        font-size: 0.875rem;
        color: #111827;
        background: #ffffff;
        padding: 0.42rem 0.75rem;
        transition: border-color 150ms;
        height: 36px;
    }
    .cat-input:focus {
        border-color: #2563EB;
        box-shadow: 0 0 0 3px rgba(37,99,235,0.1);
    }

    /* Buttons */
    .btn-search-sm {
        background: #111827;
        color: #fff;
        border: none;
        border-radius: 8px;
        font-size: 0.875rem;
        font-weight: 500;
        padding: 0.42rem 1rem;
        height: 36px;
        transition: background 150ms;
        white-space: nowrap;
    }
    .btn-search-sm:hover { background: #1F2937; color: #fff; }

    .btn-clear-sm {
        color: #4B5563;
        border: 1px solid #E5E7EB;
        background: transparent;
        border-radius: 8px;
        font-size: 0.875rem;
        font-weight: 500;
        padding: 0.42rem 0.85rem;
        height: 36px;
        text-decoration: none;
        transition: background 150ms;
        white-space: nowrap;
        display: inline-flex;
        align-items: center;
    }
    .btn-clear-sm:hover { background: #F3F4F6; color: #374151; }

    .btn-create {
        background: #111827;
        color: #fff;
        border: none;
        border-radius: 8px;
        font-size: 0.875rem;
        font-weight: 500;
        padding: 0.5rem 1.1rem;
        text-decoration: none;
        transition: background 150ms;
        display: inline-block;
    }
    .btn-create:hover { background: #1F2937; color: #fff; }

    /* Status tabs */
    .cat-tabs {
        display: flex;
        gap: 2px;
        border-bottom: 1px solid #E5E7EB;
        margin-bottom: 1.25rem;
        flex-wrap: wrap;
    }
    .cat-tab {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 0.5rem 0.85rem;
        font-size: 0.85rem;
        font-weight: 500;
        color: #4B5563;
        text-decoration: none;
        border-bottom: 2px solid transparent;
        margin-bottom: -1px;
        border-radius: 4px 4px 0 0;
        transition: color 150ms, background 150ms;
    }
    .cat-tab:hover { color: #111827; background: #F3F4F6; }
    .cat-tab.active { color: #2563EB; border-bottom-color: #2563EB; background: transparent; }
    .cat-tab .tab-count {
        font-size: 0.72rem;
        font-weight: 600;
        padding: 1px 6px;
        border-radius: 999px;
        background: #F3F4F6;
        color: #4B5563;
    }
    .cat-tab.active .tab-count { background: #EFF6FF; color: #2563EB; }

    /* Table card */
    .cat-table-card {
        background: #ffffff;
        border: 1px solid #E5E7EB;
        border-radius: 12px;
        overflow: hidden;
    }
    .cat-table-card table { margin-bottom: 0; }
    .cat-table-card thead th {
        font-size: 0.72rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.06em;
        color: #4B5563;
        background: #F8FAFC;
        border-bottom: 1px solid #E5E7EB;
        padding: 0.75rem 1rem;
    }
    .cat-table-card tbody td {
        padding: 0.8rem 1rem;
        border-bottom: 1px solid #F3F4F6;
        color: #111827;
        font-size: 0.875rem;
        vertical-align: middle;
    }
    .cat-table-card tbody tr:last-child td { border-bottom: none; }
    .cat-table-card tbody tr:hover td { background: #F8FAFC; }

    /* Soft pill badges */
    .pill {
        display: inline-flex;
        align-items: center;
        padding: 3px 9px;
        border-radius: 999px;
        font-size: 0.72rem;
        font-weight: 600;
        letter-spacing: 0.02em;
        white-space: nowrap;
    }
    /* Status */
    .pill-published  { background: #F0FDF4; color: #15803D; }
    .pill-draft      { background: #FFF7ED; color: #9A3412; }
    .pill-unlisted   { background: #F3F4F6; color: #4B5563; }
    .pill-archived   { background: #FEF2F2; color: #B91C1C; }
    /* Inventory */
    .pill-instock    { background: #F0FDF4; color: #15803D; }
    .pill-lowstock   { background: #FFF7ED; color: #9A3412; }
    .pill-outofstock { background: #FEF2F2; color: #B91C1C; }

    /* Action buttons */
    .btn-act-details {
        color: #2563EB;
        border: 1px solid #BFDBFE;
        background: transparent;
        border-radius: 6px;
        font-size: 0.78rem;
        font-weight: 500;
        padding: 0.25rem 0.65rem;
        text-decoration: none;
        transition: background 150ms;
        white-space: nowrap;
    }
    .btn-act-details:hover { background: #EFF6FF; color: #1D4ED8; }

    .btn-act-edit {
        color: #4B5563;
        border: 1px solid #E5E7EB;
        background: transparent;
        border-radius: 6px;
        font-size: 0.78rem;
        font-weight: 500;
        padding: 0.25rem 0.65rem;
        text-decoration: none;
        transition: background 150ms;
        white-space: nowrap;
    }
    .btn-act-edit:hover { background: #F3F4F6; color: #374151; }

    .btn-act-ghost {
        color: #4B5563;
        border: 1px solid #E5E7EB;
        background: transparent;
        border-radius: 6px;
        font-size: 0.78rem;
        font-weight: 500;
        padding: 0.25rem 0.65rem;
        text-decoration: none;
        transition: background 150ms;
        white-space: nowrap;
    }
    .btn-act-ghost:hover { background: #F3F4F6; color: #4B5563; }

    /* Pagination */
    .pag { display: flex; gap: 4px; justify-content: center; flex-wrap: wrap; margin-top: 1.25rem; }
    .pag-link {
        display: inline-flex;
        align-items: center;
        padding: 0.35rem 0.75rem;
        font-size: 0.85rem;
        font-weight: 500;
        color: #4B5563;
        border: 1px solid #E5E7EB;
        border-radius: 6px;
        text-decoration: none;
        transition: background 150ms, color 150ms;
        background: #fff;
    }
    .pag-link:hover { background: #F3F4F6; color: #111827; }
    .pag-link.active { background: #2563EB; color: #fff; border-color: #2563EB; }
    .pag-link.disabled { color: #6B7280; pointer-events: none; }
</style>

<div class="container-fluid mt-4" style="max-width: 1200px;">

    <!-- Header -->
    <div class="d-flex justify-content-between align-items-start mb-4">
        <div>
            <h1 style="font-weight:600; color:#111827; font-size:1.4rem; margin-bottom:0.2rem;">Product Catalogue</h1>
            <p style="color:#4B5563; font-size:0.875rem; margin:0;">Browse, manage, and organise your entire product inventory.</p>
        </div>
        <div class="d-flex gap-2 align-items-center">
            <a asp-action="ExportCsv"
               asp-route-search="@currentSearch"
               asp-route-statusFilter="@currentFilter"
               class="btn btn-outline-secondary btn-sm">
                Export CSV
            </a>
            <a asp-action="Import" class="btn btn-outline-secondary btn-sm">Import CSV</a>
            <a asp-action="Create" class="btn-create">+ Create Product</a>
        </div>
    </div>

    <!-- Search & Filter Bar -->
    <form asp-action="Index" method="get" id="filterForm" class="mb-3">
        <input type="hidden" name="filter" value="@currentFilter" />
        <input type="hidden" name="pageNumber" value="1" />
        <input type="hidden" name="pageSize" value="@currentPageSize" />
        <input type="hidden" name="sortBy" value="@currentSortBy" />
        <input type="hidden" name="sortDir" value="@currentSortDir" />

        <div class="d-flex gap-2 flex-wrap align-items-center">
            <input type="text" name="search" class="cat-input form-control" style="max-width:220px;"
                   placeholder="Search title or SKU…" value="@currentSearch" aria-label="Search products" autocomplete="off" />
            <label for="catFilter" class="visually-hidden">Filter by category</label>
            <select name="categoryId" id="catFilter" class="cat-input form-select" style="max-width:160px;">
                <option value="">All Categories</option>
                @if (ViewBag.Categories != null)
                {
                    @foreach (SelectListItem item in ViewBag.Categories)
                    {
                        <option value="@item.Value" selected="@item.Selected">@item.Text</option>
                    }
                }
            </select>
            <label for="vendorFilter" class="visually-hidden">Filter by vendor</label>
            <select name="vendorId" id="vendorFilter" class="cat-input form-select" style="max-width:150px;">
                <option value="">All Vendors</option>
                @if (ViewBag.Vendors != null)
                {
                    @foreach (SelectListItem item in ViewBag.Vendors)
                    {
                        <option value="@item.Value" selected="@item.Selected">@item.Text</option>
                    }
                }
            </select>
            <label for="typeFilter" class="visually-hidden">Filter by product type</label>
            <select name="productType" id="typeFilter" class="cat-input form-select" style="max-width:150px;">
                <option value="">All Types</option>
                @if (ViewBag.ProductTypes != null)
                {
                    @foreach (SelectListItem item in ViewBag.ProductTypes)
                    {
                        <option value="@item.Value" selected="@item.Selected">@item.Text</option>
                    }
                }
            </select>
            <label for="stockFilter" class="visually-hidden">Filter by stock status</label>
            <select name="stockStatus" id="stockFilter" class="cat-input form-select" style="max-width:140px;">
                <option value="">All Stock</option>
                <option value="instock"    selected="@(currentStockStatus == "instock")">In Stock (&gt;5)</option>
                <option value="lowstock"   selected="@(currentStockStatus == "lowstock")">Low Stock (1–5)</option>
                <option value="outofstock" selected="@(currentStockStatus == "outofstock")">Out of Stock</option>
            </select>
            <button type="submit" class="btn-search-sm">Search</button>
            @if (hasActiveFilters)
            {
                <a asp-action="Index" asp-route-filter="@currentFilter" asp-route-pageSize="@currentPageSize"
                   asp-route-sortBy="@currentSortBy" asp-route-sortDir="@currentSortDir"
                   class="btn-clear-sm">Clear</a>
            }
        </div>
    </form>

    <!-- Status Filter Tabs -->
    <div class="cat-tabs">
        <a class="cat-tab @(currentFilter == "all" ? "active" : "")"
           asp-action="Index" asp-route-filter="all" asp-route-pageNumber="1"
           asp-route-pageSize="@currentPageSize" asp-route-search="@currentSearch"
           asp-route-categoryId="@currentCategoryId" asp-route-vendorId="@currentVendorId"
           asp-route-productType="@currentProductType" asp-route-stockStatus="@currentStockStatus"
           asp-route-sortBy="@currentSortBy" asp-route-sortDir="@currentSortDir">
            All <span class="tab-count">@ViewBag.AllCount</span>
        </a>
        <a class="cat-tab @(currentFilter == "published" ? "active" : "")"
           asp-action="Index" asp-route-filter="published" asp-route-pageNumber="1"
           asp-route-pageSize="@currentPageSize" asp-route-search="@currentSearch"
           asp-route-categoryId="@currentCategoryId" asp-route-vendorId="@currentVendorId"
           asp-route-productType="@currentProductType" asp-route-stockStatus="@currentStockStatus"
           asp-route-sortBy="@currentSortBy" asp-route-sortDir="@currentSortDir">
            Published <span class="tab-count">@ViewBag.PublishedCount</span>
        </a>
        <a class="cat-tab @(currentFilter == "draft" ? "active" : "")"
           asp-action="Index" asp-route-filter="draft" asp-route-pageNumber="1"
           asp-route-pageSize="@currentPageSize" asp-route-search="@currentSearch"
           asp-route-categoryId="@currentCategoryId" asp-route-vendorId="@currentVendorId"
           asp-route-productType="@currentProductType" asp-route-stockStatus="@currentStockStatus"
           asp-route-sortBy="@currentSortBy" asp-route-sortDir="@currentSortDir">
            Draft <span class="tab-count">@ViewBag.DraftCount</span>
        </a>
        <a class="cat-tab @(currentFilter == "archived" ? "active" : "")"
           asp-action="Index" asp-route-filter="archived" asp-route-pageNumber="1"
           asp-route-pageSize="@currentPageSize" asp-route-search="@currentSearch"
           asp-route-categoryId="@currentCategoryId" asp-route-vendorId="@currentVendorId"
           asp-route-productType="@currentProductType" asp-route-stockStatus="@currentStockStatus"
           asp-route-sortBy="@currentSortBy" asp-route-sortDir="@currentSortDir">
            Archived <span class="tab-count">@ViewBag.ArchivedCount</span>
        </a>
    </div>

    @if (!Model.Any())
    {
        <div style="text-align:center; padding:3rem; color:#4B5563;">
            <div style="font-size:1.75rem; margin-bottom:0.6rem;">📦</div>
            <p style="margin:0 0 0.5rem; font-size:0.9rem;">
                @if (hasActiveFilters) { <text>No products match your search criteria.</text> }
                else { <text>No variants found.</text> }
            </p>
            @if (hasActiveFilters)
            {
                <a asp-action="Index" asp-route-filter="@currentFilter" asp-route-pageSize="@currentPageSize"
                   asp-route-sortBy="@currentSortBy" asp-route-sortDir="@currentSortDir"
                   style="color:#2563EB; font-size:0.875rem;">Clear all filters</a>
            }
            else
            {
                <a asp-action="Create" style="color:#2563EB; font-size:0.875rem;">Create your first product</a>
            }
        </div>
    }
    else
    {
        <!-- Results summary + page size -->
        <div class="d-flex justify-content-between align-items-center mb-2">
            <p style="color:#4B5563; font-size:0.8rem; margin:0;">
                Showing @((Model.PageIndex - 1) * currentPageSize + 1)–@(Math.Min(Model.PageIndex * currentPageSize, Model.TotalCount)) of @Model.TotalCount results
            </p>
            <form asp-action="Index" method="get" class="d-inline-flex align-items-center gap-2">
                <input type="hidden" name="filter" value="@currentFilter" />
                <input type="hidden" name="pageNumber" value="1" />
                <input type="hidden" name="search" value="@currentSearch" />
                <input type="hidden" name="categoryId" value="@currentCategoryId" />
                <input type="hidden" name="vendorId" value="@currentVendorId" />
                <input type="hidden" name="productType" value="@currentProductType" />
                <input type="hidden" name="stockStatus" value="@currentStockStatus" />
                <input type="hidden" name="sortBy" value="@currentSortBy" />
                <input type="hidden" name="sortDir" value="@currentSortDir" />
                <label for="pageSizeSel" style="font-size:0.8rem; color:#4B5563; margin:0;">Show</label>
                <select name="pageSize" id="pageSizeSel" class="cat-input form-select" style="width:72px; height:32px; padding:0.2rem 0.5rem; font-size:0.8rem;" onchange="this.form.submit()">
                    <option value="10"  selected="@(currentPageSize == 10)">10</option>
                    <option value="25"  selected="@(currentPageSize == 25)">25</option>
                    <option value="50"  selected="@(currentPageSize == 50)">50</option>
                    <option value="100" selected="@(currentPageSize == 100)">100</option>
                </select>
            </form>
        </div>

        <!-- Table -->
        <div class="cat-table-card">
            <div class="table-responsive">
                <table class="table mb-0">
                    <thead>
                        <tr>
                            <th>
                                <a asp-action="Index" asp-route-sortBy="title" asp-route-sortDir="@SD("title")"
                                   asp-route-filter="@currentFilter" asp-route-pageNumber="1" asp-route-pageSize="@currentPageSize"
                                   asp-route-search="@currentSearch" asp-route-categoryId="@currentCategoryId"
                                   asp-route-vendorId="@currentVendorId" asp-route-productType="@currentProductType"
                                   asp-route-stockStatus="@currentStockStatus"
                                   class="text-decoration-none" style="color:inherit;">
                                    Product <span class="@(currentSortBy=="title"?"":"text-muted")">@SI("title")</span>
                                </a>
                            </th>
                            <th>SKU</th>
                            <th>
                                <a asp-action="Index" asp-route-sortBy="price" asp-route-sortDir="@SD("price")"
                                   asp-route-filter="@currentFilter" asp-route-pageNumber="1" asp-route-pageSize="@currentPageSize"
                                   asp-route-search="@currentSearch" asp-route-categoryId="@currentCategoryId"
                                   asp-route-vendorId="@currentVendorId" asp-route-productType="@currentProductType"
                                   asp-route-stockStatus="@currentStockStatus"
                                   class="text-decoration-none" style="color:inherit;">
                                    Price <span class="@(currentSortBy=="price"?"":"text-muted")">@SI("price")</span>
                                </a>
                            </th>
                            <th>
                                <a asp-action="Index" asp-route-sortBy="stock" asp-route-sortDir="@SD("stock")"
                                   asp-route-filter="@currentFilter" asp-route-pageNumber="1" asp-route-pageSize="@currentPageSize"
                                   asp-route-search="@currentSearch" asp-route-categoryId="@currentCategoryId"
                                   asp-route-vendorId="@currentVendorId" asp-route-productType="@currentProductType"
                                   asp-route-stockStatus="@currentStockStatus"
                                   class="text-decoration-none" style="color:inherit;">
                                    Inventory <span class="@(currentSortBy=="stock"?"":"text-muted")">@SI("stock")</span>
                                </a>
                            </th>
                            <th>
                                <a asp-action="Index" asp-route-sortBy="status" asp-route-sortDir="@SD("status")"
                                   asp-route-filter="@currentFilter" asp-route-pageNumber="1" asp-route-pageSize="@currentPageSize"
                                   asp-route-search="@currentSearch" asp-route-categoryId="@currentCategoryId"
                                   asp-route-vendorId="@currentVendorId" asp-route-productType="@currentProductType"
                                   asp-route-stockStatus="@currentStockStatus"
                                   class="text-decoration-none" style="color:inherit;">
                                    Status <span class="@(currentSortBy=="status"?"":"text-muted")">@SI("status")</span>
                                </a>
                            </th>
                            <th>Vendor</th>
                            <th>Category</th>
                            <th aria-label="Actions"></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var variant in Model)
                        {
                            <tr>
                                <td>
                                    <a asp-action="Details" asp-route-id="@variant.Product!.ProductID"
                                       style="color:#111827; font-weight:500; text-decoration:none;">
                                        @(variant.Product?.Title ?? variant.SKU)
                                    </a>
                                    @{
                                        var opts = new[]
                                        {
                                            variant.Option1Name != null && variant.Option1Name != "Title" ? $"{variant.Option1Name}: {variant.Option1Value}" : null,
                                            variant.Option2Name != null ? $"{variant.Option2Name}: {variant.Option2Value}" : null,
                                        }.Where(s => s != null).ToList();
                                    }
                                    @if (opts.Any())
                                    {
                                        <br /><small style="color:#4B5563;">@string.Join(" · ", opts)</small>
                                    }
                                </td>
                                <td><code style="font-size:0.8rem; color:#374151; background:#F3F4F6; padding:2px 6px; border-radius:4px;">@variant.SKU</code></td>
                                <td style="font-weight:600;">@variant.Price.ToString("C")</td>
                                <td>
                                    @if (variant.InventoryQuantity > 5)
                                    {
                                        <span class="pill pill-instock">@variant.InventoryQuantity in stock</span>
                                    }
                                    else if (variant.InventoryQuantity >= 1)
                                    {
                                        <span class="pill pill-lowstock">@variant.InventoryQuantity left</span>
                                    }
                                    else
                                    {
                                        <span class="pill pill-outofstock">Out of stock</span>
                                    }
                                </td>
                                <td>
                                    @switch (variant.Status)
                                    {
                                        case ProductStatus.Published:
                                            <span class="pill pill-published">Published</span>
                                            break;
                                        case ProductStatus.Draft:
                                            <span class="pill pill-draft">Draft</span>
                                            break;
                                        case ProductStatus.Unlisted:
                                            <span class="pill pill-unlisted">Unlisted</span>
                                            break;
                                        case ProductStatus.Archived:
                                            <span class="pill pill-archived">Archived</span>
                                            break;
                                    }
                                </td>
                                <td style="color:#4B5563;">@(variant.Product?.Vendor?.VendorName ?? "—")</td>
                                <td style="color:#4B5563;">@(variant.Product?.ProductCategory?.CategoryName ?? "—")</td>
                                <td style="white-space:nowrap;">
                                    <div class="d-flex gap-1">
                                        <a asp-action="Details" asp-route-id="@variant.Product!.ProductID" class="btn-act-details">Details</a>
                                        <a asp-action="Edit" asp-route-id="@variant.Product!.ProductID" class="btn-act-edit">Edit</a>
                                        @if (variant.Status == ProductStatus.Archived)
                                        {
                                            <form asp-action="Restore" asp-route-id="@variant.VariantID" method="post" style="display:inline;">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn-act-ghost">Restore</button>
                                            </form>
                                        }
                                        else
                                        {
                                            <a asp-action="Delete" asp-route-id="@variant.VariantID" class="btn-act-ghost">Archive</a>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Pagination -->
        @if (Model.TotalPages > 1)
        {
            var startPage = Math.Max(1, Model.PageIndex - 2);
            var endPage = Math.Min(Model.TotalPages, Model.PageIndex + 2);
            <div class="pag">
                <a class="pag-link @(!Model.HasPreviousPage ? "disabled" : "")"
                   asp-action="Index" asp-route-pageNumber="@(Model.PageIndex - 1)"
                   asp-route-filter="@currentFilter" asp-route-pageSize="@currentPageSize"
                   asp-route-search="@currentSearch" asp-route-categoryId="@currentCategoryId"
                   asp-route-vendorId="@currentVendorId" asp-route-productType="@currentProductType"
                   asp-route-stockStatus="@currentStockStatus"
                   asp-route-sortBy="@currentSortBy" asp-route-sortDir="@currentSortDir">← Prev</a>

                @if (startPage > 1)
                {
                    <a class="pag-link" asp-action="Index" asp-route-pageNumber="1"
                       asp-route-filter="@currentFilter" asp-route-pageSize="@currentPageSize"
                       asp-route-search="@currentSearch" asp-route-categoryId="@currentCategoryId"
                       asp-route-vendorId="@currentVendorId" asp-route-productType="@currentProductType"
                       asp-route-stockStatus="@currentStockStatus"
                       asp-route-sortBy="@currentSortBy" asp-route-sortDir="@currentSortDir">1</a>
                    @if (startPage > 2) { <span class="pag-link disabled">…</span> }
                }

                @for (int i = startPage; i <= endPage; i++)
                {
                    <a class="pag-link @(i == Model.PageIndex ? "active" : "")"
                       asp-action="Index" asp-route-pageNumber="@i"
                       asp-route-filter="@currentFilter" asp-route-pageSize="@currentPageSize"
                       asp-route-search="@currentSearch" asp-route-categoryId="@currentCategoryId"
                       asp-route-vendorId="@currentVendorId" asp-route-productType="@currentProductType"
                       asp-route-stockStatus="@currentStockStatus"
                       asp-route-sortBy="@currentSortBy" asp-route-sortDir="@currentSortDir">@i</a>
                }

                @if (endPage < Model.TotalPages)
                {
                    @if (endPage < Model.TotalPages - 1) { <span class="pag-link disabled">…</span> }
                    <a class="pag-link" asp-action="Index" asp-route-pageNumber="@Model.TotalPages"
                       asp-route-filter="@currentFilter" asp-route-pageSize="@currentPageSize"
                       asp-route-search="@currentSearch" asp-route-categoryId="@currentCategoryId"
                       asp-route-vendorId="@currentVendorId" asp-route-productType="@currentProductType"
                       asp-route-stockStatus="@currentStockStatus"
                       asp-route-sortBy="@currentSortBy" asp-route-sortDir="@currentSortDir">@Model.TotalPages</a>
                }

                <a class="pag-link @(!Model.HasNextPage ? "disabled" : "")"
                   asp-action="Index" asp-route-pageNumber="@(Model.PageIndex + 1)"
                   asp-route-filter="@currentFilter" asp-route-pageSize="@currentPageSize"
                   asp-route-search="@currentSearch" asp-route-categoryId="@currentCategoryId"
                   asp-route-vendorId="@currentVendorId" asp-route-productType="@currentProductType"
                   asp-route-stockStatus="@currentStockStatus"
                   asp-route-sortBy="@currentSortBy" asp-route-sortDir="@currentSortDir">Next →</a>
            </div>
            <p style="text-align:center; color:#4B5563; font-size:0.78rem; margin-top:0.5rem;">
                Page @Model.PageIndex of @Model.TotalPages
            </p>
        }
    }

</div>

@section Scripts { }
