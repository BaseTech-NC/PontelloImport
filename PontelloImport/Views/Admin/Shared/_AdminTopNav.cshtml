    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@{
}
<nav class="w-100 d-flex align-items-center justify-content-between px-3">

     @* Left *@
    <div class="d-lg-none">
        @* <img src="/images/pontello-Imports-Logo.png" alt="Pontello Imports" class="img-fluid" width="55" height="45" /> *@
        @* <a href="@Url.Action("Index", "Home")"><img src="~/images/pontello-Imports-Logo.png" alt="Pontello Imports Logo" /></a> *@
        <a href="@Url.Action("Index", "Home")">
            <img src="~/images/pontello-Imports-Logo.png"
                 alt="Pontello Imports Logo"
                 class="img-fluid"
                 width="55"
                 height="45" />
        </a>
    </div>

    @* Right  *@
    <div class="d-flex align-items-center gap-3 ms-auto">
        <div class="dropdown">
            <button class="btn btn-link p-1 position-relative"
                    type="button"
                    data-bs-toggle="dropdown"
                    aria-expanded="false"
                    aria-label="Notifications">
                <svg xmlns="http://www.w3.org/2000/svg"
                     width="18" height="18" fill="currentColor"
                     viewBox="0 0 16 16">
                    <path d="M8 16a2 2 0 0 0 2-2H6a2 2 0 0 0 2 2z"/>
                    <path d="M8 1.918l-.797.161A4 4 0 0 0 4 6c0 .628-.134 2.197-.459 3.742-.16.767-.376 1.566-.663 2.258h10.244c-.287-.692-.502-1.49-.663-2.258C12.134 8.197 12 6.628 12 6a4 4 0 0 0-3.203-3.92L8 1.917zM14.22 12c.223.447.481.801.78 1H1c.299-.199.557-.553.78-1C2.68 10.2 3 6.88 3 6c0-2.42 1.72-4.44 4.005-4.901a1 1 0 1 1 1.99 0A5 5 0 0 1 13 6c0 .88.32 4.2 1.22 6z"/>
                </svg>
                @if ((int)(ViewData["TotalPendingCount"] ?? 0) > 0)
                {
                    <span class="position-absolute top-0 start-100 translate-middle p-1 rounded-circle"
                          style="background-color: #028090; width: 8px; height: 8px;
                                 transform: translate(-60%, 10%) !important;">
                    </span>
                }
            </button>

            <ul class="dropdown-menu dropdown-menu-end shadow"
                style="min-width: 280px; font-size: 0.875rem;">

                <li class="px-3 py-2 border-bottom">
                    <span class="fw-semibold text-dark">Notifications</span>
                </li>

                @{
                    var s = (int)(ViewData["SubmittedOrderCount"] ?? 0);
                    var a = (int)(ViewData["ActionRequiredCount"] ?? 0);
                }

                @if (s == 0 && a == 0)
                {
                    <li class="px-3 py-3 text-center text-muted">
                        <small>No pending items</small>
                    </li>
                }

                @if (s > 0)
                {
                    <li>
                        <a class="dropdown-item py-2"
                           asp-controller="AdminOrders"
                           asp-action="Index"
                           asp-route-status="Submitted">
                            <div class="d-flex align-items-center gap-2">
                                <span class="rounded-circle d-flex align-items-center justify-content-center flex-shrink-0"
                                      style="width:28px; height:28px; background: #E0F5F5; color: #028090; font-size: 11px; font-weight: 700;">
                                    @s
                                </span>
                                <div>
                                    <div class="fw-medium text-dark" style="font-size:0.82rem;">New Order@(s == 1 ? "" : "s") Submitted</div>
                                    <div class="text-muted" style="font-size:0.75rem;">Awaiting your review</div>
                                </div>
                            </div>
                        </a>
                    </li>
                }

                @if (a > 0)
                {
                    <li>
                        <a class="dropdown-item py-2"
                           asp-controller="AdminOrders"
                           asp-action="Index"
                           asp-route-status="ActionRequired">
                            <div class="d-flex align-items-center gap-2">
                                <span class="rounded-circle d-flex align-items-center justify-content-center flex-shrink-0"
                                      style="width:28px; height:28px; background: #FFF7ED; color: #EA580C; font-size: 11px; font-weight: 700;">
                                    @a
                                </span>
                                <div>
                                    <div class="fw-medium text-dark" style="font-size:0.82rem;">Order@(a == 1 ? "" : "s") Requiring Action</div>
                                    <div class="text-muted" style="font-size:0.75rem;">Needs resolution</div>
                                </div>
                            </div>
                        </a>
                    </li>
                }

                <li class="border-top">
                    <a class="dropdown-item py-2 text-center"
                       style="font-size:0.8rem; color:#028090;"
                       asp-controller="AdminOrders"
                       asp-action="Index">
                        View all orders →
                    </a>
                </li>

            </ul>
        </div>

        <div class="dropdown">
            <a data-bs-toggle="dropdown">
                <img src="https://img.freepik.com/premium-vector/man-avatar-profile-picture-isolated-background-avatar-profile-picture-man_1293239-4855.jpg" class="rounded-circle img-fluid" width="40" height="40" alt="User menu" />
            </a>
            <ul class="dropdown-menu dropdown-menu-end">
                <li>
                    <form asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="/" method="post" class="d-inline">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="dropdown-item">Sign Out</button>
                    </form>
                </li>
            </ul>
        </div>
    </div>

</nav>
