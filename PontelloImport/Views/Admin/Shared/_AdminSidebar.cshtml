@*
    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@{
    string controller = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    var pending         = (int)(ViewData["TotalPendingCount"]    ?? 0);
    var submitted       = (int)(ViewData["SubmittedOrderCount"]  ?? 0);
    var actionRequired  = (int)(ViewData["ActionRequiredCount"]  ?? 0);
}
<div class="h-100 ">
    <div class="sidebar-logo p-3">
        @* <img src="/images/pontello-Imports-Logo.png" alt="Pontello Imports" class="object-fit-contain h-100" /> *@
        <a href="@Url.Action("Index", "Home")">
            <img src="~/images/pontello-Imports-Logo.png"
                 alt="Pontello Imports Logo"
                 class="object-fit-contain h-100" />
        </a>
    </div>

    <nav aria-label="Admin navigation" class="d-flex flex-column p-3">

        <ul class="nav nav-pills flex-column gap-1">

            @* <li class="nav-item"> *@
            @*     <a class="nav-link @(controller == "Dashboard" ? "active" : "text-dark")" *@
            @*        asp-area="" *@
            @*        asp-controller="Dashboard" *@
            @*        asp-action="Index"> *@
            @*         <i class="bi bi-speedometer2 me-2"></i> Dashboard *@
            @*     </a> *@
            @* </li> *@

            <li class="nav-item">
                <a class="nav-link @(controller == "ProductVariants" ? "active" : "text-dark")"
                   asp-area=""
                   asp-controller="ProductVariants"
                   asp-action="Index">
                    <i class="bi bi-box me-2"></i> Products
                </a>
            </li>

            <li class="nav-item">
                <a class="nav-link @(controller == "AdminDealers" ? "active" : "text-dark")"
                   asp-area=""
                   asp-controller="AdminDealers"
                   asp-action="Dealers">
                    <i class="bi bi-people me-2"></i> Dealers
                </a>
            </li>

            <li class="nav-item">
                <a class="nav-link @(controller == "AdminOrders" ? "active" : "text-dark") d-flex align-items-center gap-2"
                   asp-area=""
                   asp-controller="AdminOrders"
                   asp-action="Index">
                    <i class="bi bi-receipt me-2"></i> Orders
                    @if (pending > 0)
                    {
                        <span class="badge rounded-pill bg-danger ms-auto"
                              title="@submitted Submitted, @actionRequired Action Required">
                            @pending
                        </span>
                    }
                </a>
            </li>

        </ul>

    </nav>
</div>