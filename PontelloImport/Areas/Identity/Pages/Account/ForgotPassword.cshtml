@page
@model ForgotPasswordModel
@{
    ViewData["Title"] = "Reset Password — Pontello Imports";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="row justify-content-center" style="margin-top:3rem;">
    <div class="col-sm-8 col-md-5 col-lg-4">

        <div class="text-center mb-4">
            <img src="~/images/pontello-Imports-Logo.png" alt="Pontello Imports"
                 style="height:52px;" class="mb-3" />
            <h1 style="font-size:1.35rem;font-weight:600;color:#111827;">
                Forgot your password?
            </h1>
            <p class="text-muted" style="font-size:0.9rem;">
                Enter your email and we'll send you a reset link.
            </p>
        </div>

        <div class="card shadow-sm" style="border:1px solid #E5E7EB;border-radius:12px;">
            <div class="card-body p-4">
                <form method="post">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-3" role="alert"></div>
                    @Html.AntiForgeryToken()

                    <div class="mb-3">
                        <label asp-for="Input.Email" class="form-label fw-semibold"
                               style="font-size:0.875rem;">Email address</label>
                        <input asp-for="Input.Email" class="form-control"
                               autocomplete="username" placeholder="you@example.com"
                               style="border-radius:8px;" />
                        <span asp-validation-for="Input.Email" class="text-danger small"></span>
                    </div>

                    <button type="submit" class="btn w-100 fw-semibold"
                            style="background:#028090;color:#ffffff;border-radius:8px;padding:0.65rem;">
                        Send Reset Link
                    </button>
                </form>
            </div>
        </div>

        <div class="text-center mt-3" style="font-size:0.875rem;color:#6B7280;">
            <a asp-page="./Login" style="color:#028090;">Back to Sign In</a>
        </div>

    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
